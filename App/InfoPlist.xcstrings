{
  "sourceLanguage": "en",
  "strings": {
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Why the game asks to add to the photo library: the share sheet's Save Video for a Lens clip.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ المقاطع التي تنشئها في مكتبة الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert die Clips, die du erstellst, in deiner Fotomediathek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the clips you make to your photo library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda en tu fototeca los clips que crees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre dans ta photothèque les clips que tu crées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva nella tua libreria foto i clip che crei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成したクリップを写真ライブラリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만든 클립을 사진 보관함에 저장해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda na tua fototeca os clips que crias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva na sua fototeca os clipes que você cria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет созданные тобой клипы в медиатеку «Фото»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你制作的短片存入照片图库。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
