    },
    "Strike high and left: follow with left side.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضرب أعلى ويساراً: دفع مع لف يساري."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben links treffen: Nachlauf mit Linkseffet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpea arriba a la izquierda: avance con efecto a la izquierda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frappe en haut à gauche : avant avec effet à gauche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colpisci in alto a sinistra: avanti con effetto a sinistra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上を撞く：左ひねりのフォロー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 위를 치세요: 왼쪽 회전을 섞은 밀어치기."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bate em cima à esquerda: avanço com efeito à esquerda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
