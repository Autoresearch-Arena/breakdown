          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpea la roja a la que apunta el taco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue la rouge sur laquelle ta queue est posée."
          }
        },
