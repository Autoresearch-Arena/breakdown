    "Friction with the cloth slowed %@ and spun it up until the bottom of the ball stopped slipping. It now rolls at %@ m/s.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبطأها احتكاك اللباد بمقدار %@ وأدارتها حتى توقف أسفل الكرة عن الانزلاق. وهي الآن تتدحرج بسرعة %@ m/s."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reibung mit dem Tuch bremste %@ und drehte die Kugel an, bis ihre Unterseite nicht mehr rutschte. Sie rollt jetzt mit %@ m/s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fricción con el paño frenó a %@ y la hizo girar hasta que la parte inferior de la bola dejó de deslizarse. Ahora rueda a %@ m/s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La friction avec le tapis a ralenti %@ et l'a fait tourner jusqu'à ce que le bas de la bille cesse de glisser. Elle roule maintenant à %@ m/s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attrito con il panno ha rallentato %@ e messo in rotazione la palla finché la parte inferiore non ha più strisciato. Ora rotola a %@ m/s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラシャとの摩擦で%@の速さが落ち、球の下側が滑らなくなるまで回転が上がりました。今は%@ m/sで転がっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테이블 천과 마찰하면서 %@ 속도가 줄고, 공 아래쪽이 미끄러지지 않을 때까지 회전이 붙었습니다. 이제 %@ m/s로 구릅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O atrito com o feltro desacelerou %@ e fez a bola girar até a parte de baixo parar de deslizar. Agora rola a %@ m/s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O atrito com o feltro desacelerou %@ e fez a bola girar até a parte de baixo parar de deslizar. Agora ela rola a %@ m/s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трение о сукно замедлило %@ и раскрутило его, пока низ шара не перестал проскальзывать. Теперь он катится со скоростью %@ m/s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "台布的摩擦力让%@减速，并让它转动起来，直到球底不再打滑。现在它以 %@ m/s 的速度滚动。"
          }
        }
      }
    },
