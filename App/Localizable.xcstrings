          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白いピンが倒れました。このターンの得点は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흰 핀이 쓰러졌습니다: 이번 차례의 점수를 잃습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pino branco caiu: perdem-se os pontos desta vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pino branco caiu: os pontos desta vez são perdidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Белая кегля упала: очки этого хода сгорают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白柱倒了：本轮得分作废。"
          }
        }
      }
    },
    "The white peg went down; the break had no points to lose.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سقط الوتد الأبيض؛ لم يكن في السلسلة نقاط لتُخسر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein weißer Pilz fiel; die Serie hatte keine Punkte zu verlieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cayó una seta blanca; la tacada no tenía puntos que perder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un champignon blanc est tombé ; la série n’avait aucun point à perdre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È caduto un funghetto bianco; la serie non aveva punti da perdere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白いペグが倒れましたが、このブレイクに失う得点はありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흰 말뚝이 쓰러졌지만, 이번 연속 득점에는 잃을 점수가 없었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Caiu um pino branco; a série não tinha pontos a perder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caiu um pino branco; a série não tinha pontos a perder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Белый грибок упал; в серии не было очков, которые можно потерять."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白色木桩倒了；本轮没有可失去的分数。"
          }
        }
      }
    },
    "The white touched no ball, so nothing scores.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تلمس البيضاء أي كرة، فلا تُحتسب نقاط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Weiße hat keine Kugel berührt, also zählt nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La blanca no tocó ninguna bola, así que no puntúa nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La blanche n’a touché aucune bille : rien ne compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bianca non ha toccato nessuna bilia, quindi niente punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白球がどの球にも当たらなかったので、得点はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흰 공이 아무 공도 맞히지 못해 점수가 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A branca não tocou em nenhuma bola, por isso nada conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A branca não tocou em nenhuma bola, então nada conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Белый не задел ни одного шара, поэтому очков нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白球没有碰到任何球，不得分。"
          }
        }
      }
    },
    "The whole length of the table, on backspin alone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طول الطاولة كاملاً، بالاعتماد على اللف الخلفي وحده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ganze Tischlänge, nur mit Rückdrall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la mesa, solo con retroceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute la longueur de la table, sur le rétro seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta la lunghezza del tavolo, solo con l'effetto indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "逆回転だけで、台の端から端まで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백스핀만으로 테이블 전체 길이를."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o comprimento da mesa, só com o efeito de recuo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comprimento todo da mesa, só com o efeito de recuo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через весь стол, только за счёт обратного вращения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整张球桌的距离，全靠低杆旋转。"
          }
        }
      }
    },
    "Then try it hard: past the calm zone on the power bar, the line wanders more.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثم جرّبها بقوة: بعد المنطقة الهادئة في شريط القوة، ينحرف الخط أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann versuch es fest: jenseits der ruhigen Zone auf dem Kraftbalken weicht die Linie stärker ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego pruébalo fuerte: más allá de la zona tranquila de la barra de potencia, la línea se desvía más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis essaie fort : au-delà de la zone calme de la barre de puissance, la ligne dévie davantage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi prova forte: oltre la zona tranquilla della barra di potenza, la linea devia di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次は強く打ってみよう。強さのバーの落ち着いた範囲を超えると、ラインがよりぶれる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그다음엔 세게 쳐 보세요. 세기 막대의 안정 구간을 넘으면 선이 더 흔들려요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois experimenta com força: para lá da zona calma da barra de força, a linha desvia-se mais."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois tente com força: além da zona calma da barra de força, a linha desvia mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потом попробуй сильно: за пределами спокойной зоны на шкале силы линия уходит сильнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再试试大力：力度条超出平稳区后，线路偏得更多。"
          }
        }
      }
    },
