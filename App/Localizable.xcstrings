    "Pick a ball, then a pocket, or call Safety": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كرة، ثم جيباً، أو أعلن دفاعاً"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Kugel, dann eine Tasche, oder sag Safety an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una bola y luego una tronera, o canta seguridad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une bille, puis une poche, ou annonce une sécurité"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una palla, poi una buca, oppure chiama difesa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "球を選んでからポケットを。またはセーフティを宣言"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공을 고르고 포켓을 고르거나, 세이프티를 선언하세요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe uma bola, depois uma caçapa, ou anuncia defesa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma bola, depois uma caçapa, ou anuncie defesa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери шар, потом лузу, или закажи отыгрыш"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选球，再选袋口，或者叫防守"
          }
        }
      }
    },
