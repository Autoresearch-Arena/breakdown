            "value": "Recuo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оттяжка"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低杆"
          }
        }
      }
    },
    "Draw the cue back further before you push through.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب العصا إلى الخلف أكثر قبل أن تدفع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol mit dem Queue weiter aus, bevor du durchstößt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva el taco más atrás antes de empujar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recule davantage la queue avant de pousser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta la stecca più indietro prima di spingere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押し出す前に、キューをもっと後ろに引こう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밀기 전에 큐를 더 뒤로 당기세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxa o taco mais para trás antes de empurrar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe o taco mais para trás antes de empurrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отведи кий дальше, прежде чем толкать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "往前推之前，先把球杆再往后拉一些。"
          }
        }
      }
    },
    "Draw-Massé Carom": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كاروم ماسيه بالسحب"
          }
        },
        "de": {
