          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击打中心上方打高杆。"
          }
        }
      }
    },
    "Strike below centre for draw.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضرب تحت المركز للسحب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der Mitte treffen für Rückzug."
          }
        },
        "es": {
          "stringUnit": {
