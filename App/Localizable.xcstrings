    "Right trigger swings harder, left trigger softer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزناد الأيمن يجعل الضربة أقوى، والأيسر أخف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechter Trigger: härter ausholen, linker: sanfter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gatillo derecho da un golpe más fuerte; el izquierdo, más suave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La gâchette droite frappe plus fort, la gauche plus doucement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il grilletto destro dà un colpo più forte, il sinistro più morbido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右トリガーで強く、左トリガーで弱く振ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 트리거는 더 세게, 왼쪽 트리거는 더 약하게 쳐요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O gatilho direito dá uma tacada mais forte, o esquerdo mais suave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gatilho direito dá uma tacada mais forte, o esquerdo mais suave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правый курок — замах сильнее, левый — мягче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右扳机挥杆更重，左扳机更轻。"
          }
        }
      }
    },
    "Rolled on. The topspin carried it through.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابعت التدحرج. حملها الدوران العلوي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitergerollt. Der Vorwärtseffet hat sie getragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguió rodando. El efecto alto la llevó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle a continué. L'effet haut l'a emportée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È andata avanti. L'effetto in avanti l'ha portata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転がり続けた。順回転が運んでくれた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 굴러갔어요. 윗회전이 밀어 줬어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguiu em frente. O efeito de cima levou-a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguiu em frente. O efeito de cima a levou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покатился дальше. Его пронесло верхнее вращение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续向前滚了。是上旋带着它走。"
          }
        }
      }
    },
