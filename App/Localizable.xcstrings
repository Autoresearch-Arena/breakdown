          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bate abaixo do centro para recuo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bata abaixo do centro para recuo."
          }
        },
        "ru": {
