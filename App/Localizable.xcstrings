    "Steep jump over the 8": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قفزة حادة فوق الكرة 8"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steiler Sprung über die 8"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto empinado sobre la 8"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saut raide par-dessus la 8"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto ripido sopra la 8"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8番越えの急角度ジャンプ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8번 위로 가파른 점프"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto inclinado sobre a 8"
          }
        },
        "pt-BR": {
