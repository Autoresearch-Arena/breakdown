    "Ride camera: the replay follows the balls at table height (Command-E)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كاميرا المرافقة: تتبع الإعادة الكرات على مستوى الطاولة (Command-E)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitfahr-Kamera: Die Wiederholung folgt den Kugeln in Tischhöhe (Befehl-E)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara de seguimiento: la repetición sigue las bolas a la altura de la mesa (Comando-E)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra embarquée : le replay suit les billes à hauteur de table (Commande-E)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
