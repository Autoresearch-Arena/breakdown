          }
        }
      }
    },
    "A hard hit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربة عنيفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein harter Stoß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un golpe fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coup fort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un colpo forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強いショット。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강한 타구."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tacada forte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tacada forte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильный удар."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大力一杆。"
          }
        }
      }
    },
    "A lazy stroke: the tip stays on the ball too long and it's a double hit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربة متكاسلة: يبقى رأس العصا على الكرة طويلاً فتصبح ضربة مزدوجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein lahmer Stoß: Die Spitze bleibt zu lange an der Kugel, und es ist ein Doppelstoß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un golpe perezoso: la punta se queda demasiado en la bola y es doble golpe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coup mou : le procédé reste trop longtemps sur la bille et c'est une double touche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un colpo pigro: il cuoio resta troppo sulla palla ed è doppio colpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "だらけたストローク：タップが球に長く残り、二度撞きになる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느슨한 스트로크: 팁이 공에 너무 오래 머물러 투터치가 돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tacada preguiçosa: a ponta fica tempo demais na bola e é toque duplo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tacada preguiçosa: a ponta fica tempo demais na bola e vira toque duplo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вялый удар: наклейка задерживается на шаре, и выходит двойное касание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出杆拖沓：杆头在球上停太久，造成连击。"
          }
        }
      }
    },
    "A little side on a two-rail kick holds the cue ball on the foot rail. A shot like this goes maybe one time in ten; shape on your next ball after it is what makes it great.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لف جانبي خفيف في ارتداد الحافتين يُبقي الكرة البيضاء على حافة القدم. ضربة كهذه تنجح ربما مرة من عشر؛ وما يجعلها رائعة هو تمركزك للكرة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein wenig Effet bei Vorbänder über zwei Banden hält die Weiße an der Fußbande. So ein Stoß geht vielleicht einmal von zehn; großartig wird er durch die Stellung auf deine nächste Kugel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco de efecto en un rebote a dos bandas mantiene la blanca pegada a la banda del pie. Un tiro así entra quizá una vez de cada diez; lo que lo hace grande es la posición para tu siguiente bola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu d'effet sur une bricole à deux bandes garde la blanche sur la bande du pied. Un coup pareil passe peut-être une fois sur dix ; ce qui le rend grand, c'est le placement pour ta bille suivante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un po' d'effetto in un rimbalzo a due sponde tiene la bianca sulla sponda di fondo. Un tiro così riesce forse una volta su dieci; a renderlo grande è la posizione sulla palla successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツークッションキックで少しひねると、手球がフットクッションに沿う。こんな球は10回に1回入るかどうか。すごいのは次の球へのポジションまで取れたとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투쿠션 킥에 회전을 조금 주면 큐볼이 풋 쿠션을 타요. 이런 샷은 열 번에 한 번쯤 들어가요. 다음 공 포지션까지 잡으면 진짜 대단한 거죠."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco de efeito numa tabela a duas tabelas mantém a branca na tabela do pé. Uma jogada destas entra talvez uma vez em dez; o que a torna grande é a posição para a tua bola seguinte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco de efeito numa tabela de duas tabelas mantém a branca na tabela do pé. Uma jogada dessas entra talvez uma vez em dez; o que a torna incrível é a posição para a sua próxima bola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немного винта при ударе через два борта держит биток у нижнего борта. Такой удар выходит, может, раз из десяти; великим его делает выход на следующий шар."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两库解球加一点塞，能让母球贴着脚库走。这种球大概十次进一次；真正厉害的是还走好下一颗球的位置。"
          }
        }
      }
    },
    "A medium stroke.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربة متوسطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein mittlerer Stoß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un golpe medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coup moyen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un colpo medio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中くらいのストローク。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중간 세기 스트로크."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tacada média."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tacada média."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средний удар."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中等力度。"
          }
        }
      }
    },
    "A pool game that shows its working. Take a shot, then watch the physics behind it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعبة بلياردو تُظهر طريقة عملها. اضرب، ثم شاهد الفيزياء التي تقف وراءها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Billardspiel, das seine Rechnung offenlegt. Stoß ausführen und dann die Physik dahinter beobachten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un juego de billar que muestra cómo funciona. Haz un tiro y luego mira la física que hay detrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jeu de billard qui montre son fonctionnement. Réalise un coup, puis regarde la physique qui se cache derrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gioco di biliardo che mostra come funziona. Fai un tiro, poi guarda la fisica che c'è dietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算の過程まで見せるビリヤードゲーム。ショットを打ったら、その裏の物理を見てみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀이 과정을 보여 주는 당구 게임. 샷을 치고 그 뒤의 물리를 지켜보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogo de bilhar que mostra o seu raciocínio. Dá uma tacada e depois vê a física por trás dela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogo de bilhar que mostra como funciona. Dê uma tacada e depois veja a física por trás dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бильярдная игра, которая показывает, как всё устроено. Сделай удар и посмотри на физику, стоящую за ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一款会展示过程的台球游戏。先击球，再看背后的物理原理。"
          }
        }
      }
    },
    "A raised bridge gives the steep cue a jump needs when the cue ball is out of reach. Touching any ball with the bridge is a foul.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجسر المرفوع يعطي العصا الزاوية الحادة التي تحتاجها القفزة حين تكون الكرة البيضاء بعيدة. لمس أي كرة بالجسر خطأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine erhöhte Brücke gibt dem Queue den steilen Winkel, den ein Sprung braucht, wenn die Weiße außer Reichweite ist. Mit der Brücke eine Kugel berühren ist ein Foul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un puente elevado da al taco el ángulo empinado que necesita un salto cuando la blanca está fuera de alcance. Tocar cualquier bola con el puente es falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pont surélevé donne à la queue l'angle raide qu'il faut pour sauter quand la blanche est hors de portée. Toucher une bille avec le pont est une faute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rastrello rialzato dà alla stecca l'angolo ripido che serve per saltare quando la bianca è fuori portata. Toccare una palla col rastrello è fallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高いブリッジなら、手球に手が届かなくてもジャンプに必要な急角度を作れる。ブリッジで球に触れるとファウル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높은 브리지는 큐볼이 손에 닿지 않을 때 점프에 필요한 가파른 각도를 줘요. 브리지로 공을 건드리면 파울이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ponte alta dá ao taco o ângulo inclinado de que um salto precisa quando a branca está fora de alcance. Tocar numa bola com a ponte é falta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ponte alta dá ao taco o ângulo inclinado de que um pulo precisa quando a branca está fora de alcance. Encostar numa bola com a ponte é falta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высокий мостик даёт кию крутой угол для прыжка, когда до битка не дотянуться. Коснуться мостиком любого шара — фол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高架杆能在够不着母球时给出跳球所需的陡角度。架杆碰到任何球都算犯规。"
          }
        }
      }
    },
    "A raised cue drives the cue ball down into the slate. The slate pushes back, the ball leaves the cloth, flies over the 6, bounces and rolls on into the 11.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العصا المرفوعة تدفع الكرة البيضاء إلى الأرض الصلبة. فترتد عنها، فتترك الكرة اللباد وتطير فوق الكرة 6 ثم ترتد وتتدحرج إلى الكرة 11."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein hochgestelltes Queue drückt die Spielkugel in den Schiefer. Der Schiefer drückt zurück, die Kugel verlässt das Tuch, fliegt über die 6, prallt auf und rollt in die 11."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taco levantado empuja la bola blanca contra la pizarra. La pizarra empuja de vuelta, la bola deja el paño, vuela sobre la 6, rebota y sigue rodando hacia la 11."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une queue relevée enfonce la blanche dans l'ardoise. L'ardoise repousse, la bille quitte le tapis, passe au-dessus de la 6, rebondit et roule jusqu'à la 11."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stecca alzata spinge la bianca giù contro l'ardesia. L'ardesia spinge indietro, la palla lascia il panno, vola sopra la 6, rimbalza e rotola fino alla 11."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立てたキューは手球を台の下のスレートに打ち込みます。スレートが押し返し、球はラシャを離れて6番を飛び越え、バウンドして11番へ転がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세운 큐는 흰 공을 바닥의 슬레이트로 내리누릅니다. 슬레이트가 되밀면 공은 천에서 떨어져 6번 위를 날아 넘고, 튀어 올라 11번까지 굴러갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco levantado empurra a branca contra a ardósia. A ardósia empurra de volta, a bola sai do pano, voa por cima da 6, quica e rola até a 11."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco levantado empurra a branca contra a ardósia. A ardósia empurra de volta, a bola sai do pano, voa por cima da 6, quica e rola até a 11."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднятый кий вдавливает биту в плиту. Плита отталкивает её, шар отрывается от сукна, летит над 6, подпрыгивает и катится в 11."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立杆会把母球压向台面底板。底板将其弹回，球离开台呢，飞过6号球，弹跳后滚进11号球。"
          }
        }
      }
    },
    "A raised cue struck off-centre spins the cue ball about a tilted axis. As it slides, the cloth's friction pushes sideways on that spin and the path curves.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عصا مرفوعة تُضرب خارج المركز تُدير الكرة البيضاء حول محور مائل. وأثناء انزلاقها يدفع احتكاك اللباد هذا الدوران جانبًا فينحني المسار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein hochgestelltes Queue, außermittig gestoßen, dreht die Spielkugel um eine geneigte Achse. Während sie gleitet, drückt die Reibung des Tuchs seitlich auf diesen Drall, und die Bahn krümmt sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taco levantado y golpeado descentrado hace girar la bola blanca sobre un eje inclinado. Mientras desliza, la fricción del paño empuja de lado ese giro y la trayectoria se curva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une queue relevée et frappée décentrée fait tourner la blanche autour d'un axe incliné. Pendant qu'elle glisse, le frottement du tapis pousse de côté sur cette rotation et la trajectoire se courbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stecca alzata e colpita fuori centro fa girare la bianca attorno a un asse inclinato. Mentre scivola, l'attrito del panno spinge lateralmente quella rotazione e la traiettoria si curva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを立てて中心を外して打つと、手球は傾いた軸まわりに回転します。滑っている間、ラシャの摩擦がその回転を横へ押し、軌道が曲がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 세우고 중심을 벗어나 치면 흰 공이 기울어진 축을 중심으로 회전합니다. 미끄러지는 동안 천의 마찰이 그 회전을 옆으로 밀어 궤적이 휘어집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco levantado e batido fora do centro faz a branca girar em torno de um eixo inclinado. Enquanto desliza, o atrito do pano empurra de lado esse giro e a trajetória se curva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco levantado e batido fora do centro faz a branca girar em torno de um eixo inclinado. Enquanto desliza, o atrito do pano empurra de lado esse giro e a trajetória se curva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднятый кий, ударенный не по центру, раскручивает биту вокруг наклонной оси. Пока она скользит, трение сукна толкает это вращение в сторону, и путь искривляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立杆并偏离中心击打时，母球会绕一根倾斜的轴旋转。它滑动时，台呢的摩擦把这种旋转推向一侧，轨迹随之弯曲。"
          }
        }
      }
    },
    "A rolling cue ball that cuts half of the object ball ends up turned about 30 degrees off its original line.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكرة البيضاء المتدحرجة التي تقطع نصف الكرة المستهدفة تنتهي منحرفة نحو 30 درجة عن خطها الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine rollende weiße Kugel, die die Zielkugel halb anschneidet, weicht am Ende etwa 30 Grad von ihrer ursprünglichen Linie ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bola blanca que rueda y corta media bola objetivo termina desviada unos 30 grados de su línea original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bille blanche qui roule et coupe la moitié de la bille cible finit déviée d'environ 30 degrés de sa ligne d'origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palla bianca che rotola e taglia a metà la palla bersaglio finisce deviata di circa 30 gradi rispetto alla sua linea originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転がる手球が的球の半分をカットすると、元の進路から約30度ずれて進みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구르는 큐볼이 목적구의 절반을 컷하면, 원래 진행 방향에서 약 30도 틀어집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma bola branca a rolar que corta meia bola-alvo acaba desviada cerca de 30 graus da sua linha original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma bola branca rolando que corta meia bola-alvo acaba desviada cerca de 30 graus da linha original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Катящийся белый шар, который срезает половину прицельного шара, уходит примерно на 30 градусов от исходной линии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动的白球以半球切入目标球，最终会偏离原来路线约30度。"
          }
        }
      }
    },
    "A small table with rubber bumpers and a cup at each end.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طاولة صغيرة بمصدّات مطاطية وحفرة في كل طرف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleiner Tisch mit Gummipfosten und einem Loch an jedem Ende."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mesa pequeña con topes de goma y un hoyo en cada extremo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite table avec des plots en caoutchouc et un trou à chaque bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tavolo piccolo con respingenti di gomma e una buca a ogni estremità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴムのバンパーが並び、両端にカップがある小さなテーブル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고무 범퍼가 있고 양 끝에 컵이 있는 작은 테이블."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mesa pequena com pinos de borracha e um buraco em cada ponta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mesa pequena com pinos de borracha e um buraco em cada ponta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Небольшой стол с резиновыми столбиками и лункой на каждом конце."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张小球台，有橡胶挡柱，两端各有一个球洞。"
          }
        }
      }
    },
    "A steep cue gives the cue ball spin about a tilted axis, and the cloth turns that spin into a curve.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعطي العصا الشديدة الميل الكرة البيضاء لفاً حول محور مائل، ويحوّل اللباد ذلك اللف إلى انحناء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine steile Queue gibt der weißen Kugel Drall um eine geneigte Achse, und das Tuch macht diesen Drall zu einer Kurve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taco muy inclinado da a la bola blanca un giro sobre un eje inclinado, y el paño convierte ese giro en una curva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une queue très inclinée donne à la bille blanche une rotation autour d'un axe incliné, et le tapis transforme cette rotation en courbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stecca inclinata dà alla palla bianca una rotazione su un asse inclinato, e il panno trasforma quella rotazione in una curva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを急角度にすると、手球は傾いた軸を中心に回転し、その回転が布の上でカーブに変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 가파르게 세우면 큐볼은 기울어진 축을 중심으로 돌고, 천이 그 회전을 곡선으로 바꿉니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco muito inclinado dá à bola branca efeito num eixo inclinado, e o pano transforma esse efeito numa curva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco bem inclinado dá à bola branca efeito num eixo inclinado, e o pano transforma esse efeito numa curva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крутой наклон кия закручивает белый шар вокруг наклонной оси, а сукно превращает это вращение в дугу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陡峭的杆角会让白球绕倾斜的轴旋转，台布会把这种旋转变成弧线。"
          }
        }
      }
    },
    "A swerve is a gentle bend from a slightly raised cue. It's the easiest curve, and the usual fallback when the kick lanes are bad.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانحناء ميل لطيف من عصا مرفوعة قليلاً. إنه أسهل انحناء، والبديل المعتاد حين تسوء مسارات الارتداد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kurve ist eine sanfte Biegung mit leicht angehobenem Queue. Die einfachste Kurve und der übliche Ausweg, wenn die Vorbänder-Wege schlecht sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una curva suave sale de un taco algo elevado. Es la curva más fácil y el recurso habitual cuando los rebotes no van bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une courbe douce vient d'une queue un peu levée. C'est la courbe la plus facile, et la solution habituelle quand les bricoles sont mauvaises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una curva è una piega dolce con la stecca un po' alzata. È la curva più facile e il ripiego solito quando i rimbalzi non vanno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーブはキューを少し上げて生む緩やかな曲がり。一番簡単なカーブで、キックのラインが悪いときの定番の逃げ道。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커브는 큐를 살짝 들어 만드는 완만한 휨이에요. 가장 쉬운 커브이고, 킥 경로가 나쁠 때 흔히 쓰는 대안이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma curva é uma dobra suave com o taco um pouco levantado. É a curva mais fácil e a saída habitual quando as tabelas não dão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma curva é uma dobra suave com o taco um pouco levantado. É a curva mais fácil e a saída de sempre quando as tabelas não dão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изгиб — мягкая дуга с чуть поднятым кием. Это самый лёгкий вид кривой и обычный выход, когда линии через борт плохие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弧线球是稍抬球杆打出的缓弯，最容易的曲线，也是库边线路不好时的常用后手。"
          }
        }
      }
    },
    "A swerve that runs the length of the table can pocket a ball you can't see. The longer the path, the more the curve depends on the cloth and the speed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانحناء الذي يجري بطول الطاولة يمكن أن يُدخل كرة لا تراها. كلما طال المسار، اعتمد الانحناء أكثر على القماش والسرعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kurve über die ganze Tischlänge kann eine Kugel versenken, die du nicht siehst. Je länger der Weg, desto mehr hängt die Kurve von Tuch und Tempo ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una curva que recorre toda la mesa puede meter una bola que no ves. Cuanto más largo el recorrido, más depende la curva del paño y la velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une courbe qui parcourt toute la table peut rentrer une bille que tu ne vois pas. Plus le trajet est long, plus la courbe dépend du tapis et de la vitesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una curva che percorre tutto il tavolo può imbucare una palla che non vedi. Più è lungo il percorso, più la curva dipende da panno e velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台の端から端まで走るカーブなら、見えない球も落とせる。道のりが長いほど、カーブはクロスとスピード次第。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테이블 끝까지 가는 커브는 안 보이는 공도 넣을 수 있어요. 경로가 길수록 커브는 천과 속도에 더 좌우돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma curva que percorre a mesa toda pode encaçapar uma bola que não vês. Quanto mais longo o caminho, mais a curva depende do pano e da velocidade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma curva que percorre a mesa toda pode encaçapar uma bola que você não vê. Quanto mais longo o caminho, mais a curva depende do pano e da velocidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изгиб через весь стол может забить шар, которого ты не видишь. Чем длиннее путь, тем больше изгиб зависит от сукна и скорости."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跑满全台的弧线球能打进你看不见的球。路线越长，弧线就越依赖台呢和速度。"
          }
        }
      }
    },
    "A trace of side spin: the rebound shifts and the 10 comes off the rail short of the corner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثر بسيط من اللف الجانبي: يتغير الارتداد وتخرج الكرة 10 عن الحافة قبل الزاوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hauch Effet: Der Abprall verschiebt sich, und die 10 löst sich vor der Ecke von der Bande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pizca de efecto: el rebote cambia y la 10 se despega de la banda antes de la esquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un soupçon d'effet : le rebond se décale et la 10 quitte la bande avant le coin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un filo di effetto: il rimbalzo cambia e la 10 si stacca dalla sponda prima dell'angolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほんのわずかなひねり：跳ね返りがずれて、10番がコーナー手前でクッションから離れる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아주 약간의 회전: 반사가 틀어져서 10번이 코너 전에 쿠션에서 떨어져요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pingo de efeito: o ressalto muda e a 10 sai da tabela antes do canto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pingo de efeito: o rebote muda e a 10 sai da tabela antes do canto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Капля винта: отскок смещается, и 10 отходит от борта, не дойдя до угла."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带一丝塞：反弹偏移，10 号球在角袋前离开库边。"
          }
        }
      }
    },
    "About %@ times tighter than a plain straight-in shot.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصعب بنحو %@ مرة من ضربة مستقيمة عادية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %@-mal enger als ein einfacher gerader Stoß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas %@ veces más ajustado que un tiro recto simple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %@ fois plus serré qu'un simple coup droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa %@ volte più stretto di un semplice tiro dritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まっすぐな普通のショットよりおよそ %@ 倍シビア。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평범한 일직선 샷보다 약 %@배 빡빡해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de %@ vezes mais apertado do que uma jogada reta simples."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de %@ vezes mais apertado que uma jogada reta simples."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно в %@ раз точнее простого прямого удара."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比普通直线球严苛约 %@ 倍。"
          }
        }
      }
    },
    "About a firm lag.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحو ضربة قياس قوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa ein kräftiger Lag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más o menos un arrime firme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À peu près un lag appuyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più o meno un acchito deciso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しっかりめのラグくらい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단단한 래그 정도."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais ou menos um lag firme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais ou menos um lag firme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно как уверенный лаг."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大约一记有力的比杆。"
          }
        }
      }
    },
    "Aim": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصويب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zielen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apuntar"
