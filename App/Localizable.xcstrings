        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윗회전도 아랫회전도 거의 없이 떠납니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai quase sem efeito alto nem baixo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai quase sem efeito alto nem baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он уходит почти без верхнего и нижнего вращения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它离开时几乎不带上旋或回旋。"
          }
        }
      }
    },
    "It leaves with backspin (draw): %@ percent of a rolling ball's spin, turning backwards.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطلق بدوران خلفي (سحب): %@ في المئة من دوران كرة متدحرجة، لكن إلى الخلف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie läuft mit Rückwärtseffet ab (Zieher): %@ Prozent des Dralls einer rollenden Kugel, aber rückwärts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale con efecto de retroceso (draw): el %@ por ciento del giro de una bola que rueda, pero hacia atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle part avec de l'effet rétro : %@ pour cent de la rotation d'une bille qui roule, mais vers l'arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte con effetto a ritroso (draw): il %@ per cento della rotazione di una palla che rotola, ma all'indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックスピン（引き球）で出ていきます。転がる球の回転の%@パーセントで、向きは逆です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백스핀(끌어치기)을 품고 나갑니다. 구르는 공 회전의 %@퍼센트이며, 방향은 반대입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai com efeito de recuo (draw): %@ por cento da rotação de uma bola a rolar, mas para trás."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai com efeito de recuo (draw): %@ por cento do giro de uma bola rolando, mas para trás."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он уходит с обратным вращением (оттяжка): %@ процентов вращения катящегося шара, но назад."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它带着回旋（缩杆）出去：相当于滚动球旋转的百分之%@，但方向向后。"
          }
        }
      }
    },
    "It leaves with backspin, which the cloth must wear off before it rolls.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغادر بدوران خلفي يجب أن يستهلكه الجوخ قبل أن تتدحرج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie läuft mit Rückwärtseffet ab, den das Tuch erst abbauen muss, bevor sie rollt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale con efecto de retroceso, que el paño tiene que gastar antes de que ruede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle repart avec de l'effet rétro, que le tapis doit user avant qu'elle roule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riparte con effetto a ritroso, che il panno deve consumare prima che rotoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックスピンを持って離れ、転がり始める前にラシャがそれを消さなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백스핀을 품고 떠나며, 구르기 전에 천이 그것을 닳게 해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai com efeito de recuo, que o pano tem de gastar antes de ela rolar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai com efeito de recuo, que o pano precisa gastar antes de ela rolar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он уходит с обратным вращением, которое сукно должно погасить, прежде чем шар покатится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它带着回旋离开，台呢要先把回旋磨掉它才会滚动。"
          }
        }
      }
    },
    "It leaves with more topspin than a rolling ball (%@ percent): the cloth pulls it faster until it rolls.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطلق بدوران أمامي أكثر من كرة متدحرجة (%@ في المئة): يسرّعها الجوخ حتى تتدحرج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie läuft mit mehr Vorwärtseffet ab als eine rollende Kugel (%@ Prozent): Das Tuch zieht sie schneller, bis sie rollt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale con más efecto alto que una bola que rueda (el %@ por ciento): el paño la acelera hasta que rueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle part avec plus d'effet coulé qu'une bille qui roule (%@ pour cent) : le tapis l'accélère jusqu'à ce qu'elle roule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte con più effetto in avanti di una palla che rotola (il %@ per cento): il panno la accelera finché non rotola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転がる球より強いトップスピンで出ていきます（%@パーセント）。転がり始めるまでラシャが球を加速させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구르는 공보다 강한 탑스핀으로 나갑니다(%@퍼센트). 구르기 시작할 때까지 천이 공을 더 빠르게 끌어당깁니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai com mais efeito alto do que uma bola a rolar (%@ por cento): o pano acelera-a até ela rolar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai com mais efeito alto do que uma bola rolando (%@ por cento): o pano a acelera até ela rolar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он уходит с более сильным верхним вращением, чем у катящегося шара (%@ процентов): сукно разгоняет его, пока он не покатится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它带着比滚动球更强的上旋出去（百分之%@）：台呢会把它拉快，直到它滚动。"
          }
        }
      }
    },
    "It leaves with more topspin than rolling.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغادر بدوران أمامي أكثر من التدحرج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie läuft mit mehr Vorwärtseffet ab als beim Rollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale con más efecto alto que rodando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle repart avec plus d'effet coulé qu'en roulant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riparte con più effetto in avanti che rotolando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転がりより強いトップスピンで離れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구를 때보다 강한 탑스핀을 품고 떠납니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai com mais efeito alto do que a rolar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai com mais efeito alto do que rolando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он уходит с более сильным верхним вращением, чем при качении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它带着比滚动时更强的上旋离开。"
          }
        }
      }
    },
    "It leaves with some topspin, less than rolling.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغادر ببعض الدوران الأمامي، أقل من التدحرج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie läuft mit etwas Vorwärtseffet ab, weniger als beim Rollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale con algo de efecto alto, menos que rodando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle repart avec un peu d'effet coulé, moins qu'en roulant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riparte con un po' di effetto in avanti, meno che rotolando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転がりより弱いトップスピンで離れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구를 때보다 약한 탑스핀을 품고 떠납니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai com algum efeito alto, menos do que a rolar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai com um pouco de efeito alto, menos do que rolando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он уходит с небольшим верхним вращением, слабее, чем при качении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它带着一些上旋离开，比滚动时少。"
          }
        }
      }
    },
    "It leaves with topspin (follow): %@ percent of a rolling ball's spin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطلق بدوران أمامي (متابعة): %@ في المئة من دوران كرة متدحرجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie läuft mit Vorwärtseffet ab (Nachläufer): %@ Prozent des Dralls einer rollenden Kugel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale con efecto alto (follow): el %@ por ciento del giro de una bola que rueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle part avec de l'effet coulé : %@ pour cent de la rotation d'une bille qui roule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte con effetto in avanti (follow): il %@ per cento della rotazione di una palla che rotola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トップスピン（押し球）で出ていきます。転がる球の回転の%@パーセントです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탑스핀(밀어치기)을 품고 나갑니다. 구르는 공 회전의 %@퍼센트입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
