    "%@ catches %@ at %@ m/s and is turned away from the hole. A little more to the middle of the pocket and it drops.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يلتقط %@ بسرعة %@ m/s فيُصرف عن الفتحة. بقليل أكثر نحو وسط الجيب تسقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erwischt %@ mit %@ m/s und wird von der Tasche abgewiesen. Ein wenig mehr zur Mitte der Tasche, und sie fällt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ alcanza a %@ a %@ m/s y es rechazada por la boca de la tronera. Un poco más hacia el centro de la tronera y cae."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ touche %@ à %@ m/s et est repoussée par l'ouverture de la poche. Un peu plus vers le milieu de la poche et elle tombe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ intercetta %@ a %@ m/s e viene deviata dalla buca. Un po' più verso il centro della buca e cade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が%@を%@ m/sで捉え、穴から押し戻されます。ポケットの中央寄りに少し当たれば落ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)가 %@(을)를 %@ m/s로 잡아, 구멍에서 밀려납니다. 포켓 가운데 쪽으로 조금 더 가면 떨어집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ atinge %@ a %@ m/s e é desviada do buraco. Um pouco mais para o meio da caçapa e ela cai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ atinge %@ a %@ m/s e é desviada do buraco. Um pouco mais para o meio da caçapa e ela cai."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ задевает %@ на скорости %@ m/s и отводится от лузы. Чуть ближе к середине лузы, и шар упадёт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 接住 %@，速度为 %@ m/s，被挡在袋口之外。再往袋中间偏一点，它就会落袋。"
          }
        }
      }
    },
