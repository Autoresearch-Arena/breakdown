        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi falta, por isso %1$@ fica com os pontos, subidos ao mínimo de uma falta: %2$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi falta, então %1$@ fica com os pontos, aumentados para o mínimo de uma falta: %2$lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
