    "You called Safety: a legal hit that leaves them hooked.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلنت دفاعاً: ضربة قانونية تتركهم محاصرين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Safety angesagt: ein gültiger Treffer, der den Gegner gesnookert lässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cantaste seguridad: un golpe legal que los deja tapados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as annoncé une sécurité : une touche valable qui les laisse coincés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai chiamato difesa: un colpo valido che li lascia coperti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーフティを宣言：相手をスヌーカーにする反則なしの一打。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세이프티를 선언했어요: 상대를 막히게 하는 정당한 타구."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anunciaste defesa: um toque legal que os deixa tapados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você anunciou defesa: um toque legal que deixa eles tapados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты заказал отыгрыш: удар по правилам, после которого соперник закрыт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你叫了防守：一杆合法球，让对手被卡住。"
          }
        }
      }
    },
    "You called the %lld: %@.": {
