    "Break and drop the 3 in the top-right corner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتتح واجعل الكرة 3 تسقط في الزاوية العلوية اليمنى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Break und die 3 in die obere rechte Ecke versenken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rompe y mete la 3 en la esquina de arriba a la derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Casse et rentre la 3 dans le coin en haut à droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rompi e metti in buca la 3 nell'angolo in alto a destra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレイクして3番を右上のコーナーに落とそう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브레이크하고 3번을 오른쪽 위 코너에 넣으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quebra e encaçapa a 3 no canto superior direito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quebre e encaçape a 3 no canto superior direito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разбей и загони 3 в правый верхний угол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开球并把3号球打进右上角袋口。"
          }
        }
      }
    },
