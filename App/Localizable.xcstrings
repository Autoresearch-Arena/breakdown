{
  "sourceLanguage": "en",
  "strings": {
    "%@ The ball is out of reach, so the bridge holds the cue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ الكرة بعيدة عن متناول اليد، لذلك يسند الجسرُ العصا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Die Kugel ist außer Reichweite, deshalb stützt die Brücke die Queue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La bola está fuera de alcance, así que el puente sostiene el taco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La bille est hors de portée, donc le pont tient la queue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La palla è fuori portata, quindi il rastrello sostiene la stecca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 球に手が届かないので、ブリッジでキューを支えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 공에 손이 닿지 않아서, 브리지로 큐를 받칩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ A bola está fora de alcance, por isso a ponte segura o taco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ A bola está fora de alcance, então a ponte segura o taco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Шар вне досягаемости, поэтому мостик держит кий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 这颗球够不着，所以由架杆托住球杆。"
          }
        }
      }
    },
