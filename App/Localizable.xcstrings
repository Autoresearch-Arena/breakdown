    "Pinch to zoom and drag with two fingers to move around. Double-tap a ball to zoom in on it, and again to come back out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب إصبعين أو باعدهما للتكبير، واسحب بإصبعين للتنقل. انقر مرتين على كرة لتكبيرها، ومرة أخرى للرجوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh zwei Finger auseinander zum Zoomen und schieb mit zwei Fingern, um dich zu bewegen. Tippe zweimal auf eine Kugel, um sie heranzuholen, und noch einmal, um zurückzugehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca para hacer zoom y arrastra con dos dedos para moverte. Toca dos veces una bola para acercarte y otra vez para volver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pince pour zoomer et fais glisser à deux doigts pour te déplacer. Touche deux fois une bille pour zoomer dessus, et encore pour revenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizzica per lo zoom e trascina con due dita per spostarti. Tocca due volte una palla per avvicinarti, e di nuovo per tornare indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンチで拡大・縮小、2本指のドラッグで移動します。球をダブルタップするとその球に寄り、もう一度で戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핀치로 확대하고 두 손가락으로 드래그해 이동하세요. 공을 두 번 탭하면 그 공을 확대하고, 다시 두 번 탭하면 돌아옵니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz pinça para ampliar e arrasta com dois dedos para te deslocares. Toca duas vezes numa bola para a aproximar, e outra vez para voltar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça pinça para dar zoom e arraste com dois dedos para se mover. Toque duas vezes numa bola para aproximar, e de novo para voltar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведи или разведи пальцы для масштаба и веди двумя пальцами, чтобы двигаться. Дважды коснись шара, чтобы приблизить его, и ещё раз, чтобы вернуться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双指捏合缩放，双指拖动来移动。双击一颗球放大它，再双击一次回到原样。"
          }
        }
      }
    },
