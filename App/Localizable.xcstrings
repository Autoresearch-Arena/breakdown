    "Cloth: %@. Sliding friction %@, standard %@. Rolling resistance %@, standard %@. Cushion bounce %@, standard %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القماش: %1$@. احتكاك الانزلاق %2$@، والقياسي %3$@. مقاومة التدحرج %4$@، والقياسي %5$@. ارتداد الوسادة %6$@، والقياسي %7$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuch: %1$@. Gleitreibung %2$@, Standard %3$@. Rollwiderstand %4$@, Standard %5$@. Bandenabprall %6$@, Standard %7$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paño: %1$@. Fricción de deslizamiento %2$@, estándar %3$@. Resistencia a la rodadura %4$@, estándar %5$@. Rebote de banda %6$@, estándar %7$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapis : %1$@. Frottement de glisse %2$@, standard %3$@. Résistance au roulement %4$@, standard %5$@. Rebond des bandes %6$@, standard %7$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Panno: %1$@. Attrito di scivolamento %2$@, standard %3$@. Resistenza al rotolamento %4$@, standard %5$@. Rimbalzo delle sponde %6$@, standard %7$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クロス：%1$@。滑り摩擦 %2$@、標準 %3$@。転がり抵抗 %4$@、標準 %5$@。クッションの反発 %6$@、標準 %7$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천: %1$@. 미끄럼 마찰 %2$@, 표준 %3$@. 구름 저항 %4$@, 표준 %5$@. 쿠션 반발 %6$@, 표준 %7$@."
          }
