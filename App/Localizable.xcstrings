            "value": "Ein mittlerer Stoß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un golpe medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coup moyen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un colpo medio."
          }
        },
        "ja": {
