          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais opções de tacada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais opções de tacada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие варианты удара"
          }
        },
        "zh-Hans": {
