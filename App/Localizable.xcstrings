    "%@ may play the table as it lies or have it re-racked.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ%@ اللعب على الوضع الحالي أو طلب إعادة الترتيب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ darf vom Tisch weiterspielen oder neu aufbauen lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ puede jugar la mesa como está o pedir que se vuelva a colocar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ peut jouer la table telle quelle ou faire remettre les billes en place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ può giocare il tavolo così com'è o far ricomporre il triangolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこのまま続けるか、ラックし直すかを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이대로 치거나 다시 랙을 짜게 할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pode jogar a mesa como está ou pedir nova arrumação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pode jogar a mesa como está ou pedir para arrumar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ может играть с текущей позиции или попросить перестановку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@可以按现状继续，或要求重新摆球。"
          }
        }
      }
    },
