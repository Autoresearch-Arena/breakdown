          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva também efeito lateral à direita, que se vai ver na próxima tabela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva também efeito lateral à direita, que vai aparecer na próxima tabela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё у него правый боковой винт, который проявится у следующего борта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它还带着右侧旋，会在下一次碰库时显现。"
          }
        }
      }
    },
    "It also played for the cue ball to stop with a clear shot at its next ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وخطّط أيضًا لتتوقف الكرة البيضاء في موضع يتيح ضربة واضحة على كرته التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er spielte auch so, dass die Weiße mit freiem Weg zur nächsten Kugel liegen bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También buscó que la blanca quedara con tiro limpio a su siguiente bola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a aussi joué pour que la blanche s'arrête avec un coup dégagé sur sa bille suivante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha anche giocato perché la bianca si fermasse con un tiro libero sulla palla successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の球を狙いやすい位置に手球を止めることも考えていました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 공을 깨끗하게 칠 수 있는 자리에 수구를 세우려고도 했습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Também jogou para a branca parar com jogada limpa à bola seguinte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também jogou para a branca parar com jogada livre na bola seguinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он ещё играл на то, чтобы биток встал с чистым ударом по следующему шару."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它还打算让母球停在能清楚打下一颗球的位置。"
          }
        }
      }
    },
    "It came back %@ off the cue line.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادت على بعد %@ من خط العصا."
