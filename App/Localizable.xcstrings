    "Watch each shot, see the physics behind it in the Lens, then make it yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد كل ضربة، وتعرّف على الفيزياء وراءها في العدسة، ثم نفّذها بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir jeden Stoß an, entdecke die Physik dahinter in der Lens und mach ihn dann selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cada tiro, descubre su física en la Lente y luego hazlo tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde chaque coup, découvre sa physique dans la lentille, puis réussis-le toi-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda ogni colpo, scopri la fisica che lo regge nella lente, poi fallo tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショットを見て、レンズでその裏にある物理を確かめ、自分でも決めてみよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 샷을 보고, 렌즈로 그 뒤의 물리를 확인한 다음, 직접 성공시켜 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê cada jogada, descobre a física por trás dela na lente e depois faz tu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assista a cada tacada, veja a física por trás dela na lente e depois faça você mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотри каждый удар, увидь физику за ним в линзе, а затем повтори сам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观看每一杆，用镜片看清背后的物理原理，然后亲自打出来。"
          }
        }
      }
    },
