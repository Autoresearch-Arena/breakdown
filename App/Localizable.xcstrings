    "%@ was moving at %@ m/s. Energy handed off: %@ percent goes to %@, %@ percent stays, and the rest is lost as heat and sound.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كانت %@ تتحرك بسرعة %@ m/s. انتقال الطاقة: %@ في المئة تذهب إلى %@، و%@ في المئة تبقى، والباقي يضيع على شكل حرارة وصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bewegte sich mit %@ m/s. Übertragene Energie: %@ Prozent gehen an %@, %@ Prozent bleiben, und der Rest geht als Wärme und Schall verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se movía a %@ m/s. Energía transferida: el %@ por ciento pasa a %@, el %@ por ciento se queda, y el resto se pierde como calor y sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se déplaçait à %@ m/s. Énergie transmise : %@ pour cent passe à %@, %@ pour cent reste, et le reste se perd en chaleur et en son."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si muoveva a %@ m/s. Energia trasferita: il %@ per cento va a %@, il %@ per cento resta, e il resto si perde come calore e suono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は%@ m/sで動いていました。エネルギーの受け渡し：%@%は%@へ、%@%は残り、残りは熱と音として失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(은)는 %@ m/s로 움직이고 있었습니다. 에너지 전달: %@%는 %@에게, %@%는 그대로 남고, 나머지는 열과 소리로 사라집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se movia a %@ m/s. Energia transferida: %@ por cento vai para %@, %@ por cento fica, e o resto se perde como calor e som."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se movia a %@ m/s. Energia transferida: %@ por cento vai para %@, %@ por cento fica, e o resto se perde como calor e som."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ двигался со скоростью %@ m/s. Передача энергии: %@ процентов уходит к %@, %@ процентов остаётся, а остальное теряется в виде тепла и звука."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以 %@ m/s 的速度运动。能量转移：百分之%@ 传给%@，百分之%@ 留在原处，其余以热和声音的形式散失。"
          }
        }
      }
    },
