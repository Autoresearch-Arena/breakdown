    "You changed %@, and %@. With several changes at once, this alone can't say which one did it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّرت %@، و%@. مع عدة تغييرات في وقت واحد لا يمكن معرفة أيها كان السبب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %@ geändert, und %@. Bei mehreren Änderungen auf einmal lässt sich nicht sagen, welche es war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiaste %@, y %@. Con varios cambios a la vez, esto solo no dice cuál fue el responsable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as changé %@, et %@. Avec plusieurs changements à la fois, impossible de dire lequel a compté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai cambiato %@, e %@. Con più cambi insieme, da solo questo non dice quale abbia contato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を変えました。そして%@。一度に複数を変えたので、どれが効いたかはこれだけでは分かりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 바꿨고, %@. 한 번에 여러 가지를 바꿔서 어느 것 때문인지는 이것만으로 알 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudaste %@, e %@. Com várias mudanças de uma vez, isto sozinho não diz qual delas foi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você mudou %@, e %@. Com várias mudanças de uma vez, só isso não diz qual delas foi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты изменил %@, и %@. При нескольких изменениях сразу нельзя сказать, какое из них сработало."
