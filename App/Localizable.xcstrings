    "%@: put the 8 back on its spot, or rack again?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: هل تعيد الكرة 8 إلى نقطتها أم ترتّب من جديد؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: die 8 wieder aufsetzen oder neu aufbauen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ¿reponer la 8 en su punto o volver a colocar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : replacer la 8 sur son point, ou remettre en place ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: rimettere la 8 sul suo punto o ricomporre?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：8番をスポットに戻しますか、それともラックし直しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 8번을 제자리에 둘까요, 다시 랙할까요?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: repor a 8 na marca ou arrumar de novo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: recolocar a 8 na marca ou arrumar de novo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: вернуть восьмёрку на точку или расставить заново?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：把 8 号球放回置球点，还是重新摆球？"
          }
        }
      }
    },
    "%@: take the table as it lies, or have it racked again?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: هل تأخذ الطاولة كما هي أم يُعاد ترتيبها؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: den Tisch so übernehmen oder neu aufbauen lassen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ¿jugar la mesa tal como está o volver a colocar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : prendre la table telle quelle, ou la faire remettre en place ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: prendere il tavolo così com'è o farlo ricomporre?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：このまま打ちますか、それともラックし直しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 지금 상태로 칠까요, 다시 랙할까요?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ficar com a mesa como está ou mandar arrumar de novo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: assumir a mesa como está ou mandar arrumar de novo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: принять стол как есть или расставить заново?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：按现状接手球台，还是重新摆球？"
          }
        }
      }
    },
