    "Past the calm zone every stroke wanders more.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد المنطقة الهادئة، تنحرف كل ضربة أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jenseits der ruhigen Zone weicht jeder Stoß stärker ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más allá de la zona tranquila, cualquier golpe se desvía más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-delà de la zone calme, chaque coup dévie davantage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oltre la zona tranquilla, ogni colpo devia di più."
