            "value": "Твой шар коснулся 1 борта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的球碰了 1 库。"
          }
        }
      }
    },
    "Your ball travelled %@ m.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قطعت كرتك %@ م."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kugel lief %@ m."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu bola recorrió %@ m."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bille a parcouru %@ m."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua palla ha percorso %@ m."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "君の球は %@ m 進んだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네 공이 %@ m를 갔어요."
          }
        },
        "pt": {
