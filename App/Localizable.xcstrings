          }
        }
      }
    },
    "A new game ends it for good.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المباراة الجديدة تنهيها نهائياً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Partie beendet sie endgültig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una partida nueva la termina para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle partie la termine pour de bon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nuova partita la chiude per sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい試合を始めると、保存した試合は完全に終わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 경기를 시작하면 저장된 경기는 완전히 끝납니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova partida termina-a de vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova partida encerra essa de vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая партия завершит её насовсем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始新比赛会永久结束它。"
          }
        }
      }
    },
    "A new game replaces your saved one: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللعبة الجديدة تحل محل لعبتك المحفوظة: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neues Spiel ersetzt dein gespeichertes: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una partida nueva reemplaza la que tienes guardada: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle partie remplace celle que tu as enregistrée : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nuova partita sostituisce quella che hai salvato: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいゲームを始めると、保存中のゲームは置き換わる：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 게임을 시작하면 저장된 게임이 바뀌어: %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogo novo substitui o que tens guardado: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogo novo substitui o que você tem salvo: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая игра заменит сохранённую: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新游戏会替换你保存的那局：%@"
          }
        }
      }
    },
    "A plays the shot, or presses the main button of the card on screen. B jumps to where the balls stopped. X turns the Physics Lens on or off. The shoulder buttons step through the explained moments.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزر A يلعب الضربة أو يضغط الزر الرئيسي للبطاقة على الشاشة. الزر B يقفز إلى حيث توقفت الكرات. الزر X يشغّل عدسة الفيزياء أو يطفئها. أزرار الكتف تنتقل بين اللحظات المشروحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A spielt den Stoß oder drückt den Hauptknopf der Karte auf dem Bildschirm. B springt dorthin, wo die Kugeln liegen geblieben sind. X schaltet die Physik-Lens ein oder aus. Die Schultertasten gehen die erklärten Momente durch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A juega el tiro o pulsa el botón principal de la tarjeta en pantalla. B salta a donde se pararon las bolas. X activa o desactiva la Lente de física. Los gatillos superiores recorren los momentos explicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A joue le coup ou appuie sur le bouton principal de la carte à l'écran. B saute là où les billes se sont arrêtées. X active ou désactive la Lentille physique. Les boutons de tranche parcourent les moments expliqués."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A gioca il tiro o preme il pulsante principale della scheda sullo schermo. B salta a dove si sono fermate le palle. X attiva o disattiva la Lens di fisica. I tasti dorsali scorrono i momenti spiegati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aでショット、または画面のカードのメインボタンを押します。Bは球が止まったところへ進みます。Xで物理レンズのオンとオフを切り替えます。ショルダーボタンで解説された瞬間を順に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "A는 샷을 치거나 화면 카드의 주 버튼을 누릅니다. B는 공이 멈춘 곳으로 건너뜁니다. X는 물리 렌즈를 켜고 끕니다. 숄더 버튼으로 설명된 순간을 차례로 넘깁니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A joga a tacada ou carrega no botão principal do cartão no ecrã. B salta para onde as bolas pararam. X liga ou desliga a Lente de Física. Os botões de ombro percorrem os momentos explicados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A dá a tacada ou aperta o botão principal do cartão na tela. B pula para onde as bolas pararam. X liga ou desliga a Lente de Física. Os botões de ombro percorrem os momentos explicados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "A делает удар или нажимает главную кнопку карточки на экране. B переносит туда, где остановились шары. X включает и выключает физическую линзу. Плечевые кнопки листают объяснённые моменты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "A 击球，或按下屏幕上卡片的主按钮。B 跳到球停下的地方。X 打开或关闭物理透镜。肩键在讲解的时刻之间切换。"
          }
        }
      }
    },
    "A pool game that shows its working. Take a shot, then watch the physics behind it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعبة بلياردو تُظهر طريقة عملها. اضرب، ثم شاهد الفيزياء التي تقف وراءها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Billardspiel, das seine Rechnung offenlegt. Stoß ausführen und dann die Physik dahinter beobachten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un juego de billar que muestra cómo funciona. Haz un tiro y luego mira la física que hay detrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jeu de billard qui montre son fonctionnement. Réalise un coup, puis regarde la physique qui se cache derrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gioco di biliardo che mostra come funziona. Fai un tiro, poi guarda la fisica che c'è dietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算の過程まで見せるビリヤードゲーム。ショットを打ったら、その裏の物理を見てみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀이 과정을 보여 주는 당구 게임. 샷을 치고 그 뒤의 물리를 지켜보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogo de bilhar que mostra o seu raciocínio. Dá uma tacada e depois vê a física por trás dela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogo de bilhar que mostra como funciona. Dê uma tacada e depois veja a física por trás dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бильярдная игра, которая показывает, как всё устроено. Сделай удар и посмотри на физику, стоящую за ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一款会展示过程的台球游戏。先击球，再看背后的物理原理。"
          }
        }
      }
    },
    "A pool table that shows its own physics. Learn the shots in six lessons, then play eight-ball or nine-ball against a friend or the computer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طاولة بلياردو تُظهر فيزياءها بنفسها. تعلّم الضربات في ست دروس، ثم العب البلياردو بالكرة 8 أو 9 ضد صديق أو ضد الحاسوب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Billardtisch, der seine eigene Physik zeigt. Lerne die Stöße in sechs Lektionen und spiel dann 8-Ball oder 9-Ball gegen Freunde oder den Computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mesa de billar que muestra su propia física. Aprende los tiros en seis lecciones y luego juega a la bola 8 o a la bola 9 contra un amigo o el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une table de billard qui montre sa propre physique. Apprends les coups en six leçons, puis joue au 8 ou au 9 contre un ami ou l'ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tavolo da biliardo che mostra la sua fisica. Impara i colpi in sei lezioni, poi gioca a palla 8 o palla 9 contro un amico o il computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自らの物理を見せてくれるビリヤード台。6つのレッスンでショットを学び、友だちやコンピュータとエイトボールやナインボールで対戦しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스스로 물리를 보여 주는 당구대. 여섯 개의 레슨으로 샷을 배우고, 친구나 컴퓨터와 에이트볼이나 나인볼을 겨뤄 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mesa de bilhar que mostra a sua própria física. Aprende as tacadas em seis lições e depois joga bola 8 ou bola 9 contra um amigo ou o computador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mesa de sinuca que mostra a própria física. Aprenda as tacadas em seis lições e depois jogue bola 8 ou bola 9 contra um amigo ou o computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бильярдный стол, который показывает свою физику. Освой удары за шесть уроков, а потом сыграй в восьмёрку или девятку с другом или компьютером."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张会展示自身物理的球桌。用六节课学会击球，再和朋友或电脑打八球或九球。"
          }
        }
      }
    },
    "A raised bridge gives the steep cue a jump needs when the cue ball is out of reach. Touching any ball with the bridge is a foul.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجسر المرفوع يعطي العصا الزاوية الحادة التي تحتاجها القفزة حين تكون الكرة البيضاء بعيدة. لمس أي كرة بالجسر خطأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine erhöhte Brücke gibt dem Queue den steilen Winkel, den ein Sprung braucht, wenn die Weiße außer Reichweite ist. Mit der Brücke eine Kugel berühren ist ein Foul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un puente elevado da al taco el ángulo empinado que necesita un salto cuando la blanca está fuera de alcance. Tocar cualquier bola con el puente es falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pont surélevé donne à la queue l'angle raide qu'il faut pour sauter quand la blanche est hors de portée. Toucher une bille avec le pont est une faute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rastrello rialzato dà alla stecca l'angolo ripido che serve per saltare quando la bianca è fuori portata. Toccare una palla col rastrello è fallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高いブリッジなら、手球に手が届かなくてもジャンプに必要な急角度を作れる。ブリッジで球に触れるとファウル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높은 브리지는 큐볼이 손에 닿지 않을 때 점프에 필요한 가파른 각도를 줘요. 브리지로 공을 건드리면 파울이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ponte alta dá ao taco o ângulo inclinado de que um salto precisa quando a branca está fora de alcance. Tocar numa bola com a ponte é falta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ponte alta dá ao taco o ângulo inclinado de que um pulo precisa quando a branca está fora de alcance. Encostar numa bola com a ponte é falta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высокий мостик даёт кию крутой угол для прыжка, когда до битка не дотянуться. Коснуться мостиком любого шара — фол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高架杆能在够不着母球时给出跳球所需的陡角度。架杆碰到任何球都算犯规。"
          }
        }
      }
    },
    "A raised cue drives the cue ball down into the slate, and the slate throws it up. It flies over the 6 and lands beyond it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العصا المرفوعة تدفع الكرة البيضاء نحو اللوح الحجري، فيقذفها اللوح إلى الأعلى. تطير فوق الكرة 6 وتهبط بعدها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gehobene Queue drückt die weiße Kugel in die Schieferplatte, und die Platte wirft sie hoch. Sie fliegt über die 6 und landet dahinter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El taco levantado clava la blanca contra la pizarra, y la pizarra la lanza hacia arriba. Vuela sobre la 6 y cae al otro lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La queue levée enfonce la blanche dans l'ardoise, et l'ardoise la renvoie vers le haut. Elle vole au-dessus de la 6 et retombe derrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stecca alzata spinge la bianca contro l'ardesia, e l'ardesia la lancia in alto. Vola sopra la 6 e atterra oltre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立てたキューが手球をスレートに押しつけ、スレートが手球を跳ね上げます。6番の上を飛び越え、その先に着地します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세운 큐가 큐볼을 슬레이트로 내리누르면 슬레이트가 공을 튀어 올려요. 6번 위를 날아 넘어가 그 너머에 떨어져요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O taco levantado empurra a branca contra a ardósia, e a ardósia atira-a para cima. Voa por cima da 6 e cai do outro lado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O taco levantado empurra a branca contra a ardósia, e a ardósia a lança para cima. Ela voa sobre a 6 e cai do outro lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднятый кий вдавливает белый шар в плиту, и плита подбрасывает его. Он перелетает шар 6 и приземляется за ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬起的球杆把白球压向石板，石板再把它弹起。它飞过6号球，落在后面。"
          }
        }
      }
    },
    "A raised cue drives the cue ball down into the slate. The slate pushes back, the ball leaves the cloth, flies over the 6, bounces and rolls on into the 11.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العصا المرفوعة تدفع الكرة البيضاء إلى الأرض الصلبة. فترتد عنها، فتترك الكرة اللباد وتطير فوق الكرة 6 ثم ترتد وتتدحرج إلى الكرة 11."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein hochgestelltes Queue drückt die Spielkugel in den Schiefer. Der Schiefer drückt zurück, die Kugel verlässt das Tuch, fliegt über die 6, prallt auf und rollt in die 11."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taco levantado empuja la bola blanca contra la pizarra. La pizarra empuja de vuelta, la bola deja el paño, vuela sobre la 6, rebota y sigue rodando hacia la 11."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une queue relevée enfonce la blanche dans l'ardoise. L'ardoise repousse, la bille quitte le tapis, passe au-dessus de la 6, rebondit et roule jusqu'à la 11."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stecca alzata spinge la bianca giù contro l'ardesia. L'ardesia spinge indietro, la palla lascia il panno, vola sopra la 6, rimbalza e rotola fino alla 11."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立てたキューは手球を台の下のスレートに打ち込みます。スレートが押し返し、球はラシャを離れて6番を飛び越え、バウンドして11番へ転がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세운 큐는 흰 공을 바닥의 슬레이트로 내리누릅니다. 슬레이트가 되밀면 공은 천에서 떨어져 6번 위를 날아 넘고, 튀어 올라 11번까지 굴러갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco levantado empurra a branca contra a ardósia. A ardósia empurra de volta, a bola sai do pano, voa por cima da 6, quica e rola até a 11."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco levantado empurra a branca contra a ardósia. A ardósia empurra de volta, a bola sai do pano, voa por cima da 6, quica e rola até a 11."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднятый кий вдавливает биту в плиту. Плита отталкивает её, шар отрывается от сукна, летит над 6, подпрыгивает и катится в 11."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立杆会把母球压向台面底板。底板将其弹回，球离开台呢，飞过6号球，弹跳后滚进11号球。"
          }
        }
      }
    },
    "A raised cue struck off-centre spins the cue ball about a tilted axis. As it slides, the cloth's friction pushes sideways on that spin and the path curves.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عصا مرفوعة تُضرب خارج المركز تُدير الكرة البيضاء حول محور مائل. وأثناء انزلاقها يدفع احتكاك اللباد هذا الدوران جانبًا فينحني المسار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein hochgestelltes Queue, außermittig gestoßen, dreht die Spielkugel um eine geneigte Achse. Während sie gleitet, drückt die Reibung des Tuchs seitlich auf diesen Drall, und die Bahn krümmt sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taco levantado y golpeado descentrado hace girar la bola blanca sobre un eje inclinado. Mientras desliza, la fricción del paño empuja de lado ese giro y la trayectoria se curva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une queue relevée et frappée décentrée fait tourner la blanche autour d'un axe incliné. Pendant qu'elle glisse, le frottement du tapis pousse de côté sur cette rotation et la trajectoire se courbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stecca alzata e colpita fuori centro fa girare la bianca attorno a un asse inclinato. Mentre scivola, l'attrito del panno spinge lateralmente quella rotazione e la traiettoria si curva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを立てて中心を外して打つと、手球は傾いた軸まわりに回転します。滑っている間、ラシャの摩擦がその回転を横へ押し、軌道が曲がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 세우고 중심을 벗어나 치면 흰 공이 기울어진 축을 중심으로 회전합니다. 미끄러지는 동안 천의 마찰이 그 회전을 옆으로 밀어 궤적이 휘어집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco levantado e batido fora do centro faz a branca girar em torno de um eixo inclinado. Enquanto desliza, o atrito do pano empurra de lado esse giro e a trajetória se curva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco levantado e batido fora do centro faz a branca girar em torno de um eixo inclinado. Enquanto desliza, o atrito do pano empurra de lado esse giro e a trajetória se curva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднятый кий, ударенный не по центру, раскручивает биту вокруг наклонной оси. Пока она скользит, трение сукна толкает это вращение в сторону, и путь искривляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立杆并偏离中心击打时，母球会绕一根倾斜的轴旋转。它滑动时，台呢的摩擦把这种旋转推向一侧，轨迹随之弯曲。"
          }
        }
      }
    },
    "A raised cue struck right of centre spins the cue ball on a tilted axis. While it slides, the cloth pushes sideways on that spin and the path bends. Once it rolls, it runs straight.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العصا المرفوعة عند الضرب يمين المركز تدير الكرة البيضاء حول محور مائل. وما دامت تنزلق، يدفع القماش هذا الدوران جانبًا فينحني المسار. وحين تتدحرج، تسير مستقيمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit gehobenem Queue rechts der Mitte getroffen, dreht sich die weiße Kugel um eine schräge Achse. Solange sie rutscht, drückt das Tuch seitlich gegen diesen Drall und die Bahn biegt sich. Sobald sie rollt, läuft sie gerade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el taco levantado y golpeando a la derecha del centro, la blanca gira sobre un eje inclinado. Mientras desliza, el paño empuja de lado ese giro y la trayectoria se curva. En cuanto rueda, va recta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue levée et frappée à droite du centre, la blanche tourne sur un axe incliné. Tant qu'elle glisse, le tapis pousse de côté sur cette rotation et la trajectoire se courbe. Dès qu'elle roule, elle va droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la stecca alzata e colpita a destra del centro, la bianca gira su un asse inclinato. Mentre scivola, il panno spinge di lato su quella rotazione e la traiettoria curva. Appena rotola, va dritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを立てて中心の右を撞くと、手球は傾いた軸で回ります。滑っている間、クロスがその回転を横に押して進路が曲がります。転がり始めるとまっすぐ進みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 세우고 중심 오른쪽을 치면 큐볼이 기울어진 축으로 돌아요. 미끄러지는 동안 천이 그 회전을 옆으로 밀어 길이 휘고, 구르기 시작하면 곧게 가요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o taco levantado e batida à direita do centro, a branca gira num eixo inclinado. Enquanto desliza, o pano empurra de lado esse giro e a trajetória curva. Assim que rola, segue a direito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o taco levantado e batida à direita do centro, a branca gira num eixo inclinado. Enquanto desliza, o pano empurra de lado esse giro e a trajetória faz curva. Assim que rola, segue reta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднятый кий и удар правее центра закручивают белый шар вокруг наклонной оси. Пока он скользит, сукно толкает это вращение вбок, и путь изгибается. Как только он катится, идёт прямо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬杆击打中心右侧，白球绕倾斜的轴旋转。滑动时，台呢从侧面推这个旋转，路线就弯了。一旦滚动，它就走直线。"
          }
        }
      }
    },
    "A rolling cue ball that cuts half of the object ball ends up turned about 30 degrees off its original line.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكرة البيضاء المتدحرجة التي تقطع نصف الكرة المستهدفة تنتهي منحرفة نحو 30 درجة عن خطها الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine rollende weiße Kugel, die die Zielkugel halb anschneidet, weicht am Ende etwa 30 Grad von ihrer ursprünglichen Linie ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bola blanca que rueda y corta media bola objetivo termina desviada unos 30 grados de su línea original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bille blanche qui roule et coupe la moitié de la bille cible finit déviée d'environ 30 degrés de sa ligne d'origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palla bianca che rotola e taglia a metà la palla bersaglio finisce deviata di circa 30 gradi rispetto alla sua linea originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転がる手球が的球の半分をカットすると、元の進路から約30度ずれて進みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구르는 큐볼이 목적구의 절반을 컷하면, 원래 진행 방향에서 약 30도 틀어집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma bola branca a rolar que corta meia bola-alvo acaba desviada cerca de 30 graus da sua linha original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma bola branca rolando que corta meia bola-alvo acaba desviada cerca de 30 graus da linha original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Катящийся белый шар, который срезает половину прицельного шара, уходит примерно на 30 градусов от исходной линии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动的白球以半球切入目标球，最终会偏离原来路线约30度。"
          }
        }
      }
    },
    "A shaky cue: it often misses anything but the easy ones.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عصا مرتجفة: كثيرًا ما تخطئ إلا في الضربات السهلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein zittriges Queue: Es verfehlt oft alles außer den leichten Bällen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taco tembloroso: suele fallar todo menos las fáciles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une queue tremblante : elle rate souvent tout sauf les coups faciles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stecca tremolante: sbaglia spesso tutto tranne i tiri facili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手元が不安定。簡単な球以外はよく外します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔들리는 큐: 쉬운 공 말고는 자주 놓칩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco trémulo: falha muitas vezes tudo menos as fáceis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco trêmulo: erra muitas vezes tudo menos as fáceis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дрожащий кий: часто мажет всё, кроме лёгких шаров."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出杆不稳：除了简单球，经常失手。"
          }
        }
      }
    },
    "A short lesson: watch the shot, then play it yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "درس قصير: شاهد الضربة ثم العبها بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Lektion: Schau dir den Stoß an und spiel ihn dann selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lección corta: mira el tiro y luego juégalo tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une courte leçon : regarde le coup, puis joue-le toi-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una breve lezione: guarda il tiro, poi giocalo tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短いレッスン：ショットを見てから、自分で打ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 레슨: 샷을 본 다음 직접 쳐 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma lição curta: vê a tacada e depois joga-a tu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma lição curta: veja a tacada e depois jogue você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткий урок: посмотри удар, потом сыграй его сам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一节短课：先看这一杆，再自己打。"
          }
        }
      }
    },
    "A small table with rubber bumpers and a cup at each end.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طاولة صغيرة بمصدّات مطاطية وحفرة في كل طرف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleiner Tisch mit Gummipfosten und einem Loch an jedem Ende."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mesa pequeña con topes de goma y un hoyo en cada extremo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite table avec des plots en caoutchouc et un trou à chaque bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tavolo piccolo con respingenti di gomma e una buca a ogni estremità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴムのバンパーが並び、両端にカップがある小さなテーブル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고무 범퍼가 있고 양 끝에 컵이 있는 작은 테이블."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mesa pequena com pinos de borracha e um buraco em cada ponta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mesa pequena com pinos de borracha e um buraco em cada ponta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Небольшой стол с резиновыми столбиками и лункой на каждом конце."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张小球台，有橡胶挡柱，两端各有一个球洞。"
          }
        }
      }
    },
    "A steady club player who makes the open shots.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاعب نادٍ ثابت يُدخل الضربات المكشوفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein solider Vereinsspieler, der die offenen Bälle versenkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jugador de club constante que mete los tiros abiertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un joueur de club régulier qui rentre les coups ouverts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giocatore da circolo costante che imbuca i tiri liberi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安定したクラブプレーヤー。狙いやすい球は確実に入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꾸준한 동호회 실력자로, 열린 샷은 넣습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogador de clube consistente que mete as bolas livres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogador de clube consistente que encaçapa as bolas livres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уверенный клубный игрок, забивает открытые шары."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稳定的俱乐部球手，空档球都能打进。"
          }
        }
      }
    },
    "A steep cue gives the cue ball spin about a tilted axis, and the cloth turns that spin into a curve.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعطي العصا الشديدة الميل الكرة البيضاء لفاً حول محور مائل، ويحوّل اللباد ذلك اللف إلى انحناء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine steile Queue gibt der weißen Kugel Drall um eine geneigte Achse, und das Tuch macht diesen Drall zu einer Kurve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taco muy inclinado da a la bola blanca un giro sobre un eje inclinado, y el paño convierte ese giro en una curva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une queue très inclinée donne à la bille blanche une rotation autour d'un axe incliné, et le tapis transforme cette rotation en courbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stecca inclinata dà alla palla bianca una rotazione su un asse inclinato, e il panno trasforma quella rotazione in una curva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを急角度にすると、手球は傾いた軸を中心に回転し、その回転が布の上でカーブに変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 가파르게 세우면 큐볼은 기울어진 축을 중심으로 돌고, 천이 그 회전을 곡선으로 바꿉니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco muito inclinado dá à bola branca efeito num eixo inclinado, e o pano transforma esse efeito numa curva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taco bem inclinado dá à bola branca efeito num eixo inclinado, e o pano transforma esse efeito numa curva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крутой наклон кия закручивает белый шар вокруг наклонной оси, а сукно превращает это вращение в дугу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陡峭的杆角会让白球绕倾斜的轴旋转，台布会把这种旋转变成弧线。"
          }
        }
      }
    },
    "A stylus strokes like a finger. Where a raised cue is allowed, tilt it up past a writing grip to raise the cue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضرب القلم كما يضرب الإصبع. حيث يُسمح برفع العصا، أمِله أكثر من وضعية الكتابة لترفع العصا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Stift stößt wie ein Finger. Wo ein angehobenes Queue erlaubt ist, kipp ihn steiler als beim Schreiben, um das Queue anzuheben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lápiz golpea como un dedo. Donde se permite levantar el taco, inclínalo más allá de como lo sujetas para escribir y el taco se levanta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un stylet joue comme un doigt. Là où une queue relevée est permise, redresse-le au-delà d'une prise d'écriture pour lever la queue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una penna colpisce come un dito. Dove la stecca alzata è permessa, inclinala oltre l'impugnatura da scrittura per alzare la stecca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンは指と同じように打てます。キューを立てられる場面では、書くときより立てて傾けるとキューが上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펜은 손가락처럼 칩니다. 큐를 세울 수 있는 곳에서는 글씨 쓸 때보다 더 세워 기울이면 큐가 올라갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma caneta joga como um dedo. Onde um taco levantado é permitido, inclina-a para lá da posição de escrita para levantar o taco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma caneta joga como um dedo. Onde o taco levantado é permitido, incline-a além da posição de escrita para levantar o taco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стилус бьёт как палец. Где можно поднять кий, наклони стилус круче, чем держишь при письме, и кий поднимется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控笔和手指一样出杆。在允许抬杆的地方，把笔立得比写字时更高，球杆就会抬起。"
          }
        }
      }
    },
    "A swerve is a gentle bend from a slightly raised cue. It's the easiest curve, and the usual fallback when the kick lanes are bad.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانحناء ميل لطيف من عصا مرفوعة قليلاً. إنه أسهل انحناء، والبديل المعتاد حين تسوء مسارات الارتداد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kurve ist eine sanfte Biegung mit leicht angehobenem Queue. Die einfachste Kurve und der übliche Ausweg, wenn die Vorbänder-Wege schlecht sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una curva suave sale de un taco algo elevado. Es la curva más fácil y el recurso habitual cuando los rebotes no van bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une courbe douce vient d'une queue un peu levée. C'est la courbe la plus facile, et la solution habituelle quand les bricoles sont mauvaises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una curva è una piega dolce con la stecca un po' alzata. È la curva più facile e il ripiego solito quando i rimbalzi non vanno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーブはキューを少し上げて生む緩やかな曲がり。一番簡単なカーブで、キックのラインが悪いときの定番の逃げ道。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커브는 큐를 살짝 들어 만드는 완만한 휨이에요. 가장 쉬운 커브이고, 킥 경로가 나쁠 때 흔히 쓰는 대안이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma curva é uma dobra suave com o taco um pouco levantado. É a curva mais fácil e a saída habitual quando as tabelas não dão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma curva é uma dobra suave com o taco um pouco levantado. É a curva mais fácil e a saída de sempre quando as tabelas não dão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изгиб — мягкая дуга с чуть поднятым кием. Это самый лёгкий вид кривой и обычный выход, когда линии через борт плохие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弧线球是稍抬球杆打出的缓弯，最容易的曲线，也是库边线路不好时的常用后手。"
          }
        }
      }
    },
    "A swerve that runs the length of the table can pocket a ball you can't see. The longer the path, the more the curve depends on the cloth and the speed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانحناء الذي يجري بطول الطاولة يمكن أن يُدخل كرة لا تراها. كلما طال المسار، اعتمد الانحناء أكثر على القماش والسرعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kurve über die ganze Tischlänge kann eine Kugel versenken, die du nicht siehst. Je länger der Weg, desto mehr hängt die Kurve von Tuch und Tempo ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una curva que recorre toda la mesa puede meter una bola que no ves. Cuanto más largo el recorrido, más depende la curva del paño y la velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une courbe qui parcourt toute la table peut rentrer une bille que tu ne vois pas. Plus le trajet est long, plus la courbe dépend du tapis et de la vitesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una curva che percorre tutto il tavolo può imbucare una palla che non vedi. Più è lungo il percorso, più la curva dipende da panno e velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台の端から端まで走るカーブなら、見えない球も落とせる。道のりが長いほど、カーブはクロスとスピード次第。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테이블 끝까지 가는 커브는 안 보이는 공도 넣을 수 있어요. 경로가 길수록 커브는 천과 속도에 더 좌우돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma curva que percorre a mesa toda pode encaçapar uma bola que não vês. Quanto mais longo o caminho, mais a curva depende do pano e da velocidade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma curva que percorre a mesa toda pode encaçapar uma bola que você não vê. Quanto mais longo o caminho, mais a curva depende do pano e da velocidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изгиб через весь стол может забить шар, которого ты не видишь. Чем длиннее путь, тем больше изгиб зависит от сукна и скорости."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跑满全台的弧线球能打进你看不见的球。路线越长，弧线就越依赖台呢和速度。"
          }
        }
      }
    },
    "A trace of side spin: the rebound shifts and the 10 comes off the rail short of the corner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثر بسيط من اللف الجانبي: يتغير الارتداد وتخرج الكرة 10 عن الحافة قبل الزاوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hauch Effet: Der Abprall verschiebt sich, und die 10 löst sich vor der Ecke von der Bande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pizca de efecto: el rebote cambia y la 10 se despega de la banda antes de la esquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un soupçon d'effet : le rebond se décale et la 10 quitte la bande avant le coin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un filo di effetto: il rimbalzo cambia e la 10 si stacca dalla sponda prima dell'angolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほんのわずかなひねり：跳ね返りがずれて、10番がコーナー手前でクッションから離れる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아주 약간의 회전: 반사가 틀어져서 10번이 코너 전에 쿠션에서 떨어져요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pingo de efeito: o ressalto muda e a 10 sai da tabela antes do canto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pingo de efeito: o rebote muda e a 10 sai da tabela antes do canto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Капля винта: отскок смещается, и 10 отходит от борта, не дойдя до угла."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带一丝塞：反弹偏移，10 号球在角袋前离开库边。"
          }
        }
      }
    },
    "About %@ times tighter than a plain straight-in shot.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصعب بنحو %@ مرة من ضربة مستقيمة عادية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %@-mal enger als ein einfacher gerader Stoß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas %@ veces más ajustado que un tiro recto simple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %@ fois plus serré qu'un simple coup droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa %@ volte più stretto di un semplice tiro dritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まっすぐな普通のショットよりおよそ %@ 倍シビア。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평범한 일직선 샷보다 약 %@배 빡빡해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de %@ vezes mais apertado do que uma jogada reta simples."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de %@ vezes mais apertado que uma jogada reta simples."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно в %@ раз точнее простого прямого удара."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比普通直线球严苛约 %@ 倍。"
          }
        }
      }
    },
    "About a firm lag.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحو ضربة قياس قوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa ein kräftiger Lag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más o menos un arrime firme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À peu près un lag appuyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più o meno un acchito deciso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しっかりめのラグくらい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단단한 래그 정도."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais ou menos um lag firme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais ou menos um lag firme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно как уверенный лаг."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大约一记有力的比杆。"
          }
        }
      }
    },
    "Actions: step through the shot, say what happened, zoom in on the cue ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإجراءات: استعراض الضربة خطوة بخطوة، قل ما حدث، تكبير على الكرة البيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktionen: Stoß Schritt für Schritt, sagen, was passiert ist, auf die weiße Kugel zoomen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acciones: recorrer el tiro paso a paso, decir qué pasó, acercar a la bola blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions : parcourir le coup pas à pas, dire ce qui s'est passé, zoomer sur la bille blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azioni: scorri il colpo passo per passo, di' cosa è successo, ingrandisci sulla palla bianca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクション：ショットを順に見る、何が起きたかを読み上げる、手球にズームイン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작: 샷을 단계별로 보기, 무슨 일이 있었는지 읽기, 큐볼 확대."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações: percorrer a tacada passo a passo, dizer o que aconteceu, aproximar à bola branca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações: percorrer a tacada passo a passo, dizer o que aconteceu, aproximar na bola branca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действия: пройти удар по шагам, рассказать, что произошло, приблизить белый шар."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作：逐步查看击球、说出发生了什么、放大白球。"
          }
        }
      }
    },
    "Actual Size": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحجم الفعلي"
          }
        },
        "de": {
