          "stringUnit": {
            "state": "translated",
            "value": "Elevado a unos 44 grados. Toque corto por el centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Levée à environ 44 degrés. Coup court au centre."
          }
        },
        "it": {
