    "This time the cue ball stayed out of the pocket.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المرة لم تدخل الكرة البيضاء الجيب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesmal blieb die weiße Kugel außerhalb der Tasche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vez la bola blanca no entró en la tronera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fois, la bille blanche n'est pas tombée dans la poche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa volta la palla bianca è rimasta fuori dalla buca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回は手球がポケットに入りませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번에는 큐볼이 포켓에 들어가지 않았습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desta vez a bola branca ficou fora da caçapa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desta vez a bola branca ficou fora da caçapa."
          }
        },
        "ru": {
