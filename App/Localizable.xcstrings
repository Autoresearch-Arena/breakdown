    "Orange path: the ball is skidding. It slides over the cloth and its spin has not caught up yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسار البرتقالي: الكرة تنزلق. تنزلق فوق القماش ودورانها لم يلحق بها بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orange Spur: Die Kugel rutscht. Sie gleitet über das Tuch, und ihr Drall hat noch nicht aufgeholt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazo naranja: la bola derrapa. Se desliza sobre el paño y su giro aún no la ha alcanzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace orange : la bille dérape. Elle glisse sur le tapis et sa rotation n'a pas encore suivi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia arancione: la bilia slitta. Scivola sul panno e la sua rotazione non l'ha ancora raggiunta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オレンジの軌跡：球が滑っています。ラシャの上を滑り、回転がまだ追いついていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주황색 경로: 공이 미끄러지고 있습니다. 천 위를 미끄러지며 회전이 아직 따라오지 못했습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasto laranja: a bola derrapa. Desliza sobre o pano e a rotação ainda não a acompanhou."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastro laranja: a bola está derrapando. Ela desliza sobre o pano e o giro ainda não acompanhou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оранжевый след: шар скользит. Он едет по сукну, и вращение ещё не догнало его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "橙色轨迹：球在打滑。它在台呢上滑行，旋转还没跟上。"
          }
        }
      }
    },
    "Other tables, each a game of its own.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طاولات أخرى، لكل منها لعبتها الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Tische, jeder ein eigenes Spiel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otras mesas, cada una un juego distinto."
          }
        },
        "fr": {
          "stringUnit": {
