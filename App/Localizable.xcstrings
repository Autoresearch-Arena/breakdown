    "Aim at the 14 for the foot-right corner straight over the 8.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوّب على الكرة 14 نحو زاوية القدم اليمنى مباشرة فوق الكرة 8."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel auf die 14 in die rechte Fußecke, direkt über die 8."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta a la 14 a la esquina derecha del pie, justo por encima de la 8."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vise la 14 dans le coin droit du pied, droit par-dessus la 8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira la 14 nell'angolo destro di fondo, dritto sopra la 8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8番の真上を越えて、14番をフット右コーナーへ狙う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8번 바로 위로 14번을 풋 오른쪽 코너로 겨누세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponta à 14 para o canto direito do pé, mesmo por cima da 8."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire na 14 para o canto direito do pé, bem por cima da 8."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Целься в 14 в правый нижний угол прямо через 8."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越过 8 号球正上方，瞄 14 号球进脚端右角袋。"
          }
        }
      }
    },
    "Aim at the 15 for the foot-right corner as if the 6 weren't there.": {
