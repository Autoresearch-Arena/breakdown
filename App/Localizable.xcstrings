          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocou a %lld com suavidade para esconder a branca das tuas bolas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocou a %lld de leve para esconder a branca das suas bolas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он мягко сыграл %lld-й, чтобы спрятать биток от твоих шаров."
