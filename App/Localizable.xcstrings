    "Its aim could have been off by %@ degrees either way and still sunk it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان يمكن أن ينحرف تصويبه %@ درجة في أي اتجاه وتدخل الكرة مع ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Zielen hätte um %@ Grad nach jeder Seite abweichen können, und der Ball wäre trotzdem gefallen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su puntería podía desviarse %@ grados hacia cualquier lado y aun así entraba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa visée pouvait dévier de %@ degrés d'un côté ou de l'autre et la bille rentrait quand même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mira poteva sbagliare di %@ gradi da entrambi i lati e la palla entrava lo stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "狙いが左右どちらに %@ 度ずれても入っていました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조준이 어느 쪽으로든 %@도 벗어나도 들어갔을 것입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontaria podia desviar-se %@ graus para qualquer lado e mesmo assim entrava."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mira podia desviar %@ graus para qualquer lado e mesmo assim entrava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
