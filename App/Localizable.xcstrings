    "Off two cushions, hit the 5 first and pot it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الارتداد عن وسادتين، اضرب الكرة 5 أولاً وأدخلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über zwei Banden zuerst die 5 treffen und versenken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras dos bandas, golpea primero la 5 y embóchala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après deux bandes, touche d'abord la 5 et empoche-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo due sponde, colpisci prima la 5 e mettila in buca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二つのクッションを使い、まず5番に当てて落とします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 쿠션에 튕겨서, 먼저 5번을 맞히고 넣으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em duas tabelas, bata primeiro na 5 e encaçape-a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em duas tabelas, bata primeiro na 5 e encaçape."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через два борта: сначала ударьте по 5-му и забейте его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经两条库边反弹，先击中5号球，再把它打进袋。"
          }
        }
      }
    },
