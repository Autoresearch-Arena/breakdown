        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "力度不够。往后拉得更远，才能击得更用力。"
          }
        }
      }
    },
    "Not hard enough to reach the far rail.": {
      "localizations": {
