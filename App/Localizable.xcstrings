    "Each white pin down scores %lld. The red pin scores %lld, or %lld if it is the only pin to fall. The other player's ball hitting the red scores %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل وتد أبيض يسقط يساوي %1$lld. الوتد الأحمر يساوي %2$lld، أو %3$lld إن سقط وحده. وإصابة كرة الخصم للحمراء تساوي %4$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder gefallene weiße Kegel zählt %1$lld. Der rote Kegel zählt %2$lld, oder %3$lld, wenn er als einziger fällt. Trifft die Kugel des Gegners die Rote, zählt das %4$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada bolo blanco derribado vale %1$lld. El bolo rojo vale %2$lld, o %3$lld si es el único que cae. Que la bola del rival toque la roja vale %4$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque quille blanche tombée vaut %1$lld. La quille rouge vaut %2$lld, ou %3$lld si elle est seule à tomber. La bille adverse qui touche la rouge vaut %4$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni birillo bianco abbattuto vale %1$lld. Il birillo rosso vale %2$lld, o %3$lld se è l’unico a cadere. La bilia avversaria che colpisce la rossa vale %4$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白ピン1本で%1$lld点。赤ピンは%2$lld点、赤ピンだけが倒れたら%3$lld点。相手の球が赤球に当たると%4$lld点です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흰 핀 하나당 %1$lld점. 빨간 핀은 %2$lld점이며, 빨간 핀만 쓰러지면 %3$lld점. 상대 공이 빨간 공을 맞히면 %4$lld점입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pino branco derrubado vale %1$lld. O pino vermelho vale %2$lld, ou %3$lld se for o único a cair. A bola do adversário a bater na vermelha vale %4$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pino branco derrubado vale %1$lld. O pino vermelho vale %2$lld, ou %3$lld se for o único a cair. A bola do adversário batendo na vermelha vale %4$lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая сбитая белая кегля — %1$lld. Красная кегля — %2$lld, или %3$lld, если упала только она. Шар соперника, задевший красный, — %4$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每倒一根白柱得%1$lld分。红柱得%2$lld分，如果只倒红柱则得%3$lld分。对方的球碰到红球得%4$lld分。"
          }
        }
      }
    },
