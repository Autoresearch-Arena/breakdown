    "Strike below centre and the cue ball comes back toward you after the pot.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضرب أسفل المركز فتعود الكرة البيضاء نحوك بعد إدخال الكرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Triff unter der Mitte, und die weiße Kugel kommt nach dem Versenken zu dir zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpea por debajo del centro y la blanca vuelve hacia ti tras meter la bola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
