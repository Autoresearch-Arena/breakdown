          }
        }
      }
    },
    "The break goes on with %lld points so far.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستمر السلسلة، وفيها %lld نقطة حتى الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Serie geht weiter, bisher %lld Punkte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tacada sigue con %lld puntos hasta ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La série continue, avec %lld points jusqu’ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La serie continua, con %lld punti finora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレイクは続きます。ここまで%lld点。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속 득점이 이어집니다. 지금까지 %lld점."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A série continua, com %lld pontos até agora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A série continua, com %lld pontos até agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серия продолжается, пока %lld очков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮继续，目前%lld分。"
          }
        }
      }
    },
    "The break is over with %lld points.": {
      "localizations": {
        "ar": {
