    "Not enough height: the cue ball clips the 6, which is a foul.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفاع غير كافٍ: تلمس الكرة البيضاء الكرة 6، وهذا خطأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Höhe: Die Weiße streift die 6, und das ist ein Foul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poca altura: la blanca roza la 6, y eso es falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de hauteur : la blanche frôle la 6, et c'est une faute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza insufficiente: la bianca tocca la 6, ed è fallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高さ不足：手球が6番に当たり、ファウル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높이가 부족해요: 큐볼이 6번에 닿으면 파울이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura insuficiente: a branca toca na 6, e isso é falta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura insuficiente: a branca encosta na 6, e isso é falta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало высоты: биток цепляет 6, а это фол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高度不够：母球擦到 6 号球，这是犯规。"
          }
        }
      }
    },
    "Not enough pace. Pull back further to hit it harder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القوة غير كافية. اسحب للخلف أكثر لتضربها بقوة أكبر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Tempo. Zieh weiter zurück, um fester zu stoßen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta potencia. Tira más hacia atrás para golpear con más fuerza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de puissance. Tire davantage vers l'arrière pour frapper plus fort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poca forza. Tira più indietro per colpire più forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勢いが足りません。もっと引いて、強く打ちましょう。"
