    "%@ drops in at %@ m/s.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يسقط في الجيب بسرعة %@ m/s."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fällt mit %@ m/s ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entra en la tronera a %@ m/s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tombe dans la poche à %@ m/s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entra in buca a %@ m/s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が%@ m/sでポケットに入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)가 %@ m/s로 포켓에 들어갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cai na caçapa a %@ m/s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cai na caçapa a %@ m/s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ падает в лузу на скорости %@ m/s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以 %@ m/s 的速度落袋。"
          }
        }
      }
    },
    "%@ hits the post at %@ m/s and keeps %@ percent of its speed straight into it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ يصطدم بالعمود بسرعة %2$@ m/s ويحتفظ بـ%3$@ في المئة من سرعته متجهاً مباشرةً نحوه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trifft den Pfosten mit %2$@ m/s und behält %3$@ Prozent seines Tempos in Richtung Pfosten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ toca el poste a %2$@ m/s y conserva el %3$@ por ciento de su velocidad en línea recta contra él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ touche le plot à %2$@ m/s et garde %3$@ pour cent de sa vitesse en ligne droite contre lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ colpisce il respingente a %2$@ m/s e mantiene il %3$@ per cento della sua velocità verso di esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@ m/sでポストに当たり、速さの%3$@%を保ったまま真っすぐ跳ね返ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) %2$@ m/s로 기둥에 맞고, 기둥 쪽 속도의 %3$@퍼센트를 유지해."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bate no pino a %2$@ m/s e mantém %3$@ por cento da sua velocidade em linha reta contra ele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bate no pino a %2$@ m/s e mantém %3$@ por cento da sua velocidade em linha reta contra ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ударяется о столбик на скорости %2$@ м/с и сохраняет %3$@ процентов скорости, направленной прямо в него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@以%2$@ m/s撞上挡柱，正对挡柱方向的速度保留%3$@%。"
          }
        }
      }
    },
    "%@ hits the rail at %@ m/s and keeps %@ percent of its speed straight into the rail. Sideways speed is trimmed by friction.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يصطدم بالحافة بسرعة %@ m/s ويحتفظ بـ%@ في المئة من سرعته متجهاً مباشرةً نحو الحافة. ويقلّص الاحتكاكُ السرعةَ الجانبية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trifft die Bande mit %@ m/s und behält %@ Prozent seines Tempos in Richtung Bande. Die seitliche Geschwindigkeit wird durch Reibung gebremst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ toca la banda a %@ m/s y conserva el %@ por ciento de su velocidad en línea recta contra la banda. La fricción reduce la velocidad lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ touche la bande à %@ m/s et garde %@ pour cent de sa vitesse en ligne droite contre la bande. La friction réduit la vitesse latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ colpisce la sponda a %@ m/s e mantiene il %@ per cento della sua velocità verso la sponda. La velocità laterale viene frenata dall'attrito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は%@ m/sでクッションに当たり、速さの%@%を保ったまま真っすぐ跳ね返ります。横方向の速さは摩擦で削られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)가 %@ m/s로 쿠션에 맞고, 속도의 %@%를 유지한 채 곧장 되튑니다. 옆 방향 속도는 마찰로 줄어듭니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bate na tabela a %@ m/s e mantém %@ por cento da velocidade em direção à tabela. A velocidade lateral é reduzida pelo atrito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bate na tabela a %@ m/s e mantém %@ por cento da velocidade em direção à tabela. A velocidade lateral é reduzida pelo atrito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ударяется о борт на скорости %@ m/s и сохраняет %@ процентов скорости в направлении борта. Боковую скорость гасит трение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以 %@ m/s 的速度撞上库边，沿库边方向保留了百分之%@的速度。侧向速度被摩擦力削减。"
          }
        }
      }
    },
    "%@ knocks the pin over at %@ m/s and rolls on at %@ m/s.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ يُسقط الوتد بسرعة %2$@ m/s ويواصل التدحرج بسرعة %3$@ m/s."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wirft den Kegel mit %2$@ m/s um und rollt mit %3$@ m/s weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ derriba el bolo a %2$@ m/s y sigue rodando a %3$@ m/s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ renverse la quille à %2$@ m/s et continue à rouler à %3$@ m/s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ abbatte il birillo a %2$@ m/s e continua a rotolare a %3$@ m/s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@ m/sでピンを倒し、%3$@ m/sで転がり続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) %2$@ m/s로 핀을 쓰러뜨리고 %3$@ m/s로 계속 굴러가."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ derruba o pino a %2$@ m/s e continua a rolar a %3$@ m/s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ derruba o pino a %2$@ m/s e continua rolando a %3$@ m/s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ сбивает кеглю на скорости %2$@ м/с и катится дальше со скоростью %3$@ м/с."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@以%2$@ m/s撞倒小柱，并以%3$@ m/s继续滚动。"
          }
        }
      }
    },
