        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegó deslizándose, casi sin efecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle arrivait en glissant, presque sans rotation."
