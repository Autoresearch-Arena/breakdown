    "Blue path: the ball is rolling. The cloth has matched its spin to its speed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسار الأزرق: الكرة تتدحرج. جعل القماش دورانها مطابقًا لسرعتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blaue Spur: Die Kugel rollt. Das Tuch hat ihren Drall an ihr Tempo angepasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazo azul: la bola rueda. El paño ha igualado su giro a su velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace bleue : la bille roule. Le tapis a accordé sa rotation à sa vitesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia blu: la bilia rotola. Il panno ha accordato la sua rotazione alla sua velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "青い軌跡：球が転がっています。ラシャが回転を速さに合わせました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파란색 경로: 공이 구르고 있습니다. 천이 회전을 속도에 맞췄습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasto azul: a bola rola. O pano igualou a rotação à velocidade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastro azul: a bola está rolando. O pano igualou o giro à velocidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синий след: шар катится. Сукно согласовало его вращение со скоростью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝色轨迹：球在滚动。台呢已让它的旋转与速度一致。"
          }
        }
      }
    },
    "Both tries left the cue ball near the same spot.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المحاولتين توقفت الكرة البيضاء في المكان نفسه تقريبًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
