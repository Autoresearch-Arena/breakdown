    "Move the pointer to see the line, then click or drag on the cloth to set it. Scroll to fine-tune.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّك المؤشر لترى الخط، ثم انقر أو اسحب على القماش لتثبيته. مرّر للضبط الدقيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweg den Zeiger, um die Linie zu sehen, und klick oder zieh dann auf dem Tuch, um sie festzulegen. Scrolle zum Feinjustieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el puntero para ver la línea y luego haz clic o arrastra sobre el paño para fijarla. Desplaza para afinar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace le pointeur pour voir la ligne, puis clique ou fais glisser sur le tapis pour la fixer. Fais défiler pour affiner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muovi il puntatore per vedere la linea, poi fai clic o trascina sul panno per fissarla. Scorri per regolare di fino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタを動かすと線が見えます。ラシャをクリックかドラッグして決めます。スクロールで微調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터를 움직여 선을 본 다음, 천을 클릭하거나 드래그해 정하세요. 스크롤로 미세 조정합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Move o ponteiro para ver a linha e depois clica ou arrasta no pano para a fixar. Desliza para afinar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova o ponteiro para ver a linha e depois clique ou arraste no pano para fixá-la. Role para ajustar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигай указатель, чтобы увидеть линию, потом щёлкни или веди по сукну, чтобы задать её. Прокрутка уточняет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动指针查看瞄准线，再在台呢上点击或拖动来确定。滚动可微调。"
          }
        }
      }
    },
    "Move the tip %@ millimetres left to reach the marked band.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّك الرأس %@ ملم إلى اليسار لتصل إلى النطاق المحدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schieb die Spitze %@ Millimeter nach links, um den markierten Bereich zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve la punta %@ milímetros a la izquierda para llegar a la franja marcada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décale la pointe de %@ millimètres vers la gauche pour atteindre la bande marquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta la punta di %@ millimetri a sinistra per arrivare alla fascia segnata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マークした帯まで、先端をあと%@ミリ左へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 구간까지 팁을 왼쪽으로 %@밀리미터 옮겨요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a ponta %@ milímetros para a esquerda para chegar à faixa marcada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova a ponta %@ milímetros para a esquerda para chegar à faixa marcada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сдвинь точку удара на %@ мм влево, чтобы попасть в отмеченную полосу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将杆头左移%@毫米即可进入标记区。"
          }
        }
      }
    },
