    "The guide shows the first ball you will hit and where both balls head next. Turn it off to judge the angle yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الدليل أول كرة ستضربها وإلى أين تتجه الكرتان بعد ذلك. أوقفه لتحكم على الزاوية بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zielhilfe zeigt die erste Kugel, die du treffen wirst, und wohin beide Kugeln danach laufen. Schalte sie aus, um den Winkel selbst einzuschätzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La guía muestra la primera bola que tocarás y hacia dónde van ambas después. Desactívala para juzgar el ángulo tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le guide montre la première bille que tu toucheras et où vont ensuite les deux billes. Désactive-le pour juger l'angle toi-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La guida mostra la prima palla che colpirai e dove vanno entrambe dopo. Spegnila per valutare l'angolo da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイドは、最初に当たる球と、その後両方の球がどこへ向かうかを示します。オフにすると、角度は自分で判断できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드는 처음 맞힐 공과 그 뒤 두 공이 어디로 가는지 보여 줍니다. 끄면 각도는 직접 판단할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A guia mostra a primeira bola que você vai atingir e para onde as duas bolas seguem depois. Desligue-a para avaliar o ângulo por si."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A guia mostra a primeira bola que você vai atingir e para onde as duas bolas seguem depois. Desligue para avaliar o ângulo por conta própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направляющая показывает первый шар, в который вы попадёте, и куда дальше пойдут оба шара. Выключите её, чтобы самостоятельно оценить угол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助线显示你将击中的第一个球，以及两球接下来的走向。关闭它，你就可以自己判断角度。"
          }
        }
      }
    },
