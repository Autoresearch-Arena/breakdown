        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "힘이 부족해요. 더 뒤로 당겨서 세게 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta força. Puxa mais para trás para bater mais forte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta força. Puxe mais para trás para bater mais forte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хватает силы. Оттяни дальше, чтобы ударить сильнее."
