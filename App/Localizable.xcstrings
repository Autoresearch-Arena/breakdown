    "Puts the balls back and opens the aiming controls": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد الكرات إلى مكانها ويفتح أدوات التصويب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Kugeln zurück und öffnet die Zielsteuerung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devuelve las bolas a su sitio y abre los controles de puntería"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet les billes en place et ouvre les commandes de visée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimette a posto le palle e apre i controlli di mira"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "球を元に戻し、狙いの操作を開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공을 제자리에 되돌리고 조준 컨트롤을 엽니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repõe as bolas e abre os controlos de pontaria"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoloca as bolas e abre os controles de mira"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает шары на место и открывает управление прицелом"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把球放回原位并打开瞄准控制"
          }
        }
      }
    },
    "Puts the balls back where the shot started, with your last aim, power and spin": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد الكرات إلى حيث بدأت الضربة، مع تصويبك وقوتك ودورانك الأخيرة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Kugeln dorthin zurück, wo der Stoß begann, mit deinem letzten Ziel, deiner Kraft und deinem Effet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devuelve las bolas a donde empezó el tiro, con tu última puntería, potencia y efecto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet les billes là où le coup a commencé, avec ta dernière visée, ta puissance et ton effet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimette le palle dove è iniziato il colpo, con la tua ultima mira, potenza ed effetto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショットの開始位置に球を戻し、前回の狙い・強さ・回転を引き継ぎます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샷이 시작된 자리로 공을 되돌리고, 마지막 조준·힘·회전을 유지합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repõe as bolas onde a jogada começou, com a tua última pontaria, força e efeito"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoloca as bolas onde a tacada começou, com a sua última mira, força e efeito"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает шары туда, где начался удар, с твоим прошлым прицелом, силой и вращением"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把球放回这一杆开始的位置，保留你上次的瞄准、力度和旋转"
          }
        }
      }
    },
    "Puts the balls back where your last shot started, with the same aim, power and spin": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد الكرات إلى أماكنها عند بداية ضربتك الأخيرة، بنفس التصويب والقوة واللف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Kugeln dorthin zurück, wo dein letzter Stoß begann, mit gleicher Zielrichtung, Kraft und Drall"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a poner las bolas donde empezó tu último tiro, con la misma puntería, potencia y efecto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet les billes là où ton dernier coup avait commencé, avec la même visée, la même puissance et le même effet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimette le palle dove era iniziato il tuo ultimo tiro, con la stessa mira, potenza ed effetto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のショットを始めた位置に球を戻し、狙い・強さ・回転もそのままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 샷을 시작한 위치로 공을 되돌리고, 조준, 세기, 회전은 그대로 둡니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca as bolas de volta onde começou a tua última tacada, com a mesma mira, força e efeito"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca as bolas de volta onde começou sua última tacada, com a mesma mira, força e efeito"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает шары туда, где начался твой прошлый удар, с тем же прицелом, силой и вращением"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把球放回你上一次击球的起始位置，瞄准、力度和旋转都保持不变"
          }
        }
      }
    },
    "Raise the cue almost straight up and the cue ball bends around a ball in its way.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع العصا تقريباً إلى الأعلى عمودياً، فتنحني الكرة البيضاء حول كرة تعترض طريقها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb die Queue fast senkrecht, und die weiße Kugel biegt um eine Kugel auf ihrem Weg herum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta el taco casi en vertical y la bola blanca se curva alrededor de una bola que le estorba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève la queue presque à la verticale et la bille blanche contourne une bille qui se trouve sur sa route."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza la stecca quasi in verticale e la palla bianca gira intorno a una palla che le sta davanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューをほぼ真上に立てると、手球は進路にある球を避けて曲がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 거의 수직으로 세우면, 큐볼이 앞을 막는 공을 돌아서 휘어 갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta o taco quase na vertical e a bola branca faz uma curva à volta de uma bola que esteja no caminho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante o taco quase na vertical e a bola branca faz uma curva ao redor de uma bola que esteja no caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подними кий почти вертикально, и белый шар обогнёт шар, мешающий на пути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把球杆几乎竖直抬起，白球就会绕过挡路的球弯曲前进。"
          }
        }
      }
    },
