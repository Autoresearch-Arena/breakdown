    "Balls plough a furrow: a roll dies within a second or two, and jumps sink in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحفر الكرات أخدودًا: يخمد التدحرج خلال ثانية أو ثانيتين، وتغوص القفزات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kugeln ziehen eine Furche: Ein Rollen erstirbt binnen ein, zwei Sekunden, und Sprünge sinken ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las bolas abren un surco: una rodada se apaga en uno o dos segundos, y los saltos se hunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les billes creusent un sillon : un roulement s'éteint en une ou deux secondes, et les sauts s'enfoncent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le palle scavano un solco: una rotolata si spegne in un secondo o due, e i salti sprofondano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "球が溝を掘るように進みます。転がりは一、二秒で止まり、ジャンプした球はめり込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공이 고랑을 파며 나아갑니다: 구름은 1~2초 안에 멈추고, 점프한 공은 파묻힙니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As bolas abrem um sulco: um rolamento morre em um ou dois segundos, e os saltos afundam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As bolas abrem um sulco: uma rolagem morre em um ou dois segundos, e os saltos afundam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шары пропахивают борозду: качение затухает за секунду-другую, а прыжки увязают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "球会犁出一道沟：滚动一两秒内就停下，跳球会陷进去。"
          }
        }
      }
    },
    "Bank the 5 off the far cushion into the marked side pocket.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتدّ الكرة 5 عن الوسادة البعيدة إلى الجيب الجانبي المحدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel die 5 über die gegenüberliegende Bande in die markierte Seitentasche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz rebotar la 5 en la banda del fondo hasta la tronera lateral marcada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais rebondir la 5 sur la bande du fond jusque dans la poche latérale indiquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai sponda con la 5 sulla sponda opposta nella buca laterale segnata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "奥のクッションから5番をバンクさせ、示されたサイドポケットに入れましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반대편 쿠션에서 5번을 튕겨, 표시된 사이드 포켓에 넣으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaçapa a 5 pela tabela do fundo na caçapa lateral marcada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaçape a 5 pela tabela do fundo na caçapa lateral marcada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отыграй 5-й от дальнего борта в нужную боковую лузу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让5号球从远端库边翻入指定的边袋。"
          }
        }
      }
    },
    "Bent it round.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انحنت حولها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Ecke gebogen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curvada alrededor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courbée autour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piegata intorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぐるりと曲げた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휘어서 돌아갔어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobraste à volta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fez a curva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загнул дугой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕着弯过去了。"
          }
        }
      }
    },
    "Bent it round. That is a massé.": {
      "localizations": {
        "ar": {
