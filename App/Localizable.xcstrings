          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它几乎没有旋转，滑着撞过来。"
          }
        }
      }
    },
    "It came in with backspin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت بدوران خلفي."
          }
        },
        "de": {
