          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백스핀을 품고 들어왔습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegou com efeito de recuo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegou com efeito de recuo."
          }
        },
        "ru": {
