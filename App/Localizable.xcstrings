    "Cyan path: the ball is rolling. The cloth has matched its spin to its speed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسار السماوي: الكرة تتدحرج. جعل الجوخ دورانها متوافقاً مع سرعتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyanfarbene Spur: Die Kugel rollt. Das Tuch hat ihren Drall an ihr Tempo angepasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazo cian: la bola rueda. El paño ha igualado su giro con su velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace cyan : la bille roule. Le tapis a accordé sa rotation à sa vitesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia ciano: la palla rotola. Il panno ha accordato la sua rotazione alla sua velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シアンの軌跡：球は転がっています。ラシャが回転を速さに合わせました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "청록색 경로: 공이 구르고 있어요. 천이 회전을 속도에 맞췄어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasto ciano: a bola rola. O pano igualou a rotação à velocidade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastro ciano: a bola está rolando. O pano igualou o giro à velocidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голубой след: шар катится. Сукно подогнало его вращение под скорость."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "青色轨迹：球在滚动。台呢已让它的旋转与速度一致。"
          }
        }
      }
    },
