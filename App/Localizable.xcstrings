            "value": "Sie kam %@ neben der Queuelinie zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volvió a %@ de la línea del taco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est revenue à %@ de la ligne de queue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È tornata a %@ dalla linea della stecca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューのラインから%@ずれて戻った。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐 라인에서 %@ 벗어나 돌아왔어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltou a %@ da linha do taco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltou a %@ da linha do taco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шар вернулся в %@ от линии кия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回来时偏离球杆线 %@。"
          }
        }
      }
    },
    "It came in rolling.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت متدحرجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kam rollend an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegó rodando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle arrivait en roulant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È arrivata rotolando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転がりながら入ってきました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구르며 들어왔습니다."
          }
        },
        "pt": {
