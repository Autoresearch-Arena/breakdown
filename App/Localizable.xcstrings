            "value": "右上を撞く：右ひねりのフォロー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위를 치세요: 오른쪽 회전을 섞은 밀어치기."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
