    "Not enough %@ side. Strike further to the %@ of the cue ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللف الجانبي %@ غير كافٍ. اضرب أبعد نحو الجانب %@ من الكرة البيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Seitendrall nach %@. Triff die weiße Kugel weiter %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta efecto a la %@. Golpea más hacia la %@ de la bola blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez d'effet à %@. Frappe plus vers la %@ de la bille blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco effetto laterale a %@. Colpisci più lontano, a %@ della palla bianca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の横回転が足りません。手球の%@寄りを、もっと打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 옆회전이 부족해요. 큐볼의 %@ 쪽을 더 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta efeito lateral %@. Bate mais para o lado %@ da bola branca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta efeito lateral %@. Bata mais para o lado %@ da bola branca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно %@ бокового вращения. Бей дальше к %@ стороне белого шара."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@侧旋不够。击打位置再偏向白球的%@侧一些。"
          }
        }
      }
    },
    "Not enough draw. Strike lower on the cue ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السحب غير كافٍ. اضرب أسفل الكرة البيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Rückzug. Triff die weiße Kugel weiter unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta retroceso. Golpea más abajo en la bola blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de rétro. Frappe plus bas sur la bille blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo poco indietro. Colpisci la palla bianca più in basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き玉が足りません。手球のもっと下を打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드로우가 부족해요. 큐볼의 아래쪽을 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta recuo. Bate mais abaixo na bola branca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta recuo. Bata mais abaixo na bola branca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно оттяжки. Бей по белому шару ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低杆不够。击打白球再偏下一些。"
          }
        }
      }
    },
    "Not enough follow. Strike higher on the cue ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدفع غير كافٍ. اضرب أعلى الكرة البيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Nachlauf. Triff die weiße Kugel weiter oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta efecto de avance. Golpea más arriba en la bola blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez d'effet avant. Frappe plus haut sur la bille blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo poco avanti. Colpisci la palla bianca più in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送り玉が足りません。手球のもっと上を打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로우가 부족해요. 큐볼의 위쪽을 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta avanço. Bate mais acima na bola branca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta avanço. Bata mais acima na bola branca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно наката. Бей по белому шару выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高杆不够。击打白球再偏上一些。"
          }
        }
      }
    },
    "Not enough height: the cue ball clips the 6, which is a foul.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفاع غير كافٍ: تلمس الكرة البيضاء الكرة 6، وهذا خطأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Höhe: Die Weiße streift die 6, und das ist ein Foul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poca altura: la blanca roza la 6, y eso es falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de hauteur : la blanche frôle la 6, et c'est une faute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza insufficiente: la bianca tocca la 6, ed è fallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高さ不足：手球が6番に当たり、ファウル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높이가 부족해요: 큐볼이 6번에 닿으면 파울이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura insuficiente: a branca toca na 6, e isso é falta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura insuficiente: a branca encosta na 6, e isso é falta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало высоты: биток цепляет 6, а это фол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高度不够：母球擦到 6 号球，这是犯规。"
          }
        }
      }
    },
    "Not enough pace. Pull back further to hit it harder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القوة غير كافية. اسحب للخلف أكثر لتضربها بقوة أكبر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Tempo. Zieh weiter zurück, um fester zu stoßen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta potencia. Tira más hacia atrás para golpear con más fuerza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de puissance. Tire davantage vers l'arrière pour frapper plus fort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poca forza. Tira più indietro per colpire più forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勢いが足りません。もっと引いて、強く打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "힘이 부족해요. 더 뒤로 당겨서 세게 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta força. Puxa mais para trás para bater mais forte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta força. Puxe mais para trás para bater mais forte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хватает силы. Оттяни дальше, чтобы ударить сильнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "力度不够。往后拉得更远，才能击得更用力。"
          }
        }
      }
    },
    "Not quite the line. Aim %@ %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس الخط الصحيح تماماً. صوّب %@ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht ganz die richtige Linie. Ziele %@ %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es la línea exacta. Apunta %@ hacia la %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas tout à fait la bonne ligne. Vise %@ à %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è proprio la linea giusta. Mira %@ a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "狙いの線がわずかにずれています。%@%@を狙いましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라인이 살짝 어긋났어요. %@ %@ 조준하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é bem a linha certa. Mira %@ %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é bem a linha certa. Mire %@ %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Линия немного не та. Целься %@ %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向差了一点。瞄准时%@%@一些。"
          }
        }
      }
    },
    "Not the 8 yet. Clear your own balls first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس دور الكرة 8 بعد. أدخل كراتك أولاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht die 8. Räum zuerst deine eigenen Kugeln ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no toca la 8. Primero mete tus bolas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore la 8. Rentre d'abord tes billes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora la 8. Prima metti in buca le tue palle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ8番じゃない。先に自分の球を片付けよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 8번이 아니에요. 먼저 네 공부터 정리하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não é a 8. Encaçapa primeiro as tuas bolas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não é a 8. Encaçape primeiro as suas bolas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё не 8. Сначала забей свои шары."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没轮到 8 号球。先清完你自己的球。"
          }
        }
      }
    },
    "Now look at what the table is doing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن انظر إلى ما تفعله الطاولة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau dir jetzt an, was der Tisch macht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mira lo que hace la mesa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde maintenant ce que fait la table"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora guarda cosa fa il tavolo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "では、テーブルで何が起きているか見てみましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 테이블에서 무슨 일이 일어나는지 보세요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora vê o que a mesa está a fazer"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora veja o que a mesa está fazendo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь посмотри, что происходит на столе"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在看看球桌上发生了什么"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끔"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关"
          }
        }
      }
    },
    "Off the far cushion and home. The mirror never lies.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الوسادة البعيدة إلى الجيب. المرآة لا تكذب أبداً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über die gegenüberliegende Bande und rein. Der Spiegel lügt nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde la banda del fondo y dentro. El espejo nunca miente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par la bande du fond et au but. Le miroir ne ment jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalla sponda opposta e in buca. Lo specchio non mente mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "奥のクッションを経て、ポケットへ。鏡はうそをつきません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반대편 쿠션을 거쳐 포켓으로. 거울은 거짓말을 하지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pela tabela do fundo e para dentro. O espelho nunca mente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pela tabela do fundo e pra dentro. O espelho nunca mente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От дальнего борта и в лузу. Зеркало не врёт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经远端库边入袋。镜子从不说谎。"
          }
        }
      }
    },
    "Off the jaw": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من فك الجيب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Taschenwange abgeprallt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebote en el borde de la tronera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebond sur le bord de la poche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimbalzata dalla ganascia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縁に当たって"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턱에 맞고"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na borda da caçapa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na borda da caçapa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От края лузы"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "碰袋唇后弹出"
          }
        }
      }
    },
    "Off the left rail at the first diamond past the side pocket, then the foot rail just left of the middle, and along it into the 1, which runs into the foot-right corner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عن الحافة اليسرى عند الماسة الأولى بعد الجيب الجانبي، ثم حافة القدم يسار الوسطى بقليل، وعلى طولها إلى الكرة 1 التي تجري إلى زاوية القدم اليمنى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der linken Bande am ersten Diamanten hinter der Mitteltasche, dann die Fußbande knapp links der Mitte und an ihr entlang in die 1, die in die rechte Fußecke läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por la banda izquierda en el primer diamante pasada la lateral, luego la banda del pie justo a la izquierda del centro, y por ella hasta la 1, que corre a la esquina derecha del pie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par la bande gauche à la première mouche après la poche du milieu, puis la bande du pied juste à gauche du milieu, et le long de celle-ci dans la 1, qui file dans le coin droit du pied."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalla sponda sinistra al primo diamante dopo la centrale, poi la sponda di fondo appena a sinistra del centro, e lungo questa sulla 1, che corre nell'angolo destro di fondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左クッションのサイドポケットの先の1つ目のポイントから、フットクッションの中央すぐ左、それに沿って1番へ。1番はフット右コーナーへ転がる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 쿠션 사이드 포켓 다음 첫 번째 포인트에서, 풋 쿠션 가운데 바로 왼쪽, 그걸 따라 1번으로. 1번은 풋 오른쪽 코너로 굴러가요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pela tabela esquerda no primeiro diamante depois da lateral, depois a tabela do pé logo à esquerda do meio, e ao longo dela até à 1, que corre para o canto direito do pé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pela tabela esquerda no primeiro diamante depois da lateral, depois a tabela do pé logo à esquerda do meio, e rente a ela até a 1, que corre para o canto direito do pé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От левого борта у первой метки за средней лузой, затем нижний борт чуть левее центра и вдоль него в 1, которая катится в правый нижний угол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左库中袋后第一个星点，再到脚库中间稍偏左处，沿脚库打到 1 号球，1 号球滚进脚端右角袋。"
          }
        }
      }
    },
    "Off two cushions, hit the 5 first and pot it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الارتداد عن وسادتين، اضرب الكرة 5 أولاً وأدخلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über zwei Banden zuerst die 5 treffen und versenken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras dos bandas, golpea primero la 5 y embóchala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après deux bandes, touche d'abord la 5 et empoche-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo due sponde, colpisci prima la 5 e mettila in buca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二つのクッションを使い、まず5番に当てて落とします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 쿠션에 튕겨서, 먼저 5번을 맞히고 넣으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em duas tabelas, bate primeiro na 5 e encaçapa-a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em duas tabelas, bata primeiro na 5 e encaçape."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через два борта: сначала ударь по 5-му и забей его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经两条库边反弹，先击中5号球，再把它打进袋。"
          }
        }
      }
    },
    "Old, dirty, napped felt on a bar table: it grabs the ball, so draw dies early, it is slow, so you hit harder, and the cushions are dead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لباد قديم ومتسخ وزغبي على طاولة حانة: يمسك الكرة فيتلاشى الارتداد مبكرًا، وبطيء فتضرب بقوة أكبر، والوسائد ميتة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alter, schmutziger, flauschiger Filz auf einem Kneipentisch: Er greift die Kugel, also stirbt der Rückläufer früh, er ist langsam, also stößt du härter, und die Banden sind tot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fieltro viejo, sucio y con pelusa en una mesa de bar: agarra la bola, así que el retroceso muere pronto; es lento, así que tiras más fuerte; y las bandas están muertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieux feutre sale et pelucheux sur une table de bar : il accroche la bille, donc le rétro meurt tôt ; il est lent, donc tu tapes plus fort ; et les bandes sont mortes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Feltro vecchio, sporco e peloso su un tavolo da bar: trattiene la bilia, quindi il colpo indietro muore presto; è lento, quindi tiri più forte; e le sponde sono morte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーの台に張られた古くて汚れた毛羽立ちフェルト。ボールをつかむのでドローが早く消え、遅いので強く撞く必要があり、クッションは死んでいる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "술집 당구대의 낡고 더럽고 보풀이 일어난 펠트: 공을 붙잡아 드로우가 일찍 죽고, 느려서 더 세게 쳐야 하며, 쿠션은 죽어 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feltro velho, sujo e com pelo numa mesa de bar: agarra a bola, por isso o retrocesso morre cedo; é lento, por isso bates com mais força; e as tabelas estão mortas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feltro velho, sujo e felpudo numa mesa de bar: segura a bola, então a puxada morre cedo; é lento, então você bate mais forte; e as tabelas estão mortas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старое, грязное, ворсистое сукно на барном столе: оно цепляет шар, поэтому оттяжка быстро гаснет; оно медленное, поэтому бить надо сильнее; а борта мёртвые."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "酒吧球台上又旧又脏、起毛的台呢：会抓球，缩杆很快就没了；速度慢，得打得更重；库边也没弹性。"
          }
        }
      }
    },
    "On": {
