    "Plays an escape. Your style here is then capped at 2.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض طريقة خروج. بعدها يصبح أسلوبك هنا محدوداً بـ 2."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt einen Ausweg ab. Danach ist dein Stil hier auf 2 begrenzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una salida. Después tu estilo aquí queda limitado a 2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue une sortie. Ensuite ton style ici est plafonné à 2."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una via d'uscita. Dopo, il tuo stile qui vale al massimo 2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "抜け出し方を再生する。その後ここでのスタイル点は2点まで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탈출 방법을 보여줘요. 그 뒤로 여기서 스타일은 최대 2점이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra uma saída. Depois o teu estilo aqui fica limitado a 2."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra uma saída. Depois seu estilo aqui fica limitado a 2."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает выход. После этого стиль здесь не выше 2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放一种解法。之后你在这里的风格分最多 2 分。"
          }
        }
      }
    },
