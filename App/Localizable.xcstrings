    "Close to the edge of what works: one off difficulty, and no style.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قريبة من حدود ما ينجح: نقطة أقل في الصعوبة، ولا أسلوب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapp an der Grenze dessen, was klappt: einer weniger für Schwierigkeit, kein Stil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al límite de lo que funciona: uno menos de dificultad y nada de estilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la limite de ce qui marche : un de moins en difficulté, et pas de style."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al limite di ciò che funziona: uno in meno di difficoltà e niente stile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいくぎりぎり：難しさは1点減、スタイル点なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "될락 말락 한 수준이에요: 난이도 1점 감점, 스타일 점수 없음."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo no limite do que resulta: menos um de dificuldade e sem estilo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem no limite do que funciona: menos um de dificuldade e sem estilo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На самой грани того, что работает: минус один за сложность и без стиля."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勉强可行：难度减 1 分，没有风格分。"
          }
        }
      }
    },
