            "value": "O efeito lateral desvia a bola branca"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Боковой винт уводит биток с линии"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧旋把母球推离瞄准线"
          }
        }
      }
    },
    "Silver": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فضية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Silber"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plata"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Argent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Argento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シルバー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실버"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серебро"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银牌"
          }
        }
      }
    },
    "Sink any ball on a fair shot and you shoot again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل أي كرة بضربة صحيحة وتضرب مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versenkst du bei einem fairen Stoß irgendeine Kugel, stößt du noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mete cualquier bola en un tiro válido y vuelves a tirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empoche n'importe quelle bille sur un coup valable et tu rejoues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbuca una bilia qualsiasi con un colpo valido e tiri di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正しいショットでどれかの球を沈めれば、もう一度打てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정당한 샷으로 아무 공이나 넣으면 다시 칩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta qualquer bola numa tacada válida e volta a jogar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaçape qualquer bola numa tacada válida e jogue de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забиваешь любой шар честным ударом — бьёшь снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合法击球打进任何一颗球，就继续击球。"
          }
        }
      }
    },
    "Sink one of your own balls in your cup and you shoot again. Otherwise the turn passes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل إحدى كراتك في حفرتك فتلعب مرة أخرى، وإلا ينتقل الدور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versenkst du eine eigene Kugel in deinem Loch, bist du wieder dran. Sonst ist der andere am Zug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si metes una de tus bolas en tu copa, vuelves a tirar. Si no, pasa el turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentre une de tes billes dans ton trou et tu rejoues. Sinon, la main passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se imbuchi una tua bilia nella tua buca, tiri ancora. Altrimenti il turno passa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の球を自分の穴に沈めれば、もう一度突けます。そうでなければ交代です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 공을 내 구멍에 넣으면 한 번 더 칩니다. 아니면 차례가 넘어갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mete uma das tuas bolas no teu buraco e jogas outra vez. Se não, passa a vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaçape uma das suas bolas no seu buraco e jogue de novo. Senão, passa a vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загоняешь свой шар в свою лузу — бьёшь снова. Иначе ход переходит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把自己的球打进自己的洞就再打一杆，否则换人。"
          }
        }
      }
    },
    "Sink the 8 in the pocket you called once your group is gone and you win. Sink it early, in the wrong pocket, off the table, or on a foul, and you lose.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الكرة 8 في الجيب الذي سمّيته بعد أن تنتهي مجموعتك وتفوز. أدخلها مبكرًا، أو في الجيب الخطأ، أو أخرجها من الطاولة، أو مع خطأ، فتخسر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versenk die 8 in der angesagten Tasche, wenn deine Gruppe weg ist, und du gewinnst. Versenkst du sie zu früh, in der falschen Tasche, vom Tisch oder mit einem Foul, verlierst du."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mete la 8 en la tronera cantada cuando tu grupo ya no esté y ganas. Si la metes antes de tiempo, en otra tronera, la sacas de la mesa o la metes con falta, pierdes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empoche la 8 dans la poche annoncée une fois ton groupe parti et tu gagnes. Empoche-la trop tôt, dans la mauvaise poche, hors de la table ou sur une faute, et tu perds."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbuca la 8 nella buca chiamata quando il tuo gruppo è finito e vinci. Imbucala troppo presto, nella buca sbagliata, fuori dal tavolo o con un fallo, e perdi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のグループがなくなった後、コールしたポケットに8番を沈めれば勝ち。早すぎる、違うポケット、台の外、ファウルと同時なら負けです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 그룹을 다 넣은 뒤 콜한 포켓에 8번을 넣으면 승리합니다. 너무 일찍, 다른 포켓에, 테이블 밖으로, 또는 파울과 함께 넣으면 패배합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta a 8 no buraco anunciado depois de acabar o seu grupo e ganha. Meta-a cedo demais, no buraco errado, fora da mesa ou com falta, e perde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaçape a 8 na caçapa cantada depois que seu grupo acabar e você vence. Encaçape cedo demais, na caçapa errada, para fora da mesa ou com falta, e você perde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забей восьмёрку в заказанную лузу, когда твоя группа закончилась, — и победа твоя. Забьёшь раньше, не в ту лузу, выбьешь со стола или с фолом — проигрыш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自己的球组打完后，把 8 号球打进所报袋口就赢。提前打进、打进错袋、打出台面或犯规时打进，就输。"
          }
        }
      }
    },
    "Sink the ball you called and you shoot again. Miss it, or foul, and the turn passes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الكرة التي سمّيتها وتضرب مرة أخرى. إن أخطأتها أو ارتكبت خطأ، ينتقل الدور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versenkst du die angesagte Kugel, stößt du noch einmal. Verfehlst du sie oder foulst, ist der andere dran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mete la bola que cantaste y vuelves a tirar. Si fallas o haces falta, pasa el turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empoche la bille annoncée et tu rejoues. Rate-la, ou fais une faute, et la main passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbuca la bilia chiamata e tiri di nuovo. Se sbagli o fai fallo, il turno passa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コールした球を沈めればもう一度打てます。外すかファウルすると手番が移ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콜한 공을 넣으면 다시 칩니다. 놓치거나 파울하면 차례가 넘어갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta a bola anunciada e volta a jogar. Se falhar, ou fizer falta, a vez passa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaçape a bola cantada e jogue de novo. Se errar, ou fizer falta, a vez passa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забиваешь заказанный шар — бьёшь снова. Промах или фол — ход переходит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打进你报的球就继续击球。没打进或犯规，就换人。"
          }
        }
      }
    },
    "Sinking the 8 on the break neither wins nor loses. After a clean break the breaker chooses: put the 8 back on its spot, or rack again. If the break was also a foul, your opponent chooses instead, with the cue ball in hand.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدخال الكرة 8 في الكسرة لا يعني فوزًا ولا خسارة. بعد كسرة نظيفة يختار من كسر: إعادة الكرة 8 إلى نقطتها، أو إعادة الرصّ. وإن كانت الكسرة خطأً أيضًا، يختار خصمك بدلًا منه، والكرة في يده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 8 beim Anstoß zu versenken ist weder Sieg noch Niederlage. Nach einem sauberen Anstoß wählt, wer angestoßen hat: die 8 zurück auf ihren Punkt oder neu aufbauen. War der Anstoß auch ein Foul, wählt stattdessen dein Gegner, mit Ball in der Hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meter la 8 en el saque ni gana ni pierde. Tras un saque limpio, quien sacó elige: devolver la 8 a su punto o volver a colocar las bolas. Si además el saque fue falta, elige tu rival, con bola en mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empocher la 8 à la casse ne fait ni gagner ni perdre. Après une casse sans faute, celui qui a cassé choisit : remettre la 8 sur sa mouche, ou refaire le triangle. Si la casse était aussi une faute, c’est ton adversaire qui choisit, avec bille en main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbucare la 8 in spaccata non fa né vincere né perdere. Dopo una spaccata pulita sceglie chi ha spaccato: rimettere la 8 sul suo punto o ricomporre il triangolo. Se la spaccata era anche fallo, sceglie invece il tuo avversario, con bilia in mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレイクで8番を沈めても勝ちでも負けでもない。ファウルのないブレイクなら、ブレイクした人が8番をスポットに戻すか並べ直すかを選ぶ。ブレイクがファウルでもあったなら、代わりに相手がボールインハンドで選ぶ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브레이크에서 8번을 넣으면 승리도 패배도 아니야. 파울 없는 브레이크라면 브레이크한 사람이 8번을 제자리에 놓을지 다시 랙을 놓을지 골라. 브레이크가 파울이기도 했다면 대신 상대가 볼 인 핸드로 골라."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meter a 8 na abertura não ganha nem perde. Depois de uma abertura limpa, quem abriu escolhe: repor a 8 no seu ponto ou arrumar de novo. Se a abertura também foi falta, escolhe o teu adversário, com bola na mão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaçapar a 8 na abertura não ganha nem perde. Depois de uma abertura limpa, quem abriu escolhe: recolocar a 8 no ponto ou arrumar de novo. Se a abertura também foi falta, quem escolhe é o seu adversário, com bola na mão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восьмёрка, забитая на разбое, не приносит ни победы, ни поражения. После чистого разбоя выбирает разбивавший: вернуть восьмёрку на её точку или расставить заново. Если на разбое был ещё и фол, выбирает соперник, и биток у него с руки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开球打进 8 号球既不算赢也不算输。开球没有犯规时，由开球的人选择：把 8 号球放回置球点，或重新摆球。如果开球同时犯规，则改由对手选择，并获得自由球。"
          }
        }
      }
    },
    "Sinking the 8 on the break neither wins nor loses. The breaker chooses: put the 8 back on its spot, or rack again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدخال الكرة 8 في الكسرة لا يعني فوزًا ولا خسارة. يختار من كسر: إعادة الكرة 8 إلى نقطتها، أو إعادة الرصّ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 8 beim Anstoß zu versenken ist weder Sieg noch Niederlage. Wer angestoßen hat, wählt: die 8 zurück auf ihren Punkt oder neu aufbauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meter la 8 en el saque ni gana ni pierde. Quien sacó elige: devolver la 8 a su punto o volver a colocar las bolas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empocher la 8 à la casse ne fait ni gagner ni perdre. Celui qui a cassé choisit : remettre la 8 sur sa mouche, ou refaire le triangle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbucare la 8 in spaccata non fa né vincere né perdere. Chi ha spaccato sceglie: rimettere la 8 sul suo punto o ricomporre il triangolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレイクで8番を沈めても勝ちでも負けでもありません。ブレイクした人が、8番をスポットに戻すか、並べ直すかを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브레이크에서 8번을 넣으면 승리도 패배도 아닙니다. 브레이크한 사람이 8번을 제자리에 놓을지, 다시 랙을 놓을지 고릅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meter a 8 na abertura não ganha nem perde. Quem abriu escolhe: repor a 8 no seu ponto ou arrumar de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaçapar a 8 na abertura não ganha nem perde. Quem abriu escolhe: recolocar a 8 no ponto ou arrumar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восьмёрка, забитая на разбое, не приносит ни победы, ни поражения. Разбивавший выбирает: вернуть восьмёрку на её точку или расставить заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开球打进 8 号球既不算赢也不算输。开球的人选择：把 8 号球放回置球点，或重新摆球。"
          }
        }
      }
    },
    "Sinking the cue ball, hitting the wrong ball first, hitting nothing, or knocking a ball off the table is a foul. Your opponent then has ball in hand: they place the cue ball anywhere.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدخال الكرة البيضاء، أو ضرب الكرة الخطأ أولًا، أو عدم ضرب أي شيء، أو إخراج كرة من الطاولة يُعدّ خطأ. عندها تكون الكرة في يد خصمك: يضع الكرة البيضاء في أي مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die weiße Kugel versenken, zuerst die falsche Kugel treffen, gar nichts treffen oder eine Kugel vom Tisch stoßen ist ein Foul. Dein Gegner hat dann Ball in Hand: Er legt die weiße Kugel, wohin er will."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meter la blanca, golpear primero la bola equivocada, no tocar nada o sacar una bola de la mesa es falta. Entonces tu rival tiene bola en mano: coloca la blanca donde quiera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empocher la blanche, toucher d'abord la mauvaise bille, ne rien toucher ou faire sortir une bille de la table est une faute. Ton adversaire a alors la bille en main : il place la blanche où il veut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbucare la bianca, colpire prima la bilia sbagliata, non colpire nulla o far uscire una bilia dal tavolo è fallo. L'avversario ha allora la bilia in mano: piazza la bianca dove vuole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手球を落とす、違う球に先に当てる、何にも当てない、球を台の外に出すのはファウルです。相手はボールインハンドになり、手球を好きな場所に置けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수구를 넣거나, 다른 공을 먼저 맞히거나, 아무것도 못 맞히거나, 공을 테이블 밖으로 내보내면 파울입니다. 그러면 상대가 볼 인 핸드로 수구를 아무 곳에나 놓습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meter a branca, acertar primeiro na bola errada, não acertar em nada ou atirar uma bola para fora da mesa é falta. O adversário fica com bola na mão: coloca a branca onde quiser."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaçapar a branca, acertar primeiro a bola errada, não acertar nada ou jogar uma bola para fora da mesa é falta. O adversário fica com bola na mão: coloca a branca onde quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забить биток, сначала попасть не в тот шар, ни во что не попасть или выбить шар со стола — это фол. Тогда у соперника шар с руки: он ставит биток куда угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "母球落袋、先碰错球、一个球都没碰到，或把球打出台面，都是犯规。对手随后获得自由球：可把母球放在任意位置。"
          }
        }
      }
    },
