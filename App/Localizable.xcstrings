    "Nothing dropped, but the rack is open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تدخل أي كرة، لكن المثلث انفتح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ist gefallen, aber das Dreieck ist offen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No entró ninguna, pero el triángulo está abierto."
