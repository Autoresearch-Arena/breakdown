    "Swinging hard: the tip landed left of where you aimed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربة قوية: أصاب رأس العصا يسار المكان الذي صوّبت إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit viel Schwung: Die Pomeranze traf links von der Stelle, auf die du gezielt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un golpe fuerte: la suela dio a la izquierda de donde apuntaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un élan fort : le procédé a touché à gauche de l’endroit visé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un colpo forte: il cuoio ha colpito a sinistra del punto mirato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強いスイング:タップが狙った位置より左に当たった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세게 휘두름: 팁이 겨냥한 곳보다 왼쪽에 맞았어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada forte: a sola bateu à esquerda de onde apontaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada forte: o couro bateu à esquerda de onde você mirou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильный замах: наклейка попала левее точки прицела."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大力出杆:杆头击在了瞄准点的左边。"
          }
        }
      }
    },
    "Swinging hard: the tip landed right of where you aimed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربة قوية: أصاب رأس العصا يمين المكان الذي صوّبت إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit viel Schwung: Die Pomeranze traf rechts von der Stelle, auf die du gezielt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un golpe fuerte: la suela dio a la derecha de donde apuntaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un élan fort : le procédé a touché à droite de l’endroit visé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un colpo forte: il cuoio ha colpito a destra del punto mirato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強いスイング:タップが狙った位置より右に当たった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세게 휘두름: 팁이 겨냥한 곳보다 오른쪽에 맞았어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada forte: a sola bateu à direita de onde apontaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada forte: o couro bateu à direita de onde você mirou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильный замах: наклейка попала правее точки прицела."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大力出杆:杆头击在了瞄准点的右边。"
          }
        }
      }
    },
    "Swinging hard: the tip slid off the ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربة قوية: انزلق رأس العصا عن الكرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit viel Schwung: Die Pomeranze ist von der Kugel abgerutscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un golpe fuerte: la suela resbaló de la bola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un élan fort : le procédé a glissé sur la bille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un colpo forte: il cuoio è scivolato sulla bilia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強いスイング:タップが球の上で滑った。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세게 휘두름: 팁이 공에서 미끄러졌어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada forte: a sola escorregou na bola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada forte: o couro escorregou na bola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильный замах: наклейка соскользнула с шара."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大力出杆:杆头从球上滑脱了。"
          }
        }
      }
    },
    "Swipe up or down on Aim to turn the aim, and on Power to set the swing. Then double-tap Break.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر لأعلى أو لأسفل على «التصويب» لتدوير التصويب، وعلى «القوة» لضبط الضربة. ثم انقر مرتين على «افتتاح»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisch auf Zielen nach oben oder unten, um zu zielen, und auf Kraft, um den Schwung einzustellen. Dann tipp doppelt auf Break."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza arriba o abajo sobre Apuntar para girar la puntería, y sobre Potencia para fijar el golpe. Luego toca dos veces Saque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse vers le haut ou le bas sur Viser pour tourner la visée, et sur Puissance pour régler l'élan. Puis touche deux fois Casse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri su o giù su Mira per ruotare la mira, e su Potenza per regolare il colpo. Poi tocca due volte Break."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「照準」で上下にスワイプして狙いを回し、「強さ」で振りを決めます。それから「ブレイク」をダブルタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조준에서 위아래로 스와이프해 조준을 돌리고, 세기에서 스윙을 정해요. 그다음 브레이크를 두 번 탭하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para cima ou para baixo em Mira para rodar a mira, e em Força para definir o balanço. Depois toca duas vezes em Abertura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para cima ou para baixo em Mira para girar a mira, e em Força para definir o balanço. Depois toque duas vezes em Abertura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проводи вверх или вниз по «Прицелу», чтобы повернуть прицел, и по «Силе», чтобы задать замах. Потом дважды коснись «Разбить»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“瞄准”上上下滑动转动瞄准，在“力度”上设定挥杆。然后连按两下“开球”。"
          }
        }
      }
    },
    "Swipe up or down to turn the aim. Use the more menu for the sliders.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر لأعلى أو لأسفل لتدوير التصويب. استخدم قائمة المزيد للمنزلقات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach oben oder unten wischen, um zu zielen. Für die Regler das Menü Mehr nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza arriba o abajo para girar la puntería. Usa el menú de más opciones para los controles deslizantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse vers le haut ou vers le bas pour tourner la visée. Utilise le menu Plus pour les curseurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri su o giù per ruotare la mira. Per i cursori usa il menu Altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にスワイプして狙いを回します。スライダーは「その他のメニュー」から使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래로 스와이프해 조준을 돌리세요. 슬라이더는 더보기 메뉴에서 쓸 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para cima ou para baixo para girar a mira. Usa o menu Mais para as barras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para cima ou para baixo para girar a mira. Use o menu Mais para as barras deslizantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведи вверх или вниз, чтобы повернуть прицел. Ползунки в меню «Ещё»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下滑动以转动瞄准。滑块请使用“更多”菜单。"
          }
        }
      }
    },
