    "Three fouls in a row by the same player lose the game. The game warns you after the second.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاثة أخطاء متتالية من اللاعب نفسه تعني خسارة المباراة. تنبّهك اللعبة بعد الخطأ الثاني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Fouls in Folge vom selben Spieler verlieren die Partie. Das Spiel warnt dich nach dem zweiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres faltas seguidas del mismo jugador pierden la partida. El juego te avisa tras la segunda."
