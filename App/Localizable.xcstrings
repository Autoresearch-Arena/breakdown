    "Dashed amber path: the ball is sliding. Its spin has not caught up with its speed yet, so it skids over the cloth.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسار الكهرماني المتقطع: الكرة تنزلق. لم يلحق دورانها بسرعتها بعد، لذا تنزلق فوق الجوخ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestrichelte bernsteinfarbene Spur: Die Kugel gleitet. Ihr Drall hat ihr Tempo noch nicht eingeholt, also rutscht sie über das Tuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazo ámbar discontinuo: la bola se desliza. Su giro aún no ha alcanzado su velocidad, así que derrapa sobre el paño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace ambrée en pointillés : la bille glisse. Sa rotation n'a pas encore rattrapé sa vitesse, donc elle dérape sur le tapis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia ambra tratteggiata: la palla scivola. La sua rotazione non ha ancora raggiunto la sua velocità, quindi slitta sul panno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "琥珀色の破線の軌跡：球は滑っています。回転がまだ速さに追いついていないので、ラシャの上を滑ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호박색 점선 경로: 공이 미끄러지고 있어요. 회전이 아직 속도를 따라잡지 못해서 천 위를 미끄러져요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasto âmbar tracejado: a bola desliza. A rotação ainda não acompanhou a velocidade, por isso derrapa sobre o pano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastro âmbar tracejado: a bola está deslizando. O giro ainda não acompanhou a velocidade, então ela derrapa sobre o pano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Янтарный пунктирный след: шар скользит. Его вращение ещё не догнало скорость, поэтому он проскальзывает по сукну."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "琥珀色虚线轨迹：球在滑动。它的旋转还没跟上速度，所以在台呢上打滑。"
          }
        }
      }
    },
