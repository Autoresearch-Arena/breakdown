    },
    "Raised to about 44 degrees. Short, crisp stroke, hitting a little below the cue's line through the centre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرفوعة إلى نحو 44 درجة. ضربة قصيرة وحادة، تحت خط العصا عبر المركز بقليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf etwa 44 Grad angehoben. Kurzer, knackiger Stoß, etwas unter der Queuelinie durch die Mitte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevado a unos 44 grados. Golpe corto y seco, un poco por debajo de la línea del taco por el centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Levée à environ 44 degrés. Coup court et sec, un peu sous l'axe de la queue, au centre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alzata a circa 44 gradi. Colpo corto e secco, un po' sotto la linea della stecca, al centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約44度に上げる。キューのライン上で中心の少し下を、短くキレよく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 44도로 들기. 큐 선을 따라 중심보다 살짝 아래를 짧고 날카롭게."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantado a uns 44 graus. Tacada curta e seca, um pouco abaixo da linha do taco pelo centro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantado a uns 44 graus. Tacada curta e seca, um pouco abaixo da linha do taco pelo centro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подними примерно на 44 градуса. Короткий резкий удар чуть ниже линии кия через центр."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬到约 44 度。短促干脆，沿球杆线略低于中心击打。"
          }
        }
      }
    },
    "Rarely misses, and plays safe when it has nothing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نادرًا ما يخطئ، ويلعب دفاعيًا حين لا يجد ضربة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfehlt selten und spielt sicher, wenn nichts geht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi nunca falla y juega a la defensiva cuando no tiene nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate rarement, et joue la sécurité quand il n'a rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbaglia di rado e gioca in difesa quando non ha nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "めったに外さず、狙える球がなければセーフティを打ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거의 놓치지 않고, 칠 공이 없으면 수비를 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raramente falha e joga à defesa quando não tem nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raramente erra e joga na defesa quando não tem nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редко мажет, а когда бить нечего, играет отыгрыш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很少失手，没有机会时会打防守。"
          }
        }
      }
    },
