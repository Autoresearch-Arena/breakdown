    "The Massé": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربة الماسيه"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Massé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El masé"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
