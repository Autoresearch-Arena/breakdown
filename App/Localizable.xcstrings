    "Left stick aims, the triggers set the power, A plays the shot.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العصا اليسرى تصوّب، والزنادان يحددان القوة، والزر A يلعب الضربة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der linke Stick zielt, die Trigger stellen die Kraft ein, A spielt den Stoß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El stick izquierdo apunta, los gatillos ajustan la potencia y A juega el tiro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stick gauche vise, les gâchettes règlent la puissance, A joue le coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stick sinistro mira, i grilletti regolano la potenza, A gioca il tiro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左スティックで狙い、トリガーで強さを決め、Aでショットします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 스틱으로 조준하고, 트리거로 세기를 정하고, A로 샷을 칩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O manípulo esquerdo aponta, os gatilhos definem a força e A joga a tacada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O analógico esquerdo mira, os gatilhos definem a força e A dá a tacada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Левый стик целится, курки задают силу, A делает удар."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左摇杆瞄准，扳机键设定力度，A 键击球。"
          }
        }
      }
    },
    "Legal hit, but it didn't drop. 1 point for getting out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربة قانونية، لكنها لم تسقط. نقطة واحدة للخروج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gültiger Treffer, aber sie fiel nicht. 1 Punkt fürs Rauskommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpe legal, pero no entró. 1 punto por salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche valable, mais elle n'est pas tombée. 1 point pour t'en être sorti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colpo valido, ma non è entrata. 1 punto per esserne uscito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反則ではないけど入らなかった。抜け出せたので1点。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정당한 타구지만 들어가지 않았어요. 빠져나온 것으로 1점."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque legal, mas não entrou. 1 ponto por saíres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque legal, mas não entrou. 1 ponto por sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удар по правилам, но шар не упал. 1 очко за выход."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击球合法，但没进。成功解围得 1 分。"
          }
        }
      }
    },
    "Legal hit, but that ball isn't yours to call.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربة قانونية، لكن تلك الكرة ليست لك لتعلنها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gültiger Treffer, aber diese Kugel darfst du nicht ansagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpe legal, pero esa bola no te toca cantarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche valable, mais tu ne pouvais pas annoncer cette bille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colpo valido, ma quella palla non puoi chiamarla tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反則ではないけど、その球は宣言できないよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정당한 타구지만, 그 공은 네가 선언할 수 없어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
