    "Moves the tip on the cue ball: follow, draw and side.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحرّك موضع الرأس على الكرة البيضاء: دفع وسحب ولف جانبي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegt die Spitze auf der weißen Kugel: Nachlauf, Rückzug und Seitendrall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve la punta sobre la bola blanca: avance, retroceso y efecto lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace la pointe sur la bille blanche : avant, rétro et effet latéral."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta la punta sulla palla bianca: avanti, indietro ed effetto laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手球上の先端の位置を動かします：フォロー、ドロー、横回転。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐볼 위 팁 위치를 옮겨요: 밀어치기, 끌어치기, 옆 회전."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a ponta na bola branca: avanço, recuo e efeito lateral."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a ponta na bola branca: avanço, recuo e efeito lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигает точку удара по белому шару: накат, оттяжка и боковое вращение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动杆头在白球上的位置：高杆、低杆和侧旋。"
          }
        }
      }
    },
