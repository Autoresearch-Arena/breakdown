            "state": "translated",
            "value": "%@が%@ m/sでポケットに入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)가 %@ m/s로 포켓에 들어갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cai na caçapa a %@ m/s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cai na caçapa a %@ m/s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ падает в лузу на скорости %@ m/s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以 %@ m/s 的速度落袋。"
          }
        }
      }
    },
    "%@ hits the rail at %@ m/s and keeps %@ percent of its speed straight into the rail. Sideways speed is trimmed by friction.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يصطدم بالحافة بسرعة %@ m/s ويحتفظ بـ%@ في المئة من سرعته متجهاً مباشرةً نحو الحافة. ويقلّص الاحتكاكُ السرعةَ الجانبية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trifft die Bande mit %@ m/s und behält %@ Prozent seines Tempos in Richtung Bande. Die seitliche Geschwindigkeit wird durch Reibung gebremst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ toca la banda a %@ m/s y conserva el %@ por ciento de su velocidad en línea recta contra la banda. La fricción reduce la velocidad lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ touche la bande à %@ m/s et garde %@ pour cent de sa vitesse en ligne droite contre la bande. La friction réduit la vitesse latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ colpisce la sponda a %@ m/s e mantiene il %@ per cento della sua velocità verso la sponda. La velocità laterale viene frenata dall'attrito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は%@ m/sでクッションに当たり、速さの%@%を保ったまま真っすぐ跳ね返ります。横方向の速さは摩擦で削られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)가 %@ m/s로 쿠션에 맞고, 속도의 %@%를 유지한 채 곧장 되튑니다. 옆 방향 속도는 마찰로 줄어듭니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bate na tabela a %@ m/s e mantém %@ por cento da velocidade em direção à tabela. A velocidade lateral é reduzida pelo atrito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bate na tabela a %@ m/s e mantém %@ por cento da velocidade em direção à tabela. A velocidade lateral é reduzida pelo atrito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ударяется о борт на скорости %@ m/s и сохраняет %@ процентов скорости в направлении борта. Боковую скорость гасит трение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以 %@ m/s 的速度撞上库边，沿库边方向保留了百分之%@的速度。侧向速度被摩擦力削减。"
          }
        }
      }
    },
