    "Raised to about 44 degrees. Short, crisp stroke, hitting a little below the cue's line through the centre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرفوعة إلى نحو 44 درجة. ضربة قصيرة وحادة، تحت خط العصا عبر المركز بقليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf etwa 44 Grad angehoben. Kurzer, knackiger Stoß, etwas unter der Queuelinie durch die Mitte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevado a unos 44 grados. Golpe corto y seco, un poco por debajo de la línea del taco por el centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Levée à environ 44 degrés. Coup court et sec, un peu sous l'axe de la queue, au centre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alzata a circa 44 gradi. Colpo corto e secco, un po' sotto la linea della stecca, al centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約44度に上げる。キューのライン上で中心の少し下を、短くキレよく。"
