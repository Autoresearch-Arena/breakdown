      }
    },
    "Into the wrong cup": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الكأس الخطأ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den falschen Becher"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la copa equivocada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le mauvais trou"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella coppa sbagliata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "違うカップに入った"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 컵에 들어감"
          }
        },
        "pt": {
