        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "花式球“%@”就建立在这个道理上。"
          }
        }
      }
    },
    "The trick shot built on the lesson you passed.": {
      "localizations": {
        "ar": {
