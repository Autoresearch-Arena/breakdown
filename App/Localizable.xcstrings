    "%@ drops in at %@ m/s.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يسقط في الجيب بسرعة %@ m/s."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fällt mit %@ m/s ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entra en la tronera a %@ m/s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tombe dans la poche à %@ m/s."
          }
        },
