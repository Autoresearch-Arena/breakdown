    "Six short lessons: stop, follow, draw, cut, curve and jump.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستة دروس قصيرة: التوقف، والدفع، والسحب، والقطع، والمنحنى، والقفز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs kurze Lektionen: Stopp, Nachlauf, Rückzug, Schnitt, Kurve und Sprung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis lecciones cortas: parada, seguimiento, retroceso, corte, curva y salto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six courtes leçons : arrêt, suivi, rétro, coupe, courbe et saut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei brevi lezioni: fermo, avanti, indietro, taglio, curva e salto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6つの短いレッスン：ストップ、フォロー、ドロー、カット、カーブ、ジャンプ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 레슨 여섯 개: 스톱, 밀어치기, 끌어치기, 컷, 커브, 점프."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis lições curtas: paragem, avanço, recuo, corte, curva e salto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis lições curtas: parada, avanço, recuo, corte, curva e salto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шесть коротких уроков: остановка, накат, оттяжка, срез, кривая и прыжок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "六节短课：定杆、高杆、低杆、切球、弧线和跳球。"
          }
        }
      }
    },
