    "%@ came to rest.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist liegen geblieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s'est arrêtée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si è fermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が止まりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 멈췄어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parou."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ остановился."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@停了下来。"
          }
        }
      }
    },
    "%@ catches %@ at %@ m/s and is turned away from the hole. A little more to the middle of the pocket and it drops.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يلتقط %@ بسرعة %@ m/s فيُصرف عن الفتحة. بقليل أكثر نحو وسط الجيب تسقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erwischt %@ mit %@ m/s und wird von der Tasche abgewiesen. Ein wenig mehr zur Mitte der Tasche, und sie fällt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ alcanza a %@ a %@ m/s y es rechazada por la boca de la tronera. Un poco más hacia el centro de la tronera y cae."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ touche %@ à %@ m/s et est repoussée par l'ouverture de la poche. Un peu plus vers le milieu de la poche et elle tombe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ intercetta %@ a %@ m/s e viene deviata dalla buca. Un po' più verso il centro della buca e cade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が%@を%@ m/sで捉え、穴から押し戻されます。ポケットの中央寄りに少し当たれば落ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)가 %@(을)를 %@ m/s로 잡아, 구멍에서 밀려납니다. 포켓 가운데 쪽으로 조금 더 가면 떨어집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ atinge %@ a %@ m/s e é desviada do buraco. Um pouco mais para o meio da caçapa e ela cai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ atinge %@ a %@ m/s e é desviada do buraco. Um pouco mais para o meio da caçapa e ela cai."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ задевает %@ на скорости %@ m/s и отводится от лузы. Чуть ближе к середине лузы, и шар упадёт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 接住 %@，速度为 %@ m/s，被挡在袋口之外。再往袋中间偏一点，它就会落袋。"
          }
        }
      }
    },
    "%@ comes down %@ cm from where it left the cloth, at %@ m/s, and stays on the cloth.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ تهبط على بُعد %2$@ cm من حيث غادرت الجوخ، بسرعة %3$@ m/s، وتبقى على الجوخ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ landet %2$@ cm von der Stelle, an der sie abhob, mit %3$@ m/s und bleibt auf dem Tuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cae a %2$@ cm de donde despegó del paño, a %3$@ m/s, y se queda sobre el paño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ retombe à %2$@ cm de l'endroit où elle a quitté le tapis, à %3$@ m/s, et reste sur le tapis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ricade a %2$@ cm da dove si era staccata dal panno, a %3$@ m/s, e resta sul panno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はラシャを離れた所から%2$@ cm先に%3$@ m/sで落ち、そのままラシャに留まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(이)가 천을 떠난 곳에서 %2$@ cm 떨어진 곳에 %3$@ m/s로 내려와 천 위에 머무릅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cai a %2$@ cm do sítio onde saiu do pano, a %3$@ m/s, e fica no pano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cai a %2$@ cm de onde saiu do pano, a %3$@ m/s, e fica no pano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ приземляется в %2$@ cm от места, где оторвался от сукна, на скорости %3$@ m/s и остаётся на сукне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 落在离起跳点 %2$@ cm 的地方，落下速度 %3$@ m/s，然后留在台呢上。"
          }
        }
      }
    },
    "%@ comes down %@ cm from where it left the cloth, at %@ m/s, and the slate sends it back up at %@ m/s.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ تهبط على بُعد %2$@ cm من حيث غادرت الجوخ، بسرعة %3$@ m/s، ويعيدها اللوح إلى الأعلى بسرعة %4$@ m/s."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ landet %2$@ cm von der Stelle, an der sie abhob, mit %3$@ m/s, und die Platte wirft sie mit %4$@ m/s wieder hoch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cae a %2$@ cm de donde despegó del paño, a %3$@ m/s, y la pizarra la devuelve hacia arriba a %4$@ m/s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ retombe à %2$@ cm de l'endroit où elle a quitté le tapis, à %3$@ m/s, et l'ardoise la renvoie vers le haut à %4$@ m/s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ricade a %2$@ cm da dove si era staccata dal panno, a %3$@ m/s, e l'ardesia la rilancia verso l'alto a %4$@ m/s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はラシャを離れた所から%2$@ cm先に%3$@ m/sで落ち、スレートが%4$@ m/sで再び跳ね上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(이)가 천을 떠난 곳에서 %2$@ cm 떨어진 곳에 %3$@ m/s로 내려오고, 슬레이트가 %4$@ m/s로 다시 튕겨 올립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cai a %2$@ cm do sítio onde saiu do pano, a %3$@ m/s, e a ardósia devolve-a para cima a %4$@ m/s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cai a %2$@ cm de onde saiu do pano, a %3$@ m/s, e a ardósia a devolve para cima a %4$@ m/s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ приземляется в %2$@ cm от места, где оторвался от сукна, на скорости %3$@ m/s, и плита снова подбрасывает его со скоростью %4$@ m/s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 落在离起跳点 %2$@ cm 的地方，落下速度 %3$@ m/s，石板又以 %4$@ m/s 把它弹起。"
          }
        }
      }
    },
