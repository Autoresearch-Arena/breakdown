        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8번이 없다고 생각하고 3번을 겨눠서 풋 왼쪽 코너로 깎으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponta à 3 como se a 8 não estivesse lá, cortando-a para o canto esquerdo do pé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire na 3 como se a 8 não estivesse lá, cortando para o canto esquerdo do pé."
          }
        },
        "ru": {
          "stringUnit": {
