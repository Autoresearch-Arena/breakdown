    "Click the table to aim. Pull back from the white ball and let go.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على الطاولة للتصويب. اسحب للخلف من الكرة البيضاء ثم أفلت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick auf den Tisch, um zu zielen. Zieh von der weißen Kugel zurück und lass los."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la mesa para apuntar. Tira hacia atrás desde la bola blanca y suelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique sur la table pour viser. Tire depuis la bille blanche et relâche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul tavolo per mirare. Tira indietro dalla palla bianca e lascia andare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台をクリックして狙いを定めます。手球から手前に引いて離します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테이블을 클릭해 조준하세요. 큐볼에서 뒤로 당긴 뒤 놓으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clica na mesa para mirar. Puxa para trás a partir da bola branca e larga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique na mesa para mirar. Puxe para trás a partir da bola branca e solte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щёлкни по столу, чтобы прицелиться. Оттяни от белого шара и отпусти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击球桌瞄准。从白球处往后拉，然后松开。"
          }
        }
      }
    },
