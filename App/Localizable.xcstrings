    "Puts the balls back where your last shot started, with the same aim, power and spin": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد الكرات إلى أماكنها عند بداية ضربتك الأخيرة، بنفس التصويب والقوة واللف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Kugeln dorthin zurück, wo dein letzter Stoß begann, mit gleicher Zielrichtung, Kraft und Drall"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a poner las bolas donde empezó tu último tiro, con la misma puntería, potencia y efecto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet les billes là où ton dernier coup avait commencé, avec la même visée, la même puissance et le même effet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimette le palle dove era iniziato il tuo ultimo tiro, con la stessa mira, potenza ed effetto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のショットを始めた位置に球を戻し、狙い・強さ・回転もそのままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 샷을 시작한 위치로 공을 되돌리고, 조준, 세기, 회전은 그대로 둡니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca as bolas de volta onde começou a sua última tacada, com a mesma mira, força e efeito"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca as bolas de volta onde começou sua última tacada, com a mesma mira, força e efeito"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает шары туда, где начался ваш прошлый удар, с тем же прицелом, силой и вращением"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把球放回你上一次击球的起始位置，瞄准、力度和旋转都保持不变"
          }
        }
      }
    },
