    "Practice: three scored tries are used up, so this one isn't kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرين: استُنفدت المحاولات الثلاث المحسوبة، فلا تُحفظ هذه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übung: Die drei gewerteten Versuche sind aufgebraucht, also wird dieser nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Práctica: ya usaste los tres intentos que puntúan, así que este no se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraînement : les trois essais notés sont épuisés, donc celui-ci n'est pas gardé."
