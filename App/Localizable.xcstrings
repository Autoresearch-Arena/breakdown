          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora em câmara lenta na Lente de Física. Para no momento que interessa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora em câmera lenta na Lente de Física. Para no momento que importa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
