    "Starts the shot again in slow motion with the Lens on": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد الضربة بحركة بطيئة مع تشغيل العدسة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet den Stoß noch einmal in Zeitlupe mit eingeschalteter Lens"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a empezar el tiro a cámara lenta con la lente activada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relance le coup au ralenti avec la lentille activée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa ripartire il tiro al rallentatore con la Lens attiva"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズを表示したまま、ショットをスロー再生で始めからやり直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈를 켠 채 샷을 슬로모션으로 처음부터 다시 시작합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repete a tacada em câmara lenta com a Lente ligada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repete a tacada em câmera lenta com a Lente ligada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заново запускает удар в замедленном темпе с включённой линзой"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启透镜，以慢动作重新播放这一击"
          }
        }
      }
    },
