    "Raised a little, about 17 degrees, with lots of right side.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرفوعة قليلاً، نحو 17 درجة، مع لف يميني كثير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leicht angehoben, etwa 17 Grad, mit viel Rechtseffet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco elevado, unos 17 grados, con mucho efecto a la derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu levée, environ 17 degrés, avec beaucoup d'effet à droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un po' alzata, circa 17 gradi, con tanto effetto a destra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し上げて約17度、右ひねりをたっぷり。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "살짝 들어 약 17도, 오른쪽 회전을 많이."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco levantado, uns 17 graus, com muito efeito à direita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco levantado, uns 17 graus, com muito efeito à direita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чуть поднят, около 17 градусов, с сильным правым винтом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微抬起约 17 度，加大量右塞。"
          }
        }
      }
    },
    "Raised steeply, about 53 degrees. Hit down through the centre with a short punch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرفوعة بحدة، نحو 53 درجة. اضرب للأسفل عبر المركز بلكمة قصيرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steil angehoben, etwa 53 Grad. Kurz und knackig durch die Mitte nach unten stoßen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muy elevado, unos 53 grados. Golpea hacia abajo por el centro con un toque corto y seco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien levée, environ 53 degrés. Frappe vers le bas au centre d'un coup sec et court."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molto alzata, circa 53 gradi. Colpisci verso il basso al centro con un colpo corto e secco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急角度、約53度。中心を下へ短く突く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가파르게 약 53도. 중심을 아래로 짧게 찍어 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem levantado, uns 53 graus. Bate para baixo pelo centro com um toque curto e seco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem levantado, uns 53 graus. Bata para baixo pelo centro com um toque curto e seco."
          }
        },
