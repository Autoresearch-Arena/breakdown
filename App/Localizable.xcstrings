    "Learn trick shots that make people stop and stare, and see the physics that makes each one work.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعلّم ضربات الخدع التي توقف الناس ليتفرجوا، وشاهد الفيزياء التي تجعل كل واحدة تنجح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerne Trickstöße, bei denen alle staunen, und sieh die Physik, die jeden einzelnen möglich macht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende tiros de truco que dejan a todos boquiabiertos y mira la física que hace funcionar cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprends des coups spectaculaires qui font s'arrêter les gens, et découvre la physique qui fait marcher chacun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara colpi spettacolari che fanno fermare tutti a guardare, e scopri la fisica che fa funzionare ognuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "みんなが思わず見入るトリックショットを覚えて、それぞれを成り立たせる物理を見てみよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람들이 걸음을 멈추고 지켜보게 만드는 트릭 샷을 배우고, 각각이 성립하는 물리를 확인해 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende jogadas de efeito que fazem toda a gente parar a olhar, e vê a física que faz cada uma funcionar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprenda tacadas de efeito que fazem todo mundo parar para olhar, e veja a física que faz cada uma funcionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учись трюковым ударам, от которых все замирают, и смотри, какая физика за каждым стоит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学会让人驻足围观的花式球，看看每一杆背后的物理原理。"
          }
        }
      }
    },
