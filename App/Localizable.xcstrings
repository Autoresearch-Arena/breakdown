        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐는 공을 %@ m/s로 내보냅니다. 운동량은 질량 × 속도입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
