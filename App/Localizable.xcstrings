            "value": "bei jedem Kontakt wird der Stoß entlang der Mittellinie weitergegeben:  v′ = v · cos θ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cada contacto transmite el empuje a lo largo de la línea de centros:  v′ = v · cos θ"
          }
        },
        "fr": {
