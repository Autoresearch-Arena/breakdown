    "Curve round the 4 and pot the 9 in the top-right corner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التف حول الكرة 4 وأدخل الكرة 9 في الزاوية العلوية اليمنى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die 4 herum und die 9 in die obere rechte Ecke versenken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodea la 4 y mete la 9 en la esquina de arriba a la derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contourne la 4 et rentre la 9 dans le coin en haut à droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira intorno alla 4 e metti in buca la 9 nell'angolo in alto a destra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4番の周りを回して、9番を右上のコーナーに落とそう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4번을 돌아서 9번을 오른쪽 위 코너에 넣으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz a curva em volta da 4 e encaçapa a 9 no canto superior direito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça a curva em volta da 4 e encaçape a 9 no canto superior direito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обогни 4 и загони 9 в правый верхний угол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕过4号球，把9号球打进右上角袋口。"
          }
        }
      }
    },
    "Curve round the 4 and touch the 9 first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انحنِ حول الكرة 4 والمس الكرة 9 أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Biege um die 4 herum und triff zuerst die 9."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva alrededor de la 4 y toca primero la 9."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contourne la 4 et touche d'abord la 9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva attorno alla 4 e tocca per prima la 9."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4番をよけて曲げ、最初に9番に当てよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4번을 돌아 휘어서 9번을 먼저 맞히세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva à volta da 4 e toca primeiro na 9."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça a curva em volta da 4 e toque primeiro na 9."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обогни шар 4 и первым коснись шара 9."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕过4号球，先碰到9号球。"
          }
        }
      }
    },
    "Curve the cue ball around the blocker to pot the target.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل الكرة البيضاء تنحني حول الكرة المعترضة لتدخل الهدف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Biege die weiße Kugel um die blockierende Kugel herum, um die Zielkugel zu versenken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva la bola blanca alrededor del obstáculo para embocar la bola objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courbe la bille blanche autour de l'obstacle pour empocher la bille cible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai curvare la palla bianca attorno alla palla che blocca, per mettere in buca la palla bersaglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "邪魔な球の周りで手球をカーブさせ、目的の球を落とします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해되는 공을 돌아가도록 큐볼을 휘게 해서 목표 공을 넣으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz a bola branca fazer a curva à volta do bloqueio para encaçapar a bola-alvo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça a bola branca fazer a curva em volta do bloqueio e encaçape a bola-alvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрути белый шар вокруг помехи и забей цель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让白球绕过挡球，打进目标球。"
          }
        }
      }
    },
