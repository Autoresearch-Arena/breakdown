    "Off the far cushion and home. The mirror never lies.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الوسادة البعيدة إلى الجيب. المرآة لا تكذب أبداً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über die gegenüberliegende Bande und rein. Der Spiegel lügt nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde la banda del fondo y dentro. El espejo nunca miente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par la bande du fond et au but. Le miroir ne ment jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalla sponda opposta e in buca. Lo specchio non mente mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "奥のクッションを経て、ポケットへ。鏡はうそをつきません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반대편 쿠션을 거쳐 포켓으로. 거울은 거짓말을 하지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pela tabela do fundo e para dentro. O espelho nunca mente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pela tabela do fundo e pra dentro. O espelho nunca mente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От дальнего борта и в лузу. Зеркало не врёт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经远端库边入袋。镜子从不说谎。"
          }
        }
      }
    },
    "Off the jaw": {
