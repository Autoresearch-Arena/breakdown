    "Rails: a ball rolling straight in at %@ m/s keeps %lld percent of its speed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحواف: الكرة التي تتدحرج مباشرةً نحو الحافة بسرعة %1$@ m/s تحتفظ بـ%2$lld في المئة من سرعتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Banden: Eine Kugel, die mit %1$@ m/s gerade hineinrollt, behält %2$lld Prozent ihres Tempos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandas: una bola que llega rodando recta a %1$@ m/s conserva el %2$lld por ciento de su velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandes : une bille qui arrive droit en roulant à %1$@ m/s garde %2$lld pour cent de sa vitesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sponde: una palla che arriva dritta rotolando a %1$@ m/s mantiene il %2$lld per cento della sua velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クッション：%1$@ m/sでまっすぐ転がり込んだ球は、速さの%2$lldパーセントを保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쿠션: %1$@ m/s로 똑바로 굴러 들어간 공은 속도의 %2$lld퍼센트를 유지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabelas: uma bola que chega a rolar direita a %1$@ m/s mantém %2$lld por cento da velocidade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabelas: uma bola que chega rolando reto a %1$@ m/s mantém %2$lld por cento da velocidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Борта: шар, который катится прямо в борт со скоростью %1$@ m/s, сохраняет %2$lld процентов скорости."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "库边：以 %1$@ m/s 笔直滚入的球保留百分之%2$lld的速度。"
          }
        }
      }
    },
    "Raise the cue almost straight up and the cue ball bends around a ball in its way.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع العصا تقريباً إلى الأعلى عمودياً، فتنحني الكرة البيضاء حول كرة تعترض طريقها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb die Queue fast senkrecht, und die weiße Kugel biegt um eine Kugel auf ihrem Weg herum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta el taco casi en vertical y la bola blanca se curva alrededor de una bola que le estorba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève la queue presque à la verticale et la bille blanche contourne une bille qui se trouve sur sa route."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza la stecca quasi in verticale e la palla bianca gira intorno a una palla che le sta davanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューをほぼ真上に立てると、手球は進路にある球を避けて曲がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 거의 수직으로 세우면, 큐볼이 앞을 막는 공을 돌아서 휘어 갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta o taco quase na vertical e a bola branca faz uma curva à volta de uma bola que esteja no caminho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante o taco quase na vertical e a bola branca faz uma curva ao redor de uma bola que esteja no caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подними кий почти вертикально, и белый шар обогнёт шар, мешающий на пути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把球杆几乎竖直抬起，白球就会绕过挡路的球弯曲前进。"
          }
        }
      }
    },
    "Raise the cue and hit to one side: the cue ball bends round a ball in its way.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع العصا واضرب من جانب: تنحني الكرة البيضاء حول كرة تعترض طريقها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb das Queue und triff seitlich: Die weiße Kugel biegt um eine Kugel im Weg herum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta el taco y golpea de lado: la blanca se curva alrededor de una bola que le estorba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève la queue et frappe sur le côté : la blanche contourne en courbe une bille qui la gêne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza la stecca e colpisci di lato: la bianca curva attorno a una palla che la blocca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを立てて横を撞くと、手球は邪魔な球をよけて曲がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 세우고 옆을 치면 큐볼이 길을 막은 공을 돌아 휘어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta o taco e bate de lado: a branca curva à volta de uma bola no caminho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante o taco e bata de lado: a branca faz a curva em volta de uma bola no caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подними кий и ударь сбоку: белый шар обогнёт шар на пути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬起球杆击打一侧，白球会绕过挡路的球拐弯。"
          }
        }
      }
    },
    "Raise the cue and strike low and to the side. Backspin brings the cue ball back, and the tilted spin bends its path toward the 9.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع العصا واضرب الكرة من أسفل وإلى الجانب. يعيد الدوران الخلفي الكرة البيضاء، ويحني محور الدوران المائل مسارها نحو الكرة ٩."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebe das Queue an und triff die Weiße tief und seitlich. Der Rückdrall zieht sie zurück, und die geneigte Drehachse lenkt sie im Bogen zur 9."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva el taco y golpea abajo y a un lado. El retroceso trae de vuelta la blanca y el giro inclinado curva su trayectoria hacia la 9."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relève la queue et frappe bas sur le côté. Le rétro ramène la blanche et la rotation inclinée courbe sa trajectoire vers la 9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza la stecca e colpisci in basso e di lato. Il retro fa tornare la bianca e la rotazione inclinata la fa curvare verso la 9."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを立て、手球の下側を中心から外して撞こう。逆回転で手球が戻り、傾いた回転軸で軌道が9番へ曲がる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 세우고 수구의 아래쪽 옆을 치세요. 역회전이 수구를 돌아오게 하고, 기울어진 회전이 경로를 9번 공 쪽으로 휘게 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva o taco e bate em baixo e de lado. O efeito de recuo traz a branca de volta e a rotação inclinada curva o trajeto em direção à 9."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleve o taco e bata embaixo e de lado. O efeito de recuo traz a branca de volta e a rotação inclinada curva a trajetória em direção à 9."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подними кий и ударь ниже и сбоку от центра. Обратное вращение вернёт биток, а наклон оси вращения направит его по дуге к 9."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬高球杆，击打母球偏下、偏侧的位置。下旋让母球回退，倾斜的旋转轴让它沿弧线转向9号球。"
          }
        }
      }
    },
    "Raise the cue more. A level cue cannot do this one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع العصا أكثر. العصا الأفقية لا تقدر على هذه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb das Queue höher. Mit flachem Queue geht das nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta más el taco. Con el taco plano no se puede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève davantage la queue. Avec une queue à plat, c'est impossible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza di più la stecca. Con la stecca piatta non si può."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューをもっと立てよう。水平のキューではできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 더 세우세요. 수평 큐로는 안 돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta mais o taco. Com o taco nivelado não dá."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante mais o taco. Com o taco nivelado não dá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подними кий выше. Ровным кием так не выйдет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把球杆再抬高些。平杆做不到。"
          }
        }
      }
    },
    "Raise the cue steeply and the cue ball hops over a ball in its way.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع العصا بزاوية حادة فتقفز الكرة البيضاء فوق كرة تعترض طريقها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb das Queue steil an, und die weiße Kugel hüpft über eine Kugel im Weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta mucho el taco y la blanca salta por encima de una bola que le estorba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève franchement la queue et la blanche saute par-dessus une bille qui la gêne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza molto la stecca e la bianca salta sopra una palla che la blocca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを大きく立てると、手球は邪魔な球を飛び越えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 높이 세우면 큐볼이 길을 막은 공을 뛰어넘어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta bem o taco e a branca salta por cima de uma bola no caminho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante bem o taco e a branca pula por cima de uma bola no caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подними кий круто, и белый шар перепрыгнет шар на пути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把球杆抬得很陡，白球就会跳过挡路的球。"
          }
        }
      }
    },
    "Raise the cue to jump or curve the cue ball": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع العصا لتقفز بالكرة البيضاء أو تحنيها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb das Queue an, um die Weiße springen oder kurven zu lassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva el taco para hacer saltar o curvar la blanca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève la queue pour faire sauter ou courber la blanche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza la stecca per far saltare o curvare la bianca"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを上げて手球をジャンプさせたり曲げたりする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 들어 큐볼을 점프시키거나 휘게 하세요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta o taco para fazer a branca saltar ou curvar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante o taco para fazer a branca pular ou curvar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подними кий, чтобы биток прыгнул или пошёл по дуге"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬起球杆，让母球跳起或走弧线"
          }
        }
      }
    },
    "Raise the tip %@ millimetres to reach the marked band.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع الرأس %@ ملم لتصل إلى النطاق المحدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb die Spitze um %@ Millimeter an, um den markierten Bereich zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube la punta %@ milímetros para llegar a la franja marcada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte la pointe de %@ millimètres pour atteindre la bande marquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza la punta di %@ millimetri per arrivare alla fascia segnata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マークした帯まで、先端をあと%@ミリ上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 구간까지 팁을 %@밀리미터 올려요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe a ponta %@ milímetros para chegar à faixa marcada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba a ponta %@ milímetros para chegar à faixa marcada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подними точку удара на %@ мм, чтобы попасть в отмеченную полосу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将杆头上移%@毫米即可进入标记区。"
          }
        }
      }
    },
    "Raised %@°": {
      "localizations": {
        "ar": {
