    "Last time %@ went in; this time %@ stayed up.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المرة الماضية دخلت %@؛ وهذه المرة بقيت %@ على الطاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim letzten Mal ist %@ eingelocht; diesmal blieb %@ draußen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vez anterior %@ entró; esta vez %@ se quedó fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière fois, %@ est tombée ; cette fois, %@ est restée en jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultima volta %@ è caduta in buca; questa volta %@ è rimasta in gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回は%@がポケットに入り、今回は%@は入りませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번엔 %@ 들어갔고, 이번엔 %@ 들어가지 않았습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Da última vez %@ entrou; desta vez %@ ficou na mesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da última vez %@ entrou; desta vez %@ ficou na mesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В прошлый раз %@ упал в лузу; в этот раз %@ остался на столе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次%@入袋了；这次%@没有入袋。"
          }
        }
      }
    },
    "Last time the cue ball stopped %@; this time it stopped %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المرة الماضية توقفت الكرة البيضاء %@؛ وهذه المرة توقفت %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim letzten Mal kam die weiße Kugel %@ zum Stehen; diesmal kam sie %@ zum Stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vez anterior la bola blanca se detuvo %@; esta vez se detuvo %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière fois, la bille blanche s'est arrêtée %@ ; cette fois elle s'est arrêtée %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultima volta la palla bianca si è fermata %@; stavolta si è fermata %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回は手球が%@で止まり、今回は%@で止まりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번엔 큐볼이 %@ 멈췄고, 이번엔 %@ 멈췄습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Da última vez a bola branca parou %@; desta vez parou %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da última vez a bola branca parou %@; desta vez parou %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В прошлый раз белый шар остановился %@; в этот раз здесь %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次白球停在%@；这次停在%@。"
          }
        }
      }
