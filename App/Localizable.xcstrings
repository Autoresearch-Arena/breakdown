            "value": "大角度跳过 8 号球"
          }
        }
      }
    },
    "Steep, about 53 degrees, tip well right of centre and a little low.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حادة، نحو 53 درجة، ورأس العصا يمين المركز بكثير ومنخفض قليلاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steil, etwa 53 Grad, Spitze deutlich rechts der Mitte und etwas tief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empinado, unos 53 grados, punta bien a la derecha del centro y un poco baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raide, environ 53 degrés, procédé bien à droite du centre et un peu bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripido, circa 53 gradi, cuoio ben a destra del centro e un po' basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急角度で約53度、タップは中心よりかなり右で少し下。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가파르게 약 53도, 팁은 중심보다 한참 오른쪽에 살짝 아래."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinado, uns 53 graus, ponta bem à direita do centro e um pouco baixa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinado, uns 53 graus, ponta bem à direita do centro e um pouco baixa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
