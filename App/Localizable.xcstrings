            "state": "translated",
            "value": "Você mudou o ângulo do taco só um pouquinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклон кия изменился лишь чуть-чуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你只稍微改了一点球杆的角度。"
          }
        }
      }
    },
    "You changed the power only slightly.": {
