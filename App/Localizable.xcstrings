    "Paused where the cue ball first touched a ball. The faint line is your last try.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف عند أول لمسة للكرة البيضاء لكرة أخرى. الخط الباهت هو محاولتك السابقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert, wo die weiße Kugel zuerst eine Kugel berührt hat. Die blasse Linie ist dein letzter Versuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa donde la bola blanca tocó la primera bola. La línea tenue es tu intento anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause là où la bille blanche a touché la première bille. Le trait pâle est ton essai précédent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa dove la bianca ha toccato la prima bilia. La linea tenue è il tuo tentativo precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手球が最初にボールに当たった瞬間で一時停止しました。薄い線は前回の試技です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐볼이 처음 공에 닿은 순간에 멈췄습니다. 흐린 선은 지난번 시도입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa onde a bola branca tocou a primeira bola. A linha ténue é a sua tentativa anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado onde a bola branca tocou a primeira bola. A linha fraca é sua tentativa anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза там, где биток впервые коснулся шара. Бледная линия — твоя прошлая попытка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停在母球首次碰到球的瞬间。淡线是你上一次的尝试。"
          }
        }
      }
    },
