    "It picked the pot that looked easiest and did not plan where the cue ball would stop.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختار الكرة التي بدت أسهل، ولم يخطط لمكان توقف الكرة البيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er hat die Kugel gewählt, die am leichtesten aussah, ohne zu planen, wo die Weiße liegen bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eligió la bola que parecía más fácil y no pensó dónde se pararía la blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
