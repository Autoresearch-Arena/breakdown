          }
        }
      }
    },
    "The table is still open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال الطاولة مفتوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tisch ist noch offen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesa sigue abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La table est toujours ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tavolo è ancora aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだオープンテーブルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 오픈 테이블입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesa continua aberta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesa continua aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стол всё ещё открыт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "球台仍未定组。"
          }
        }
      }
    },
    "The tables are still being set up. They will show here when they're ready.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زالت الطاولات قيد التجهيز. ستظهر هنا حين تكون جاهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tische werden noch aufgebaut. Sie erscheinen hier, sobald sie fertig sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mesas aún se están preparando. Aparecerán aquí cuando estén listas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tables sont encore en préparation. Elles apparaîtront ici quand elles seront prêtes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tavoli sono ancora in preparazione. Compariranno qui quando saranno pronti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台はまだ準備中。準備ができたらここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테이블을 아직 준비 중이에요. 준비되면 여기에 나타나요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mesas ainda estão a ser preparadas. Aparecem aqui quando estiverem prontas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mesas ainda estão sendo preparadas. Elas aparecem aqui quando estiverem prontas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Столы ещё готовятся. Они появятся здесь, когда будут готовы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "球台还在布置中。准备好后会显示在这里。"
          }
        }
      }
    },
    "The throw angle grows with the friction between the balls and how fast their surfaces slip past each other.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تزداد زاوية الانحراف مع الاحتكاك بين الكرات ومع سرعة انزلاق سطحيهما على بعضهما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ablenkwinkel wächst mit der Reibung zwischen den Kugeln und mit der Geschwindigkeit, mit der ihre Oberflächen aneinander vorbeigleiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ángulo de desvío crece con la fricción entre las bolas y con la rapidez con que sus superficies resbalan una junto a otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'angle de déviation grandit avec le frottement entre les billes et la vitesse à laquelle leurs surfaces glissent l'une contre l'autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'angolo di deviazione cresce con l'attrito tra le palle e con la velocità con cui le loro superfici scivolano l'una sull'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじき角は、球どうしの摩擦と、表面が互いに滑る速さが大きいほど大きくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튕김 각은 공 사이의 마찰과 두 표면이 서로 미끄러지는 속도가 클수록 커집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ângulo de desvio cresce com o atrito entre as bolas e com a velocidade com que suas superfícies deslizam uma sobre a outra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ângulo de desvio aumenta com o atrito entre as bolas e com a velocidade com que suas superfícies deslizam uma sobre a outra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Угол отклонения растёт с трением между шарами и с тем, насколько быстро их поверхности скользят друг по другу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏转角随球之间的摩擦以及两者表面相互滑动的速度增大而增大。"
          }
        }
      }
    },
    "The tip met the ball %@ percent of its radius from the centre, so part of the cue's push went into spin instead of speed. It leaves at %@ m/s, %@ percent slower than a centre hit with the same stroke.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لامس رأس العصا الكرة على بعد %@ في المئة من نصف قطرها عن المركز، فذهب جزء من دفعة العصا إلى الدوران بدلاً من السرعة. تنطلق بسرعة %@ m/s، أبطأ بنسبة %@ في المئة من ضربة في المركز بالحركة نفسها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pomeranze traf die Kugel %@ Prozent ihres Radius vom Mittelpunkt entfernt, also ging ein Teil des Queuestoßes in Effet statt in Tempo. Sie läuft mit %@ m/s los, %@ Prozent langsamer als ein Mittelstoß mit derselben Bewegung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suela tocó la bola al %@ por ciento de su radio desde el centro, así que parte del empuje del taco se fue en efecto en lugar de velocidad. Sale a %@ m/s, un %@ por ciento más lenta que un golpe al centro con el mismo tacazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le procédé a touché la bille à %@ pour cent de son rayon du centre, donc une partie de la poussée de la queue est passée dans l'effet au lieu de la vitesse. Elle part à %@ m/s, %@ pour cent plus lentement qu'un coup au centre avec le même geste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cuoio ha colpito la bilia al %@ per cento del raggio dal centro, quindi parte della spinta della stecca è andata in effetto invece che in velocità. Parte a %@ m/s, il %@ per cento più lenta di un colpo al centro con lo stesso tiro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップはボールの中心から半径の%@パーセントの位置に当たったので、キューの押しの一部が速さではなく回転になりました。ボールは%@ m/sで出ていき、同じストロークで中心を撞いたときより%@パーセント遅くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁이 공의 중심에서 반지름의 %@퍼센트 떨어진 곳에 맞아, 큐가 미는 힘의 일부가 속도 대신 회전이 되었습니다. 공은 %@ m/s로 나가며, 같은 스트로크로 중심을 쳤을 때보다 %@퍼센트 느립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sola tocou na bola a %@ por cento do raio a partir do centro, por isso parte do impulso do taco foi para o efeito em vez da velocidade. Sai a %@ m/s, %@ por cento mais lenta do que uma tacada ao centro com o mesmo movimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sola tocou a bola a %@ por cento do raio a partir do centro, então parte do impulso do taco virou efeito em vez de velocidade. Ela sai a %@ m/s, %@ por cento mais lenta que uma tacada no centro com o mesmo movimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклейка коснулась шара на %@ процентов радиуса от центра, поэтому часть толчка кия ушла во вращение, а не в скорость. Шар уходит на %@ m/s, на %@ процентов медленнее, чем при ударе в центр тем же движением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "皮头击球点离球心为半径的百分之%@，所以球杆的推力有一部分变成了旋转而不是速度。球以 %@ m/s 离开，比同样力度击中心慢百分之%@。"
          }
        }
      }
    },
    "The tip met the ball more than %@ percent of its radius from the centre, past where the tip can grip, and slid off. The ball leaves at only %@ m/s, %@ degrees off the line of the cue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لامس رأس العصا الكرة على بعد أكثر من %@ في المئة من نصف قطرها عن المركز، أبعد مما يستطيع الإمساك به، فانزلق عنها. تنطلق الكرة بسرعة %@ m/s فقط، منحرفةً %@ درجة عن خط العصا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pomeranze traf die Kugel mehr als %@ Prozent ihres Radius vom Mittelpunkt entfernt, jenseits der Stelle, an der sie noch greift, und rutschte ab. Die Kugel läuft nur mit %@ m/s los, %@ Grad neben der Linie des Queues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suela tocó la bola a más del %@ por ciento de su radio desde el centro, más allá de donde puede agarrar, y resbaló. La bola sale a solo %@ m/s, %@ grados fuera de la línea del taco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le procédé a touché la bille à plus de %@ pour cent de son rayon du centre, au-delà de ce qu'il peut tenir, et il a glissé. La bille ne part qu'à %@ m/s, à %@ degrés de la ligne de la queue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cuoio ha colpito la bilia a più del %@ per cento del raggio dal centro, oltre il punto in cui riesce a fare presa, ed è scivolato. La bilia parte a soli %@ m/s, a %@ gradi dalla linea della stecca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップがボールの中心から半径の%@パーセントより外側に当たり、グリップできる限界を超えて滑りました。ボールはわずか%@ m/sで、キューのラインから%@度ずれて出ていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁이 공의 중심에서 반지름의 %@퍼센트보다 바깥쪽에 맞아, 잡아 줄 수 있는 한계를 넘어 미끄러졌습니다. 공은 겨우 %@ m/s로, 큐의 선에서 %@도 벗어나 나갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sola tocou na bola a mais de %@ por cento do raio a partir do centro, para lá do ponto em que consegue agarrar, e escorregou. A bola sai a apenas %@ m/s, %@ graus fora da linha do taco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sola tocou a bola a mais de %@ por cento do raio a partir do centro, além do ponto em que consegue segurar, e escorregou. A bola sai a apenas %@ m/s, %@ graus fora da linha do taco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклейка коснулась шара дальше чем на %@ процентов радиуса от центра, там, где она уже не держит, и соскользнула. Шар уходит всего на %@ m/s, на %@ градусов в сторону от линии кия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "皮头击球点离球心超过半径的百分之%@，超出了皮头能咬住的范围，于是滑开了。球只以 %@ m/s 的速度离开，偏离球杆方向 %@ 度。"
          }
        }
      }
    },
    "The trick shot %@ is built on this idea.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربة الخدعة «%@» مبنية على هذه الفكرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Trickstoß %@ baut auf dieser Idee auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiro de truco %@ se basa en esta idea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coup spectaculaire %@ repose sur cette idée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
