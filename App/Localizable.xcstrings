    "Turn the aim %@ degrees left to reach the marked fan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدر التصويب %@ درجة إلى اليسار لتصل إلى المروحة المحددة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh das Ziel um %@ Grad nach links, um den markierten Fächer zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la puntería %@ grados a la izquierda para llegar al abanico marcado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne la visée de %@ degrés vers la gauche pour atteindre l'éventail marqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruota la mira di %@ gradi a sinistra per arrivare al ventaglio segnato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マークした扇形まで、狙いをあと%@度左へ回します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 부채꼴까지 조준을 왼쪽으로 %@도 돌려요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda a mira %@ graus para a esquerda para chegar ao leque marcado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire a mira %@ graus para a esquerda para chegar ao leque marcado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверни прицел на %@° влево, чтобы попасть в отмеченный сектор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将瞄准向左转%@度即可进入标记扇区。"
          }
        }
      }
    },
    "Turn the aim %@ degrees right to reach the marked fan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدر التصويب %@ درجة إلى اليمين لتصل إلى المروحة المحددة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh das Ziel um %@ Grad nach rechts, um den markierten Fächer zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la puntería %@ grados a la derecha para llegar al abanico marcado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne la visée de %@ degrés vers la droite pour atteindre l'éventail marqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruota la mira di %@ gradi a destra per arrivare al ventaglio segnato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マークした扇形まで、狙いをあと%@度右へ回します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 부채꼴까지 조준을 오른쪽으로 %@도 돌려요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda a mira %@ graus para a direita para chegar ao leque marcado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire a mira %@ graus para a direita para chegar ao leque marcado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверни прицел на %@° вправо, чтобы попасть в отмеченный сектор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将瞄准向右转%@度即可进入标记扇区。"
          }
        }
      }
    },
    "Turns alternate after every shot. The pins are stood up again, and a ball resting on a pin's spot goes back to its own spot.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتناوب الدور بعد كل ضربة. تُعاد الأوتاد واقفة، وتعود الكرة المستقرة مكان وتد إلى نقطتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jedem Stoß wechselt der Zug. Die Kegel werden wieder aufgestellt, und eine Kugel auf dem Platz eines Kegels kommt auf ihren eigenen Punkt zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los turnos se alternan tras cada tiro. Los bolos se vuelven a poner de pie, y una bola parada sobre el sitio de un bolo vuelve a su propio punto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On joue chacun son tour après chaque coup. Les quilles sont relevées, et une bille arrêtée sur l’emplacement d’une quille retourne sur son propre point."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I turni si alternano dopo ogni tiro. I birilli vengono rialzati, e una bilia ferma sul posto di un birillo torna sul suo punto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショットごとに交代します。ピンは立て直され、ピンの位置に止まった球は自分のスポットに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샷마다 차례가 바뀝니다. 핀은 다시 세워지고, 핀 자리에 멈춘 공은 제자리 점으로 돌아갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A vez alterna depois de cada tacada. Os pinos voltam a ser levantados, e uma bola parada no lugar de um pino volta ao seu próprio ponto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A vez alterna depois de cada tacada. Os pinos são levantados de novo, e uma bola parada no lugar de um pino volta para o seu próprio ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ход переходит после каждого удара. Кегли снова ставят, а шар, стоящий на месте кегли, возвращается на свою отметку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每杆之后轮换。木柱重新立起，停在木柱位置上的球放回自己的置球点。"
          }
        }
      }
    },
    "Turns the Physics Lens on or off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل عدسة الفيزياء أو يوقفها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die Physik-Lens ein oder aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva la lente de física."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive la Lentille physique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva la Lens di fisica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物理レンズのオン・オフを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물리 렌즈를 켜거나 꺼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga ou desliga a Lente de Física."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga ou desliga a Lente de Física."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает и выключает «Физическую линзу»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开或关闭物理透镜。"
          }
        }
      }
    },
    "Turns the aim. Push further to turn faster.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدير التصويب. ادفعها أكثر ليدور أسرع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreht das Ziel. Weiter drücken dreht schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la puntería. Empuja más para girar más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne la visée. Pousse plus loin pour tourner plus vite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruota la mira. Spingi di più per ruotare più in fretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "狙いを回します。深く倒すほど速く回ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조준을 돌려요. 더 밀수록 빨리 돌아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda a mira. Empurra mais para rodar mais depressa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira a mira. Empurre mais para girar mais rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поворачивает прицел. Чем сильнее наклонишь, тем быстрее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转动瞄准。推得越远转得越快。"
          }
        }
      }
    },
    "Two Players": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاعبان"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Spieler"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos jugadores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux joueurs"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due giocatori"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2人で"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2인"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois jogadores"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois jogadores"
          }
        },
        "ru": {
