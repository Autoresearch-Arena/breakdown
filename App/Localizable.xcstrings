    "No call was made, so the suggested call was used: Safety.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُعلن ضربتك، فاعتُمد الإعلان المقترح: ضربة دفاعية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast nichts angesagt, also galt die vorgeschlagene Ansage: Sicherheit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cantaste el tiro, así que se usó el sugerido: defensa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n’as rien annoncé, donc l’annonce suggérée a été retenue : sécurité."
