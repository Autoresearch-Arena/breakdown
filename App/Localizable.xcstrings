    "Your ball must hit another ball first. Each ball that then drops scores the number by its hole, and the red scores double.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تصيب كرتك كرة أخرى أولًا. كل كرة تسقط بعدها تسجل الرقم الذي بجانب حفرتها، والحمراء تُحسب مضاعفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kugel muss zuerst eine andere Kugel treffen. Jede Kugel, die danach fällt, zählt die Zahl an ihrem Loch, die Rote doppelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu bola debe tocar antes otra bola. Cada bola que caiga después suma el número de su agujero, y la roja puntúa doble."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bille doit d’abord toucher une autre bille. Chaque bille qui tombe ensuite marque le nombre de son trou, et la rouge compte double."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua bilia deve prima colpire un’altra bilia. Ogni bilia che poi cade vale il numero della sua buca, e la rossa vale doppio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の球はまず別の球に当てます。そのあと落ちた球は穴の数字が得点になり、赤球は2倍です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 공이 먼저 다른 공을 맞혀야 합니다. 그 뒤 떨어진 공은 구멍에 적힌 숫자만큼 점수가 되고, 빨간 공은 두 배입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua bola tem de acertar primeiro noutra bola. Cada bola que depois cair vale o número do seu buraco, e a vermelha conta a dobrar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua bola precisa acertar outra bola primeiro. Cada bola que cair depois vale o número do buraco, e a vermelha vale o dobro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой шар должен сначала попасть в другой шар. Каждый упавший потом шар приносит число у своей лунки, красный — вдвойне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的球必须先碰到另一个球。之后落入的每个球得到其洞旁的分数，红球得双倍。"
          }
        }
      }
    },
