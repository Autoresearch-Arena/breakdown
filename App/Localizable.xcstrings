            "state": "translated",
            "value": "Na taça errada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na caçapa errada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не в ту лунку"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进错了杯"
          }
        }
      }
    },
    "It also carries left-hand side spin, which shows at the next rail.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وتحمل أيضاً دوراناً جانبياً إلى اليسار يظهر عند الحافة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie trägt auch linken Seiteneffet, der sich an der nächsten Bande zeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También lleva efecto lateral a la izquierda, que se notará en la próxima banda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle emporte aussi de l'effet à gauche, qui se verra à la prochaine bande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta anche effetto laterale a sinistra, che si vedrà alla prossima sponda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左の横回転もかかっていて、次のクッションで効いてきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 옆회전도 걸려 있어서 다음 쿠션에서 드러납니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva também efeito lateral à esquerda, que se vai ver na próxima tabela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva também efeito lateral à esquerda, que vai aparecer na próxima tabela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё у него левый боковой винт, который проявится у следующего борта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它还带着左侧旋，会在下一次碰库时显现。"
          }
        }
      }
    },
    "It also carries right-hand side spin, which shows at the next rail.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وتحمل أيضاً دوراناً جانبياً إلى اليمين يظهر عند الحافة التالية."
          }
        },
        "de": {
