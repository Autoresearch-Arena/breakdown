          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ángulo de entrada ≈ ángulo de salida  (el agarre de la banda y el efecto lo desvían unos grados)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
