    "Your ball went in another pocket. 1 point for getting out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دخلت كرتك جيباً آخر. نقطة واحدة للخروج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kugel fiel in eine andere Tasche. 1 Punkt fürs Rauskommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu bola entró en otra tronera. 1 punto por salir."
          }
        },
        "fr": {
          "stringUnit": {
