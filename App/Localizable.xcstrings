    "Drag on the ball to place the tip. Or use the actions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب على الكرة لتحديد موضع الرأس، أو استخدم الإجراءات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe auf der Kugel, um die Queuespitze zu setzen. Oder nutze die Aktionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra sobre la bola para colocar la punta. O usa las acciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser sur la bille pour placer la pointe. Ou utilise les actions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina sulla palla per posizionare la punta. Oppure usa le azioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手球をドラッグして先端の位置を決めます。または操作ボタンを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐볼을 드래그해 팁 위치를 정하세요. 또는 동작 버튼을 사용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste na bola para posicionar a ponta. Ou use as ações."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste na bola para posicionar a ponta. Ou use as ações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите по шару, чтобы поставить кончик. Или используйте кнопки действий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在球上拖动来放置杆头，也可以使用操作按钮。"
          }
        }
      }
    },
    "Drag on the table to aim. Pull back from the white ball to set power, then click %@. Arrow keys fine-tune.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب على الطاولة للتصويب. اسحب للخلف من الكرة البيضاء لتحديد القوة، ثم انقر %@. مفاتيح الأسهم للضبط الدقيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Tisch ziehen, um zu zielen. Von der weißen Kugel zurückziehen, um die Kraft festzulegen, dann auf %@ klicken. Pfeiltasten für die Feinabstimmung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra sobre la mesa para apuntar. Tira hacia atrás desde la bola blanca para ajustar la potencia y luego haz clic en %@. Las teclas de flecha afinan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser sur la table pour viser. Tire vers l'arrière depuis la bille blanche pour régler la puissance, puis clique sur %@. Les flèches permettent d'affiner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina sul tavolo per mirare. Tira indietro dalla palla bianca per impostare la potenza, poi clicca su %@. I tasti freccia per la regolazione fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーブルをドラッグして狙いを定めます。手球から手前に引いて強さを決め、%@をクリックしてください。矢印キーで微調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테이블을 드래그해 조준하세요. 큐볼에서 뒤로 당겨 세기를 정한 뒤 %@ 버튼을 클릭하세요. 방향키로 미세 조정하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste na mesa para mirar. Puxe para trás a partir da bola branca para definir a força, depois clique em %@. As setas do teclado ajustam com precisão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste na mesa para mirar. Puxe para trás a partir da bola branca para definir a força, depois clique em %@. As setas do teclado ajustam com precisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите по столу, чтобы прицелиться. Оттяните от белого шара, чтобы задать силу, затем нажмите «%@». Стрелки для точной настройки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在球桌上拖动以瞄准。从白球处往后拉以设定力度，然后点击“%@”。方向键可微调。"
          }
        }
      }
    },
    "Drag on the table to aim. Pull back from the white ball to set power, then tap %@.": {
      "localizations": {
