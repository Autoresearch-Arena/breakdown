    "Your turn. Drag to aim, pull back, let go.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورك. اسحب للتصويب، ثم اسحب للخلف، ثم اترك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist dran. Zum Zielen ziehen, zurückziehen, loslassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te toca. Arrastra para apuntar, tira hacia atrás y suelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À toi. Glisse pour viser, tire en arrière, lâche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca a te. Trascina per mirare, tira indietro, lascia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの番です。ドラッグで狙って、引いて、離す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신 차례입니다. 드래그해 조준하고, 뒤로 당겼다가, 놓으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua vez. Arraste para apontar, puxe para trás e solte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua vez. Arraste para mirar, puxe para trás e solte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой ход. Проведи, чтобы прицелиться, оттяни и отпусти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮到你了。拖动瞄准，向后拉，松手。"
          }
        }
      }
    },
