    "A pool game that shows its working. Take a shot, then watch the physics behind it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعبة بلياردو تُظهر طريقة عملها. اضرب، ثم شاهد الفيزياء التي تقف وراءها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Billardspiel, das seine Rechnung offenlegt. Stoß ausführen und dann die Physik dahinter beobachten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un juego de billar que muestra cómo funciona. Haz un tiro y luego mira la física que hay detrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jeu de billard qui montre son fonctionnement. Réalise un coup, puis regarde la physique qui se cache derrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gioco di biliardo che mostra come funziona. Fai un tiro, poi guarda la fisica che c'è dietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算の過程まで見せるビリヤードゲーム。ショットを打ったら、その裏の物理を見てみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀이 과정을 보여 주는 당구 게임. 샷을 치고 그 뒤의 물리를 지켜보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogo de bilhar que mostra o seu raciocínio. Dê uma tacada e depois veja a física por trás dela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogo de bilhar que mostra como funciona. Dê uma tacada e depois veja a física por trás dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бильярдная игра, которая показывает, как всё устроено. Сделайте удар и посмотрите на физику, стоящую за ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一款会展示过程的台球游戏。先击球，再看背后的物理原理。"
          }
        }
      }
    },
