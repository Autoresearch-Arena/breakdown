            "state": "translated",
            "value": "Бей красным, на который наведён кий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击打球杆对准的那个红球。"
          }
        }
      }
    },
    "Strike the white the cue is set on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضرب الكرة البيضاء التي تصوّب عليها العصا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel die Weiße, an der dein Queue angesetzt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpea la blanca a la que apunta el taco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue la blanche sur laquelle ta queue est posée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colpisci la bianca su cui è puntata la stecca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを構えている白球を突こう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐가 겨누고 있는 흰 공을 쳐."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Joga a branca para onde o taco aponta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue a branca para onde o taco aponta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бей белым, на который наведён кий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击打球杆对准的那个白球。"
          }
        }
      }
    },
    "Strike the white; hit the yellow first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضرب البيضاء؛ وأصب الصفراء أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel die Weiße; triff zuerst die Gelbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpea la blanca; toca primero la amarilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue la blanche ; touche d’abord la jaune."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colpisci la bianca; prendi prima la gialla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白球を突き、先に黄球に当てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흰 공을 치고, 노란 공을 먼저 맞히세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Joga a branca; acerta primeiro na amarela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue a branca; acerte primeiro a amarela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бей белым; сначала попади в жёлтый."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击打白球，先碰黄球。"
          }
        }
      }
    },
    "Strike the yellow; hit the white first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضرب الصفراء؛ وأصب البيضاء أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel die Gelbe; triff zuerst die Weiße."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpea la amarilla; toca primero la blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue la jaune ; touche d’abord la blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colpisci la gialla; prendi prima la bianca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黄球を突き、先に白球に当てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노란 공을 치고, 흰 공을 먼저 맞히세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Joga a amarela; acerta primeiro na branca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue a amarela; acerte primeiro a branca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бей жёлтым; сначала попади в белый."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击打黄球，先碰白球。"
          }
        }
      }
    },
    "Strike your marked ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضرب كرتك المعلَّمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel deine markierte Kugel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpea tu bola marcada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue ta bille marquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colpisci la tua bilia segnata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マーク付きの自分の球を突きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 내 공을 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Joga a tua bola marcada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue a sua bola marcada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бей своим отмеченным шаром."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击打你的标记球。"
          }
        }
      }
    },
    "Strike your own ball so it hits the other player's ball first. Points come from what that ball and the red do next.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضرب كرتك لتصيب كرة اللاعب الآخر أولًا. تأتي النقاط مما تفعله تلك الكرة والحمراء بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel deine Kugel so, dass sie zuerst die Kugel des anderen trifft. Die Punkte kommen von dem, was diese Kugel und die Rote danach tun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpea tu bola para que toque primero la del otro jugador. Los puntos salen de lo que hagan después esa bola y la roja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue ta bille pour qu’elle touche d’abord celle de l’autre joueur. Les points viennent de ce que font ensuite cette bille et la rouge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colpisci la tua bilia in modo che prenda prima quella dell’altro giocatore. I punti vengono da ciò che fanno poi quella bilia e la rossa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の球を突いて、先に相手の球に当てます。得点は、そのあと相手の球と赤球が何をしたかで決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 공을 쳐서 상대 공을 먼저 맞히세요. 점수는 그다음 그 공과 빨간 공이 한 일에서 나옵니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Joga a tua bola para que acerte primeiro na do outro jogador. Os pontos vêm do que essa bola e a vermelha fizerem a seguir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue sua bola para que acerte primeiro a do outro jogador. Os pontos vêm do que essa bola e a vermelha fizerem em seguida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бей своим шаром так, чтобы он сначала попал в шар соперника. Очки дают то, что потом сделают этот шар и красный."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击打自己的球，让它先碰对方的球。得分来自那个球和红球接下来的表现。"
          }
        }
      }
    },
    "Stripe": {
