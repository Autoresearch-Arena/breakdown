          }
        }
      }
    },
    "Right rail at the first diamond past the side pocket, then the foot rail, and along it into the 13 and on into the foot-left corner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحافة اليمنى عند الماسة الأولى بعد الجيب الجانبي، ثم حافة القدم، وعلى طولها إلى الكرة 13 ثم إلى زاوية القدم اليسرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechte Bande am ersten Diamanten hinter der Mitteltasche, dann die Fußbande und an ihr entlang in die 13 und weiter in die linke Fußecke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Banda derecha en el primer diamante pasada la lateral, luego la banda del pie, y por ella hasta la 13 y dentro de la esquina izquierda del pie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bande droite à la première mouche après la poche du milieu, puis la bande du pied, et le long de celle-ci dans la 13 puis dans le coin gauche du pied."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sponda destra al primo diamante dopo la buca centrale, poi la sponda di fondo, e lungo questa sulla 13 e dentro l'angolo sinistro di fondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右クッションのサイドポケットの先の1つ目のポイント、次にフットクッション、それに沿って13番へ、そしてフット左コーナーへ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 쿠션 사이드 포켓 다음 첫 번째 포인트, 그다음 풋 쿠션, 그걸 따라 13번으로, 그리고 풋 왼쪽 코너로."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela direita no primeiro diamante depois da lateral, depois a tabela do pé, e ao longo dela até à 13 e para o canto esquerdo do pé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela direita no primeiro diamante depois da lateral, depois a tabela do pé, e rente a ela até a 13 e para o canto esquerdo do pé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правый борт у первой метки за средней лузой, затем нижний борт и вдоль него в 13 и дальше в левый нижний угол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右库中袋后第一个星点，然后脚库，沿脚库打到 13 号球，再送进脚端左角袋。"
          }
        }
      }
    },
    "Right rail at the first diamond, then the head rail, then the left rail past the second diamond, and down onto the 15.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحافة اليمنى عند الماسة الأولى، ثم حافة الرأس، ثم الحافة اليسرى بعد الماسة الثانية، ونزولاً إلى الكرة 15."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechte Bande am ersten Diamanten, dann die Kopfbande, dann die linke Bande hinter dem zweiten Diamanten und hinunter auf die 15."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Banda derecha en el primer diamante, luego la cabecera, luego la banda izquierda pasado el segundo diamante, y abajo hasta la 15."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bande droite à la première mouche, puis la bande de tête, puis la bande gauche après la deuxième mouche, et on descend sur la 15."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sponda destra al primo diamante, poi la sponda di testa, poi la sinistra oltre il secondo diamante, e giù sulla 15."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右クッションの1つ目のポイント、次にヘッドクッション、次に左クッションの2つ目のポイントの先、そして15番へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 쿠션 첫 번째 포인트, 그다음 헤드 쿠션, 그다음 왼쪽 쿠션 두 번째 포인트 지나서, 그리고 15번으로 내려가요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela direita no primeiro diamante, depois a cabeceira, depois a tabela esquerda depois do segundo diamante, e desce até à 15."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela direita no primeiro diamante, depois a cabeceira, depois a tabela esquerda depois do segundo diamante, e desce até a 15."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правый борт у первой метки, затем верхний борт, затем левый борт за второй меткой и вниз на 15."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右库第一个星点，然后头库，然后左库第二个星点之后，再下来打 15 号球。"
          }
        }
      }
    },
