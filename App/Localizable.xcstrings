    "Your stroke, with its sideways wander drawn four times larger.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربتك، مع رسم انحرافها الجانبي أكبر بأربع مرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Stoß, die seitliche Abweichung viermal größer gezeichnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu golpe, con su desvío lateral dibujado cuatro veces más grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton coup, avec son écart latéral dessiné quatre fois plus grand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo colpo, con la deviazione laterale disegnata quattro volte più grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのストローク。横のぶれは4倍に拡大して描いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 스트로크예요. 옆으로 흔들린 정도는 네 배로 크게 그렸어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua tacada, com o desvio lateral desenhado quatro vezes maior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua tacada, com o desvio lateral desenhado quatro vezes maior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой удар; отклонение в сторону показано в четыре раза крупнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的出杆，横向偏移放大四倍显示。"
          }
        }
      }
    },
