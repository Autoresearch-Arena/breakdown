            "value": "Der schwarze Pin ist gefallen: die ganze Punktzahl ist verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cayó el palito negro: se pierde toda la puntuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La quille noire est tombée : tout le score est perdu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È caduto il birillo nero: si perde tutto il punteggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黒いピンが倒れました。得点がすべて失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검은 핀이 쓰러졌습니다: 점수를 모두 잃습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pino preto caiu: perde-se toda a pontuação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pino preto caiu: toda a pontuação é perdida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чёрная кегля упала: весь счёт сгорает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑柱倒了：全部得分作废。"
          }
        }
      }
    },
    "The black peg went down; there was no score to lose.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سقط الوتد الأسود؛ لم تكن هناك نتيجة لتُخسر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der schwarze Pilz fiel; es gab keine Punkte zu verlieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cayó la seta negra; no había puntuación que perder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le champignon noir est tombé ; il n’y avait aucun score à perdre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È caduto il funghetto nero; non c’era punteggio da perdere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黒いペグが倒れましたが、失う得点はありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검은 말뚝이 쓰러졌지만, 잃을 점수가 없었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Caiu o pino preto; não havia pontuação a perder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caiu o pino preto; não havia pontuação a perder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чёрный грибок упал; терять было нечего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑色木桩倒了；没有可失去的分数。"
          }
        }
      }
    },
    "The break": {
      "localizations": {
        "ar": {
          "stringUnit": {
