        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームを終了する？保存されず、戦績にも数えない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임을 끝낼까? 저장되지 않고 기록에도 들어가지 않아."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar este jogo? Não fica guardado e não conta para o teu registo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerrar este jogo? Ele não será salvo e não conta no seu histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закончить эту игру? Она не сохранится и не войдёт в твою статистику."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束这局吗？它不会被保存，也不计入你的战绩。"
          }
        }
      }
    },
