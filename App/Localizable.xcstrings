    "Take off %@ percent to reach the marked band.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنقص %@ بالمئة لتصل إلى النطاق المحدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm %@ Prozent weg, um den markierten Bereich zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja %@ por ciento para llegar a la franja marcada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire %@ pour cent pour atteindre la bande marquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli il %@ per cento per arrivare alla fascia segnata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マークした帯まで、あと%@パーセント下げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 구간까지 %@퍼센트 내려요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira %@ por cento para chegar à faixa marcada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diminua %@ por cento para chegar à faixa marcada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убавь %@ %%, чтобы попасть в отмеченную полосу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再减百分之%@即可进入标记区。"
          }
        }
      }
    },
