          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを構えている赤球を突こう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐가 겨누고 있는 빨간 공을 쳐."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Joga a vermelha para onde o taco aponta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue a vermelha para onde o taco aponta."
          }
        },
        "ru": {
