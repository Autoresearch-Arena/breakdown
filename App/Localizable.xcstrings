    "angle in ≈ angle out  (cushion grip and spin bend it a few degrees)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زاوية الدخول ≈ زاوية الخروج  (إمساك الوسادة واللف يحرفانها بضع درجات)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
