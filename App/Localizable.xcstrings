          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "angolo in entrata ≈ angolo in uscita  (la presa della sponda e l'effetto lo piegano di pochi gradi)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入射角 ≈ 反射角  (クッションの摩擦と回転で数度ずれます)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입사각 ≈ 반사각  (쿠션 마찰과 회전이 몇 도 휘게 합니다)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ângulo de entrada ≈ ângulo de saída  (o atrito da tabela e o efeito desviam alguns graus)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ângulo de entrada ≈ ângulo de saída  (o atrito da tabela e o efeito desviam alguns graus)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "угол падения ≈ угол отражения  (сцепление борта и вращение отклоняют его на несколько градусов)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入射角 ≈ 反射角（库边的摩擦和旋转会使其偏转几度）"
          }
        }
      }
    },
