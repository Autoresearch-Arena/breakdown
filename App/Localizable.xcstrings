    "Practice: three scored tries are used up, so this one isn't kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرين: استُنفدت المحاولات الثلاث المحسوبة، فلا تُحفظ هذه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übung: Die drei gewerteten Versuche sind aufgebraucht, also wird dieser nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Práctica: ya usaste los tres intentos que puntúan, así que este no se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraînement : les trois essais notés sont épuisés, donc celui-ci n'est pas gardé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenamento: i tre tentativi a punteggio sono finiti, quindi questo non viene salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習：採点される3回を使い切ったので、これは記録されない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습: 점수가 남는 세 번을 다 써서 이번 건 저장되지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treino: já usaste as três tentativas que contam, por isso esta não fica guardada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Treino: as três tentativas que contam já foram usadas, então esta não é salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировка: три зачётные попытки уже использованы, эта не сохраняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习：三次计分机会已用完，这次不会保存。"
          }
        }
      }
    },
