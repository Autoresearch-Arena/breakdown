          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击打左上：左塞高杆。"
          }
        }
      }
    },
    "Strike high and right: follow with right side.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضرب أعلى ويميناً: دفع مع لف يميني."
          }
        },
        "de": {
