            "value": "Переходят по разобранным моментам удара вперёд или назад."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前后逐一浏览击球中被讲解的时刻。"
          }
        }
      }
    },
