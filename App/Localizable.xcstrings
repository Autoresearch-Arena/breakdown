          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它滚着撞过来。"
          }
        }
      }
    },
    "It came in sliding, with almost no spin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت منزلقة، تقريباً بلا دوران."
