    "Cloth: %@. Sliding friction %@, standard %@. Rolling resistance %@, standard %@. A ball rolling straight into a rail at %@ metres per second keeps %lld percent of its speed, standard %lld percent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجوخ: %1$@. احتكاك الانزلاق %2$@، والقياسي %3$@. مقاومة التدحرج %4$@، والقياسية %5$@. الكرة التي تتدحرج مباشرةً نحو الحافة بسرعة %6$@ متر في الثانية تحتفظ بـ%7$lld في المئة من سرعتها، والقياسية %8$lld في المئة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuch: %1$@. Gleitreibung %2$@, Standard %3$@. Rollwiderstand %4$@, Standard %5$@. Eine Kugel, die mit %6$@ Metern pro Sekunde gerade in eine Bande rollt, behält %7$lld Prozent ihres Tempos, Standard %8$lld Prozent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paño: %1$@. Fricción de deslizamiento %2$@, estándar %3$@. Resistencia a la rodadura %4$@, estándar %5$@. Una bola que rueda recta contra una banda a %6$@ metros por segundo conserva el %7$lld por ciento de su velocidad, estándar %8$lld por ciento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapis : %1$@. Friction de glissement %2$@, standard %3$@. Résistance au roulement %4$@, standard %5$@. Une bille qui roule droit dans une bande à %6$@ mètres par seconde garde %7$lld pour cent de sa vitesse, standard %8$lld pour cent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Panno: %1$@. Attrito radente %2$@, standard %3$@. Resistenza al rotolamento %4$@, standard %5$@. Una palla che rotola dritta contro una sponda a %6$@ metri al secondo mantiene il %7$lld per cento della sua velocità, standard %8$lld per cento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラシャ：%1$@。滑り摩擦%2$@、標準%3$@。転がり抵抗%4$@、標準%5$@。秒速%6$@メートルでクッションにまっすぐ転がり込んだ球は速さの%7$lldパーセントを保ち、標準は%8$lldパーセントです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천: %1$@. 미끄럼 마찰 %2$@, 표준 %3$@. 구름 저항 %4$@, 표준 %5$@. 초속 %6$@미터로 쿠션에 똑바로 굴러 들어간 공은 속도의 %7$lld퍼센트를 유지하고, 표준은 %8$lld퍼센트입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano: %1$@. Atrito de deslizamento %2$@, padrão %3$@. Resistência ao rolamento %4$@, padrão %5$@. Uma bola que rola direita contra uma tabela a %6$@ metros por segundo mantém %7$lld por cento da velocidade, padrão %8$lld por cento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano: %1$@. Atrito de deslizamento %2$@, padrão %3$@. Resistência ao rolamento %4$@, padrão %5$@. Uma bola que rola reto contra uma tabela a %6$@ metros por segundo mantém %7$lld por cento da velocidade, padrão %8$lld por cento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сукно: %1$@. Трение скольжения %2$@, стандарт %3$@. Сопротивление качению %4$@, стандарт %5$@. Шар, который катится прямо в борт со скоростью %6$@ метров в секунду, сохраняет %7$lld процентов скорости, стандарт %8$lld процентов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "台呢：%1$@。滑动摩擦 %2$@，标准 %3$@。滚动阻力 %4$@，标准 %5$@。以每秒 %6$@ 米笔直滚向库边的球保留百分之%7$lld的速度，标准为百分之%8$lld。"
          }
        }
      }
    },
