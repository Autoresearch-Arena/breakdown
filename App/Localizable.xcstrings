    "Opens the aiming controls with the call you made": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح أدوات التصويب بالإعلان الذي اخترته"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Zielsteuerung mit deiner Ansage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los controles de puntería con lo que cantaste"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les commandes de visée avec ton annonce"
          }
        },
        "it": {
