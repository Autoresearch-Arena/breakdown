    "This time the cue ball stayed out of the pocket.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المرة لم تدخل الكرة البيضاء الجيب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesmal blieb die weiße Kugel außerhalb der Tasche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vez la bola blanca no entró en la tronera."
          }
        },
        "fr": {
          "stringUnit": {
