            "state": "translated",
            "value": "Activé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켬"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligado"
          }
        },
        "pt-BR": {
          "stringUnit": {
