        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois fautes de suite par le même joueur font perdre la partie. Le jeu te prévient après la deuxième."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre falli di fila dello stesso giocatore fanno perdere la partita. Il gioco ti avvisa dopo il secondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じプレイヤーが3回続けてファウルすると負けです。2回目の後に警告が出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 플레이어가 파울을 세 번 연속하면 패배합니다. 두 번째 뒤에 경고가 나옵니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Três faltas seguidas do mesmo jogador perdem a partida. O jogo avisa depois da segunda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três faltas seguidas do mesmo jogador perdem a partida. O jogo avisa depois da segunda."
          }
        },
        "ru": {
          "stringUnit": {
