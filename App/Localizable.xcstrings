    "Calls a safety: no ball, just a legal hit that leaves your opponent hooked": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعلن دفاعاً: بلا كرة، مجرد ضربة قانونية تترك خصمك محاصراً"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt Safety an: keine Kugel, nur ein gültiger Treffer, der deinen Gegner gesnookert lässt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canta seguridad: sin bola, solo un golpe legal que deja tapado a tu rival"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonce une sécurité : pas de bille, juste une touche valable qui laisse ton adversaire coincé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiama difesa: nessuna palla, solo un colpo valido che lascia l'avversario coperto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーフティを宣言：球は狙わず、相手をスヌーカーにする反則なしの一打"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세이프티 선언: 공 없이, 상대를 막히게 하는 정당한 타구만"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuncia defesa: sem bola, só um toque legal que deixa o adversário tapado"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuncia defesa: sem bola, só um toque legal que deixa o adversário tapado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказывает отыгрыш: без шара, просто удар по правилам, после которого соперник закрыт"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "叫防守：不叫球，只打一杆合法球让对手被卡住"
          }
        }
      }
    },
