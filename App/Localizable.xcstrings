    "Aim the cut on the 5 into the side as if the 11 weren't there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوّب قطع الكرة 5 إلى الجيب الجانبي كأن الكرة 11 غير موجودة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel den Schnitt auf die 5 in die Mitteltasche, als wäre die 11 nicht da."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta el corte de la 5 a la lateral como si la 11 no estuviera."
          }
        },
