    "Aim at nearest ball": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوّب نحو أقرب كرة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf nächste Kugel zielen"
          }
        },
        "es": {
