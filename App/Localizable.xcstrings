          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua bola tocou 1 tabela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua bola tocou 1 tabela."
          }
        },
        "ru": {
          "stringUnit": {
