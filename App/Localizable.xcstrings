            "value": "Una nuova distanza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい距離"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 거리"
          }
        },
        "pt": {
          "stringUnit": {
