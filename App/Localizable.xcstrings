    "Jump the 6 and pot the 11 in the top-right corner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقفز فوق الكرة 6 وأدخل الكرة 11 في الزاوية العلوية اليمنى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über die 6 springen und die 11 in die obere rechte Ecke versenken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta la 6 y mete la 11 en la esquina de arriba a la derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saute la 6 et rentre la 11 dans le coin en haut à droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta la 6 e metti in buca la 11 nell'angolo in alto a destra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6番を飛び越えて、11番を右上のコーナーに落とそう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "6번을 뛰어넘어 11번을 오른쪽 위 코너에 넣으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta a 6 e encaçapa a 11 no canto superior direito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salte a 6 e encaçape a 11 no canto superior direito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перепрыгни 6 и загони 11 в правый верхний угол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过6号球，把11号球打进右上角袋口。"
          }
        }
      }
    },
