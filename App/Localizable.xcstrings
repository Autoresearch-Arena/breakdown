    "Use the actions to move it. Up is toward the foot of the table, seen from the head end.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الإجراءات لتحريكها. الأعلى باتجاه قدم الطاولة كما يُرى من طرف البداية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebe sie mit den Aktionen. Oben ist Richtung Fußende, vom Kopfende aus gesehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las acciones para moverla. Arriba es hacia el pie de la mesa, visto desde la cabecera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise les actions pour la déplacer. Le haut va vers le pied de la table, vu depuis la tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa le azioni per spostarla. Su è verso il fondo del tavolo, vista dalla testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションで動かします。上はヘッド側から見て台のフット側です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작으로 옮기세요. 위쪽은 헤드 쪽에서 볼 때 테이블의 풋 쪽입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as ações para a mover. Para cima é em direção ao fundo da mesa, visto da cabeceira."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as ações para movê-la. Para cima é em direção ao pé da mesa, visto da cabeceira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещай его действиями. Вверх — к дальнему концу стола, если смотреть со стороны дома."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用操作来移动它。从开球端看，向上是朝台尾方向。"
          }
        }
      }
    },
