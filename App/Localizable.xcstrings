    "%@ reaches the hole at %@ m/s, too fast to drop: it is across before gravity can pull it far enough down to catch the far edge, and it carries on at %@ m/s.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ تصل إلى الفتحة بسرعة %@ m/s، أسرع من أن تسقط: تعبرها قبل أن تسحبها الجاذبية إلى أسفل بما يكفي لتعلق بالحافة البعيدة، وتواصل بسرعة %@ m/s."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erreicht das Loch mit %@ m/s, zu schnell zum Fallen: Sie ist hinüber, bevor die Schwerkraft sie tief genug ziehen kann, um an der anderen Kante hängen zu bleiben, und läuft mit %@ m/s weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ llega al agujero a %@ m/s, demasiado rápida para caer: lo cruza antes de que la gravedad la baje lo suficiente para engancharse en el borde opuesto, y sigue a %@ m/s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arrive au trou à %@ m/s, trop vite pour tomber : elle l'a traversé avant que la gravité l'ait assez fait descendre pour accrocher le bord opposé, et elle continue à %@ m/s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arriva alla buca a %@ m/s, troppo veloce per cadere: la attraversa prima che la gravità la tiri giù abbastanza da agganciare il bordo opposto, e prosegue a %@ m/s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は%@ m/sで穴に来ましたが、速すぎて落ちません。重力が向こう側の縁に引っかかるほど引き下げる前に渡りきってしまい、%@ m/sで進み続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)가 %@ m/s로 구멍에 이르지만 너무 빨라 떨어지지 않습니다. 중력이 반대편 가장자리에 걸릴 만큼 끌어내리기 전에 건너가 버리고, %@ m/s로 계속 굴러갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chega ao buraco a %@ m/s, rápida demais para cair: atravessa-o antes de a gravidade a puxar o suficiente para prender na borda oposta, e continua a %@ m/s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chega à caçapa a %@ m/s, rápida demais para cair: ela atravessa antes que a gravidade a puxe o suficiente para prender na borda oposta, e segue a %@ m/s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ подходит к лузе на скорости %@ m/s — слишком быстро, чтобы упасть: шар пересекает её раньше, чем сила тяжести опустит его достаточно, чтобы зацепиться за дальний край, и катится дальше на %@ m/s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以 %@ m/s 的速度来到洞口，太快了掉不进去：重力还没把它拉低到能卡住对面边缘，它就已经越过去了，然后以 %@ m/s 继续前进。"
          }
        }
      }
    },
    "%@ sails over the cushion %@ cm above the cloth at %@ m/s and leaves the table.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ تطير فوق الحافة على ارتفاع %2$@ cm فوق الجوخ بسرعة %3$@ m/s وتغادر الطاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fliegt %2$@ cm über dem Tuch mit %3$@ m/s über die Bande und verlässt den Tisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pasa volando sobre la banda a %2$@ cm del paño, a %3$@ m/s, y sale de la mesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ passe au-dessus de la bande à %2$@ cm du tapis, à %3$@ m/s, et quitte la table."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vola sopra la sponda a %2$@ cm dal panno, a %3$@ m/s, ed esce dal tavolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はラシャから%2$@ cmの高さで%3$@ m/sのままクッションを越え、台の外へ出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(이)가 천에서 %2$@ cm 높이로 %3$@ m/s의 속도로 쿠션을 넘어 당구대 밖으로 나갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ passa a voar por cima da tabela a %2$@ cm do pano, a %3$@ m/s, e sai da mesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ passa voando por cima da tabela a %2$@ cm do pano, a %3$@ m/s, e sai da mesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ пролетает над бортом в %2$@ cm над сукном на скорости %3$@ m/s и покидает стол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在离台呢 %2$@ cm 的高度、以 %3$@ m/s 飞过库边，离开了球台。"
          }
        }
      }
    },
