    "each contact passes the push along the line of centres:  v′ = v · cos θ": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند كل تلامس ينتقل الدفع على طول خط المركزين:  v′ = v · cos θ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "bei jedem Kontakt wird der Stoß entlang der Mittellinie weitergegeben:  v′ = v · cos θ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cada contacto transmite el empuje a lo largo de la línea de centros:  v′ = v · cos θ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "à chaque contact, la poussée passe le long de la ligne des centres :  v′ = v · cos θ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "a ogni contatto la spinta passa lungo la linea dei centri:  v′ = v · cos θ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接触のたびに、押す速さは二つの中心を結ぶ線に沿って伝わります:  v′ = v · cos θ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접촉할 때마다 밀어내는 힘은 두 중심을 잇는 선을 따라 전달됩니다:  v′ = v · cos θ"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "a cada contato, o empurrão passa ao longo da linha dos centros:  v′ = v · cos θ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "a cada contato, o impulso passa ao longo da linha dos centros:  v′ = v · cos θ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "при каждом касании толчок передаётся вдоль линии центров:  v′ = v · cos θ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
