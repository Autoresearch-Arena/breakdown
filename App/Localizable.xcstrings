        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번에는 큐볼이 포켓에 들어가지 않았습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desta vez a bola branca ficou fora da caçapa."
          }
        },
        "pt-BR": {
