            "state": "translated",
            "value": "你犯规时打进了 8 号球"
          }
        }
      }
    },
    "You pocketed the 8 too early": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخلت الكرة 8 مبكراً"
          }
        },
        "de": {
