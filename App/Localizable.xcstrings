    "Raise the cue almost straight up and the cue ball bends around a ball in its way.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع العصا تقريباً إلى الأعلى عمودياً، فتنحني الكرة البيضاء حول كرة تعترض طريقها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb die Queue fast senkrecht, und die weiße Kugel biegt um eine Kugel auf ihrem Weg herum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta el taco casi en vertical y la bola blanca se curva alrededor de una bola que le estorba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève la queue presque à la verticale et la bille blanche contourne une bille qui se trouve sur sa route."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza la stecca quasi in verticale e la palla bianca gira intorno a una palla che le sta davanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューをほぼ真上に立てると、手球は進路にある球を避けて曲がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 거의 수직으로 세우면, 큐볼이 앞을 막는 공을 돌아서 휘어 갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta o taco quase na vertical e a bola branca faz uma curva à volta de uma bola que esteja no caminho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante o taco quase na vertical e a bola branca faz uma curva ao redor de uma bola que esteja no caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подними кий почти вертикально, и белый шар обогнёт шар, мешающий на пути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把球杆几乎竖直抬起，白球就会绕过挡路的球弯曲前进。"
          }
        }
      }
    },
    "Raise the cue to jump or curve the cue ball": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع العصا لتقفز بالكرة البيضاء أو تحنيها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb das Queue an, um die Weiße springen oder kurven zu lassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva el taco para hacer saltar o curvar la blanca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève la queue pour faire sauter ou courber la blanche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza la stecca per far saltare o curvare la bianca"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを上げて手球をジャンプさせたり曲げたりする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 들어 큐볼을 점프시키거나 휘게 하세요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta o taco para fazer a branca saltar ou curvar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante o taco para fazer a branca pular ou curvar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подними кий, чтобы биток прыгнул или пошёл по дуге"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬起球杆，让母球跳起或走弧线"
          }
        }
      }
    },
