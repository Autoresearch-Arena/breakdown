    "You hit it too %@. Aim %@ %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربتها أكثر من اللازم %@. صوّب %@ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast sie zu %@ getroffen. Ziele %@ %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpeaste demasiado %@. Apunta %@ hacia la %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as frappé trop %@. Vise %@ à %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai colpito troppo %@. Mira %@ a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@当てすぎました。%@%@を狙いましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 %@ 맞혔어요. %@ %@ 조준하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateste com corte demasiado %@. Mira %@ %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateu com corte muito %@. Mire %@ %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удар вышел %@ нужного. Целься %@ %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你击得太%@了。瞄准时%@%@一些。"
          }
        }
      }
    },
    "You pocketed the 8 on a foul": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخلت الكرة 8 مع خطأ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die 8 mit einem Foul versenkt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metiste la 8 con falta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as rentré la 8 sur une faute"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai imbucato la 8 con un fallo"
          }
        },
        "ja": {
