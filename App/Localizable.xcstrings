    "Practise on your own, or play eight-ball or nine-ball with a friend or the computer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرّب وحدك، أو العب الكرة ٨ أو الكرة ٩ مع صديق أو ضد الكمبيوتر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe allein oder spiele 8-Ball oder 9-Ball mit Freunden oder gegen den Computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica solo, o juega a bola 8 o bola 9 con un amigo o contra el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîne-toi seul, ou joue à la 8 ou à la 9 avec un ami ou contre l'ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenati da solo, oppure gioca a palla 8 o palla 9 con un amico o contro il computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとりで練習するか、友だちやコンピューターとエイトボールやナインボールを。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혼자 연습하거나, 친구나 컴퓨터와 에잇볼이나 나인볼을 하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treina sozinho, ou joga bola 8 ou bola 9 com um amigo ou contra o computador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Treine sozinho, ou jogue bola 8 ou bola 9 com um amigo ou contra o computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренируйся в одиночку или играй в восьмёрку или девятку с другом или против компьютера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独自练习，或与朋友或电脑打八球、九球。"
          }
        }
      }
    },
