    "Bank the 5 off the far cushion into the marked side pocket.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتدّ الكرة 5 عن الوسادة البعيدة إلى الجيب الجانبي المحدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel die 5 über die gegenüberliegende Bande in die markierte Seitentasche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz rebotar la 5 en la banda del fondo hasta la tronera lateral marcada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais rebondir la 5 sur la bande du fond jusque dans la poche latérale indiquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai sponda con la 5 sulla sponda opposta nella buca laterale segnata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "奥のクッションから5番をバンクさせ、示されたサイドポケットに入れましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반대편 쿠션에서 5번을 튕겨, 표시된 사이드 포켓에 넣으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaçape a 5 pela tabela do fundo na caçapa lateral marcada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaçape a 5 pela tabela do fundo na caçapa lateral marcada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отыграйте 5-й от дальнего борта в нужную боковую лузу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让5号球从远端库边翻入指定的边袋。"
          }
        }
      }
    },
