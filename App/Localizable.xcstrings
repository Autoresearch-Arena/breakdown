    "%@ was moving at %@ m/s. Energy handed off: %@ percent goes to %@, %@ percent stays, and the rest is lost as heat and sound.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كانت %@ تتحرك بسرعة %@ m/s. انتقال الطاقة: %@ في المئة تذهب إلى %@، و%@ في المئة تبقى، والباقي يضيع على شكل حرارة وصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bewegte sich mit %@ m/s. Übertragene Energie: %@ Prozent gehen an %@, %@ Prozent bleiben, und der Rest geht als Wärme und Schall verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se movía a %@ m/s. Energía transferida: el %@ por ciento pasa a %@, el %@ por ciento se queda, y el resto se pierde como calor y sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se déplaçait à %@ m/s. Énergie transmise : %@ pour cent passe à %@, %@ pour cent reste, et le reste se perd en chaleur et en son."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si muoveva a %@ m/s. Energia trasferita: il %@ per cento va a %@, il %@ per cento resta, e il resto si perde come calore e suono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は%@ m/sで動いていました。エネルギーの受け渡し：%@%は%@へ、%@%は残り、残りは熱と音として失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(은)는 %@ m/s로 움직이고 있었습니다. 에너지 전달: %@%는 %@에게, %@%는 그대로 남고, 나머지는 열과 소리로 사라집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se movia a %@ m/s. Energia transferida: %@ por cento vai para %@, %@ por cento fica, e o resto se perde como calor e som."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se movia a %@ m/s. Energia transferida: %@ por cento vai para %@, %@ por cento fica, e o resto se perde como calor e som."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ двигался со скоростью %@ m/s. Передача энергии: %@ процентов уходит к %@, %@ процентов остаётся, а остальное теряется в виде тепла и звука."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以 %@ m/s 的速度运动。能量转移：百分之%@ 传给%@，百分之%@ 留在原处，其余以热和声音的形式散失。"
          }
        }
      }
    },
    "%@ was wedged against the rubber, bouncing in place in bounces too small to see. It is brought to rest, and the %@ millijoules those bounces would have turned into heat are taken out at once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ انحشرت عند المطاط، ترتدّ في مكانها ارتدادات أصغر من أن تُرى. تُوقَف في مكانها، وتُنزع دفعةً واحدة الـ%@ ملي جول التي كانت تلك الارتدادات ستحوّلها إلى حرارة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ war am Gummi eingeklemmt und sprang auf der Stelle hin und her, zu klein, um es zu sehen. Sie wird zur Ruhe gebracht, und die %@ Millijoule, die diese Sprünge in Wärme verwandelt hätten, werden auf einmal herausgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quedó encajada contra la goma, rebotando en el sitio con rebotes demasiado pequeños para verse. Se deja en reposo, y los %@ milijulios que esos rebotes habrían convertido en calor se retiran de una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ était coincée contre le caoutchouc et rebondissait sur place en rebonds trop petits pour être vus. Elle est immobilisée, et les %@ millijoules que ces rebonds auraient changés en chaleur sont retirés d'un coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ era incastrata contro la gomma e rimbalzava sul posto con rimbalzi troppo piccoli per vederli. Viene fermata, e i %@ millijoule che quei rimbalzi avrebbero trasformato in calore vengono tolti in un colpo solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はゴムに挟まり、目に見えないほど小さな跳ね返りをその場で繰り返していました。静止させ、その跳ね返りが熱に変えるはずだった%@ミリジュールを一度に取り除きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)가 고무에 끼어, 눈에 보이지 않을 만큼 작은 튕김을 제자리에서 반복하고 있었습니다. 멈추게 하고, 그 튕김이 열로 바꿨을 %@밀리줄을 한꺼번에 덜어 냅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ficou encravada contra a borracha, a ressaltar no mesmo sítio em ressaltos pequenos demais para se verem. É posta em repouso, e os %@ milijoules que esses ressaltos teriam transformado em calor são retirados de uma vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ficou presa contra a borracha, quicando no lugar em quiques pequenos demais para ver. Ela é colocada em repouso, e os %@ milijoules que esses quiques teriam virado calor são retirados de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ зажат у резины и подпрыгивает на месте так мелко, что этого не видно. Его останавливают, а %@ миллиджоулей, которые эти отскоки превратили бы в тепло, убирают сразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 卡在橡胶边上，原地做着小到看不见的反弹。它被直接停下，那些反弹本会变成热量的 %@ 毫焦能量被一次性扣除。"
          }
        }
      }
    },
    "%@ was wedged against the rubber, bouncing in place in bounces too small to see. It is brought to rest, and the %@ those bounces would have turned into heat are taken out at once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ انحشرت عند المطاط، ترتدّ في مكانها ارتدادات أصغر من أن تُرى. تُوقَف في مكانها، وتُنزع دفعةً واحدة الطاقة التي كانت تلك الارتدادات ستحوّلها إلى حرارة (%2$@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ war am Gummi eingeklemmt und sprang auf der Stelle hin und her, zu klein, um es zu sehen. Sie wird zur Ruhe gebracht, und die %2$@, die diese Sprünge in Wärme verwandelt hätten, werden auf einmal herausgenommen."
