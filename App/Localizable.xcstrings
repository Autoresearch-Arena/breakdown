            "state": "translated",
            "value": "Deine Kugel lief über 1 Bande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu bola tocó 1 banda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bille a touché 1 bande."
          }
        },
        "it": {
          "stringUnit": {
