          }
        }
      }
    },
    "You changed the cue's angle only slightly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّرت زاوية العصا قليلًا جدًا فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Winkel des Queues nur ganz leicht verändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiaste el ángulo del taco solo un poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as changé l'angle de la queue que très légèrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai cambiato l'angolo della stecca solo di pochissimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューの角度はほんの少ししか変えていない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐 각도를 아주 조금만 바꿨다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudaste o ângulo do taco só ligeiramente."
          }
        },
        "pt-BR": {
