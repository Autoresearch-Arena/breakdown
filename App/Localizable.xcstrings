            "value": "Ora guarda cosa fa il tavolo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "では、テーブルで何が起きているか見てみましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 테이블에서 무슨 일이 일어나는지 보세요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
