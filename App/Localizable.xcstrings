    "Skips to the end of the shot so the ruling comes at once": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتقل إلى نهاية الضربة ليظهر القرار فورًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springt ans Ende des Stoßes, damit die Entscheidung sofort kommt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta al final del tiro para ver la decisión enseguida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe à la fin du coup pour avoir la décision tout de suite"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta alla fine del tiro così la decisione arriva subito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショットの最後まで飛ばして、すぐに判定を出す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샷의 끝으로 건너뛰어 판정을 바로 보여줘"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta para o fim da jogada para a decisão chegar já"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pula para o fim da jogada para a decisão aparecer na hora"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переходит к концу удара, чтобы решение появилось сразу"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳到这一杆的结尾，立即给出判定"
          }
        }
      }
    },
    "Skips to where the balls stop.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقفز إلى حيث تتوقف الكرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springt dorthin, wo die Kugeln liegen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta al momento en que se paran las bolas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saute jusqu'à l'arrêt des billes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta a quando le palle si fermano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "球が止まるところまで飛ばします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공이 멈추는 곳으로 건너뛰어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta para quando as bolas param."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pula para quando as bolas param."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перематывает до остановки шаров."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳到球停下的时刻。"
          }
        }
      }
    },
    "Slick cloth: draw and curves take late, and balls run long.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قماش زلق: السحب والانحناء يتأخران، والكرات تجري بعيداً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glattes Tuch: Rückzug und Kurven greifen spät, und Kugeln laufen weit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paño resbaladizo: el retroceso y las curvas tardan en agarrar, y las bolas corren largo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapis glissant : le rétro et les courbes prennent tard, et les billes vont loin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Panno scivoloso: indietro e curve prendono tardi, e le palle corrono lunghe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "滑りやすいクロス：引き球もカーブも効きが遅く、球はよく走る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미끄러운 천: 드로우와 커브가 늦게 먹고, 공이 길게 굴러요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano escorregadio: o recuo e as curvas pegam tarde, e as bolas correm muito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano escorregadio: o recuo e as curvas pegam tarde, e as bolas correm muito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скользкое сукно: оттяжка и изгиб срабатывают поздно, шары катятся далеко."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑台呢：低杆和弧线吃得晚，球跑得远。"
          }
        }
      }
    },
