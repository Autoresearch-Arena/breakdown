    "Raised steeply, about 53 degrees. Hit down through the centre with a short punch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرفوعة بحدة، نحو 53 درجة. اضرب للأسفل عبر المركز بلكمة قصيرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steil angehoben, etwa 53 Grad. Kurz und knackig durch die Mitte nach unten stoßen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muy elevado, unos 53 grados. Golpea hacia abajo por el centro con un toque corto y seco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien levée, environ 53 degrés. Frappe vers le bas au centre d'un coup sec et court."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molto alzata, circa 53 gradi. Colpisci verso il basso al centro con un colpo corto e secco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急角度、約53度。中心を下へ短く突く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가파르게 약 53도. 중심을 아래로 짧게 찍어 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem levantado, uns 53 graus. Bate para baixo pelo centro com um toque curto e seco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem levantado, uns 53 graus. Bata para baixo pelo centro com um toque curto e seco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Круто, примерно 53 градуса. Короткий тычок вниз через центр."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大角度抬杆，约 53 度。短促有力地向下击打中心。"
          }
        }
      }
    },
    "Raised to about 24 degrees, with full left side.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرفوعة إلى نحو 24 درجة، مع لف يساري كامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf etwa 24 Grad angehoben, mit vollem Linkseffet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevado a unos 24 grados, con todo el efecto a la izquierda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Levée à environ 24 degrés, avec plein effet à gauche."
          }
