          }
        }
      }
    },
    "Three balls, one line, the 7 down.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاث كرات، خط واحد، والكرة 7 في الجيب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Kugeln, eine Linie, die 7 versenkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres bolas, una línea, la 7 embocada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois billes, une ligne, la 7 empochée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre palle, una linea, la 7 in buca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三つの球、一本の線、7番イン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공 세 개, 일직선, 7번 인."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Três bolas, uma linha, a 7 na caçapa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três bolas, uma linha, a 7 na caçapa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три шара, одна линия, 7-й в лузе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三颗球，一条线，7号球入袋。"
          }
        }
      }
    },
    "Throw It In": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخِلها بالاحتكاك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Reibung rein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meterla a empujones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire rentrer par friction"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spingila dentro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "擦り込んで落とす"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마찰로 밀어 넣기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogar para dentro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogar para dentro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загнать трением"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "借摩擦入袋"
          }
        }
      }
    },
    "Thrown in. Friction did what the angle could not.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُدخلت بالاحتكاك. الاحتكاك فعل ما لم تستطعه الزاوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reingeworfen. Die Reibung hat geschafft, was der Winkel nicht konnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metida. La fricción hizo lo que el ángulo no podía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentrée. Le frottement a fait ce que l'angle ne pouvait pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Messa dentro. L'attrito ha fatto ciò che l'angolo non poteva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじき込んだ。角度では無理だったことを摩擦がやってのけた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튕겨 넣었다. 각도로는 안 되던 것을 마찰이 해냈다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogada para dentro. O atrito fez o que o ângulo não conseguia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogada para dentro. O atrito fez o que o ângulo não conseguia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загнано. Трение сделало то, чего не смог угол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "借摩擦入袋。角度做不到的，摩擦做到了。"
          }
        }
      }
    },
    "Too much draw. Strike a little higher.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السحب زائد. اضرب أعلى قليلاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viel Rückzug. Triff etwas höher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobra retroceso. Golpea un poco más arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de rétro. Frappe un peu plus haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo indietro. Colpisci un po' più in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き玉が強すぎます。少し上を打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드로우가 너무 강해요. 조금 위를 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuo a mais. Bate um pouco mais acima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuo demais. Bata um pouco mais acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оттяжки слишком много. Бей чуть выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低杆太多。击打位置稍微偏上一点。"
          }
        }
      }
    },
    "Too much follow. Strike a little lower.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدفع زائد. اضرب أسفل قليلاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viel Nachlauf. Triff etwas tiefer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobra efecto de avance. Golpea un poco más abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop d'effet avant. Frappe un peu plus bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo avanti. Colpisci un po' più in basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送り玉が強すぎます。少し下を打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로우가 너무 강해요. 조금 아래를 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanço a mais. Bate um pouco mais abaixo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanço demais. Bata um pouco mais abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накат слишком сильный. Бей чуть ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高杆太多。击打位置稍微偏下一点。"
          }
        }
      }
    },
    "Too much pace. Pull back less to hit it softer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القوة زائدة. اسحب للخلف أقل لتضربها بقوة أقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viel Tempo. Zieh weniger zurück, um sanfter zu stoßen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobra potencia. Tira menos hacia atrás para golpear más suave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de puissance. Tire moins vers l'arrière pour frapper plus doucement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppa forza. Tira meno indietro per colpire più piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勢いが強すぎます。引きを少なくして、やわらかく打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "힘이 너무 세요. 덜 당겨서 부드럽게 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Força a mais. Puxa menos para trás para bater mais leve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Força demais. Puxe menos para trás para bater mais leve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много силы. Оттяни меньше, чтобы ударить мягче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "力度太大。往后拉少一些，击得更轻。"
          }
        }
      }
    },
    "Too much side. Strike a little nearer the middle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللف الجانبي زائد. اضرب أقرب إلى المركز قليلاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viel Seitendrall. Triff etwas näher an der Mitte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobra efecto lateral. Golpea un poco más cerca del centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop d'effet latéral. Frappe un peu plus près du centre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo effetto laterale. Colpisci un po' più vicino al centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横回転が強すぎます。もう少し中心寄りを打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆회전이 너무 강해요. 조금 더 가운데를 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Efeito lateral a mais. Bate um pouco mais perto do centro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Efeito lateral demais. Bata um pouco mais perto do centro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Боковое вращение слишком сильное. Бей чуть ближе к центру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧旋太多。击打位置再靠近中心一点。"
          }
        }
      }
    },
    "Topspin keeps driving after the hit. The cue ball glances off the 1 sideways, then its forward spin grips the cloth and bends it on toward the 2.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يواصل اللف الأمامي الدفع بعد الضربة. ترتد الكرة البيضاء عن الكرة 1 جانبياً، ثم يمسك لفها الأمامي باللباد ويحرفها نحو الكرة 2."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obendrall treibt nach dem Stoß weiter. Die weiße Kugel prallt seitlich von der 1 ab, dann greift ihr Vorwärtsdrall am Tuch und lenkt sie weiter zur 2."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El efecto de avance sigue empujando tras el golpe. La bola blanca rebota de lado en la 1, y luego su giro hacia delante agarra el paño y la curva hacia la 2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'effet avant continue de pousser après le coup. La bille blanche ricoche de côté sur la 1, puis son effet avant accroche le tapis et la courbe vers la 2."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'effetto in avanti continua a spingere dopo il colpo. La palla bianca rimbalza di lato sulla 1, poi il suo effetto in avanti fa presa sul panno e la piega verso la 2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "順回転は打った後も手球を押し続けます。手球は1番をかすめて横に逸れ、その後、前へ進む回転が布をつかんで、手球を2番のほうへ曲げていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순회전은 친 뒤에도 공을 계속 밀어 줍니다. 큐볼은 1번을 스치며 옆으로 빠지고, 이어서 앞으로 도는 회전이 천을 붙잡아 2번 쪽으로 휘게 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O efeito de avanço continua a empurrar depois da tacada. A bola branca desvia de lado na 1, e depois o seu efeito para a frente agarra o pano e curva-a em direção à 2."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O efeito de avanço continua empurrando depois da tacada. A bola branca desvia de lado na 1, e depois o efeito para frente agarra o pano e a curva em direção à 2."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После удара верхнее вращение продолжает толкать шар. Белый шар отскакивает от 1-го в сторону, а затем его вращение цепляется за сукно и загибает траекторию к 2-му."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击球后，上旋仍在推动白球前进。白球侧向擦过1号球，随后它的上旋抓住台布，把轨迹带向2号球。"
          }
        }
      }
    },
    "Touching balls rub as they part. Left spin on the cue ball spins the 2, and the friction between the 2 and the 8 drags the 8 off its line and into the pocket.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكرات المتلامسة تحتك عند افتراقها. الدوران الأيسر للكرة البيضاء يُدير الكرة 2، والاحتكاك بين الكرة 2 والكرة 8 يسحب الكرة 8 عن خطها إلى الجيب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sich berührende Kugeln reiben sich beim Auseinanderlaufen. Linksdrall auf der Spielkugel dreht die 2, und die Reibung zwischen 2 und 8 zieht die 8 von ihrer Linie ins Loch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las bolas que se tocan rozan al separarse. El efecto a la izquierda en la bola blanca hace girar la 2, y la fricción entre la 2 y la 8 desvía la 8 de su línea y la mete en la tronera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les billes qui se touchent frottent en se séparant. L'effet à gauche sur la blanche fait tourner la 2, et le frottement entre la 2 et la 8 dévie la 8 de sa trajectoire jusque dans la poche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le palle che si toccano strisciano quando si separano. L'effetto a sinistra sulla bianca fa girare la 2, e l'attrito tra la 2 e la 8 devia la 8 dalla sua linea e la porta in buca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接触している球は離れるときにこすれ合います。手球の左回転が2番を回し、2番と8番の摩擦が8番の進路をずらしてポケットに入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서로 닿은 공은 떨어질 때 마찰합니다. 흰 공의 왼쪽 회전이 2번을 돌리고, 2번과 8번 사이의 마찰이 8번의 진로를 틀어 포켓으로 보냅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bolas encostadas se esfregam ao se separar. O efeito para a esquerda na branca faz a 2 girar, e o atrito entre a 2 e a 8 tira a 8 da linha e para dentro da caçapa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bolas encostadas se esfregam ao se separar. O efeito para a esquerda na branca faz a 2 girar, e o atrito entre a 2 e a 8 tira a 8 da linha e para dentro da caçapa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соприкасающиеся шары трутся, расходясь. Левое вращение биты раскручивает 2, а трение между 2 и 8 сбивает восьмёрку с пути и загоняет в лузу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相互接触的球分开时会摩擦。母球的左旋使2号球转动，2号球与8号球之间的摩擦把8号球带离原来的路线送进袋口。"
          }
        }
      }
    },
