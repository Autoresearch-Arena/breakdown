    "Two balls, one stroke. The topspin did the second half.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرتان، ضربة واحدة. اللف الأمامي أنجز النصف الثاني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Kugeln, ein Stoß. Der Obendrall erledigte den zweiten Teil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos bolas, un solo golpe. El efecto de avance hizo la segunda mitad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux billes, un seul coup. L'effet avant a fait la seconde moitié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due palle, un colpo. L'effetto in avanti ha fatto la seconda parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一打で二つの球。二つ目は順回転が果たしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 치고 공 두 개. 두 번째 몫은 순회전이 해냈어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas bolas, uma tacada. O efeito de avanço fez a segunda parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas bolas, uma tacada. O efeito de avanço fez a segunda metade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два шара одним ударом. Вторую половину сделало верхнее вращение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两颗球，一杆击出。后半段是上旋完成的。"
          }
        }
      }
    },
    "Two-Rail Kick": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الارتداد عن حافتين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zweibanden-Stoß"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebote a dos bandas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebond sur deux bandes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colpo a due sponde"
          }
        },
        "ja": {
