    "End this game? It won't be saved, and it doesn't count in your record.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنهاء هذه اللعبة؟ لن تُحفظ ولن تُحتسب في سجلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Spiel beenden? Es wird nicht gespeichert und zählt nicht für deine Bilanz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Terminar esta partida? No se guardará y no cuenta en tu historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter cette partie ? Elle ne sera pas enregistrée et ne compte pas dans ton bilan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudere questa partita? Non verrà salvata e non conta nel tuo record."
