    "The View menu zooms in and out, and Actual Size shows the whole table again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة العرض تكبّر وتصغّر، والحجم الفعلي يعرض الطاولة كلها من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Menü „Darstellung“ zoomst du hinein und heraus, und „Originalgröße“ zeigt wieder den ganzen Tisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El menú Visualización acerca y aleja, y Tamaño real vuelve a mostrar toda la mesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le menu Présentation zoome en avant et en arrière, et Taille réelle remontre toute la table."
          }
        },
        "it": {
          "stringUnit": {
