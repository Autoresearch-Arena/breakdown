            "value": "Você encaçapou a 8 com falta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты забил 8 с фолом"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你犯规时打进了 8 号球"
          }
        }
      }
    },
    "You pocketed the 8 too early": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخلت الكرة 8 مبكراً"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die 8 zu früh versenkt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metiste la 8 demasiado pronto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as rentré la 8 trop tôt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai imbucato la 8 troppo presto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8番を早く落としすぎた"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8번을 너무 일찍 넣었어요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteste a 8 cedo demais"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você encaçapou a 8 cedo demais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты забил 8 слишком рано"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你太早打进 8 号球"
          }
        }
      }
    },
    "You scored %lld. Your best is still %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّلت %1$lld. ولا تزال أفضل نتيجة لك %2$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$lld Punkte. Dein Rekord bleibt %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has hecho %1$lld. Tu récord sigue siendo %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as marqué %1$lld. Ton record reste %2$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai fatto %1$lld. Il tuo record resta %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "得点は%1$lld点。最高得点は%2$lld点のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld점을 얻었습니다. 최고 점수는 여전히 %2$lld점입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fizeste %1$lld. O teu recorde continua a ser %2$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você fez %1$lld. Seu recorde continua sendo %2$lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой счёт: %1$lld. Рекорд по-прежнему %2$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你得了%1$lld分。最高分仍是%2$lld。"
          }
        }
      }
    },
    "You watched a way out first, so style is capped at 2.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهدت طريقاً للخروج أولاً، فالأسلوب محدود بـ 2."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast zuerst einen Ausweg angeschaut, also ist der Stil auf 2 begrenzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viste primero una salida, así que el estilo queda limitado a 2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as d'abord regardé une sortie, donc le style est plafonné à 2."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai guardato prima una via d'uscita, quindi lo stile vale al massimo 2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に抜け出し方を見たので、スタイル点は2点まで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 빠져나가는 방법을 봐서, 스타일은 최대 2점이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Viste primeiro uma saída, por isso o estilo fica limitado a 2."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você viu uma saída primeiro, então o estilo fica limitado a 2."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты сначала посмотрел выход, поэтому стиль не выше 2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你先看了解法，所以风格分最多 2 分。"
          }
        }
      }
    },
    "You're hooked. Call your ball and pocket, then get out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت محاصر. أعلن كرتك وجيبك، ثم اخرج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist gesnookert. Sag Kugel und Tasche an, dann komm raus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás tapado. Canta tu bola y tu tronera, y sal de ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es coincé. Annonce ta bille et ta poche, puis sors-t'en."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei coperto. Chiama palla e buca, poi tirati fuori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スヌーカー状態。球とポケットを宣言して、抜け出そう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막혔어요. 공과 포켓을 선언하고 빠져나오세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás tapado. Anuncia a bola e a caçapa, e sai daí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está tapado. Anuncie a bola e a caçapa, e saia dessa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты закрыт. Закажи шар и лузу, а потом выбирайся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你被卡住了。叫好球和袋口，然后解围。"
          }
        }
      }
    },
    "You're on solids with two left. The cue ball is far out on the table, and a stripe sits half a diamond in front of it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على المصمتة وبقيت اثنتان. الكرة البيضاء بعيدة على الطاولة، وكرة مخططة تقف أمامها بنصف ماسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spielst die Vollen, zwei sind übrig. Die Weiße liegt weit draußen auf dem Tisch, und eine Halbe liegt einen halben Diamanten davor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas con las lisas y te quedan dos. La blanca está lejos en la mesa, y una rayada está medio diamante delante de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu joues les pleines, il t'en reste deux. La blanche est loin sur la table, et une rayée est à une demi-mouche devant elle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai le piene, te ne restano due. La bianca è lontana sul tavolo, e una spezzata è mezzo diamante davanti a lei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "君はソリッドで残り2つ。手球は台の奥のほうにあり、ストライプが半ポイント手前にある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너는 솔리드고 두 개 남았어요. 큐볼이 테이블 멀리 있고, 스트라이프가 그 앞 반 포인트에 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogas com as lisas e faltam duas. A branca está longe na mesa, e uma listrada está meio diamante à frente dela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você joga com as lisas e faltam duas. A branca está longe na mesa, e uma listrada está meio diamante à frente dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты играешь сплошные, осталось два. Биток далеко на столе, а полосатый стоит на полметки перед ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打全色球，还剩两颗。母球在台面远处，一颗花色球挡在它前方半个星点处。"
          }
        }
      }
    },
    "You're on solids with two left. Your opponent rolled the cue ball dead behind the 8.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على المصمتة وبقيت اثنتان. دحرج خصمك الكرة البيضاء لتتوقف خلف الكرة 8 تماماً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spielst die Vollen, zwei sind übrig. Dein Gegner hat die Weiße genau hinter die 8 gelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas con las lisas y te quedan dos. Tu rival dejó la blanca justo detrás de la 8."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu joues les pleines, il t'en reste deux. Ton adversaire a laissé la blanche pile derrière la 8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai le piene, te ne restano due. L'avversario ha lasciato la bianca proprio dietro la 8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "君はソリッドで残り2つ。相手が手球を8番の真後ろに止めた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너는 솔리드고 두 개 남았어요. 상대가 큐볼을 8번 바로 뒤에 세웠어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogas com as lisas e faltam duas. O teu adversário deixou a branca mesmo atrás da 8."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você joga com as lisas e faltam duas. Seu adversário deixou a branca bem atrás da 8."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты играешь сплошные, осталось два. Соперник оставил биток точно за восьмёркой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打全色球，还剩两颗。对手把母球停在 8 号球正后方。"
          }
        }
      }
    },
    "You're on solids. An opponent ball sits a diamond in front of you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على المصمتة. كرة للخصم تقف على بعد ماسة أمامك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spielst die Vollen. Eine gegnerische Kugel liegt einen Diamanten vor dir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas con las lisas. Una bola rival está a un diamante delante de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu joues les pleines. Une bille adverse est à une mouche devant toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai le piene. Una palla avversaria è a un diamante davanti a te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "君はソリッド。相手の球が1ポイント先にある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너는 솔리드예요. 상대 공이 1포인트 앞에 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogas com as lisas. Uma bola do adversário está a um diamante à tua frente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você joga com as lisas. Uma bola do adversário está a um diamante à sua frente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты играешь сплошные. Шар соперника стоит на одну метку впереди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打全色球。一颗对手的球挡在你前方一个星点处。"
          }
        }
      }
    },
    "You're on solids. The 1 is frozen on the foot rail behind stripes, the 6 is tied up, and you're behind the 8.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على المصمتة. الكرة 1 ملتصقة بحافة القدم خلف المخططة، والكرة 6 محاصرة، وأنت خلف الكرة 8."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spielst die Vollen. Die 1 klebt hinter Halben an der Fußbande, die 6 ist zugestellt, und du bist hinter der 8."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas con las lisas. La 1 está pegada a la banda del pie detrás de rayadas, la 6 está bloqueada y tú estás detrás de la 8."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu joues les pleines. La 1 est collée à la bande du pied derrière des rayées, la 6 est bloquée, et tu es derrière la 8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai le piene. La 1 è attaccata alla sponda di fondo dietro le spezzate, la 6 è bloccata e tu sei dietro la 8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "君はソリッド。1番はストライプの陰でフットクッションに張り付き、6番は詰まっていて、君は8番の後ろ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너는 솔리드예요. 1번은 스트라이프 뒤 풋 쿠션에 붙어 있고, 6번은 막혀 있고, 너는 8번 뒤에 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogas com as lisas. A 1 está colada à tabela do pé atrás de listradas, a 6 está presa, e tu estás atrás da 8."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você joga com as lisas. A 1 está colada na tabela do pé atrás de listradas, a 6 está presa, e você está atrás da 8."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты играешь сплошные. 1 прижат к нижнему борту за полосатыми, 6 зажат, а ты за восьмёркой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打全色球。1 号球贴在脚库、被花色球挡着，6 号球被卡死，你还在 8 号球后面。"
          }
        }
      }
    },
    "You're on stripes. A solid half covers the line to your 15, and the kicks are long.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على المخططة. كرة مصمتة تغطي نصف الخط إلى كرتك 15، والارتدادات طويلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spielst die Halben. Eine Volle verdeckt halb die Linie zu deiner 15, und die Vorbänder sind lang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas con las rayadas. Una lisa tapa media línea hacia tu 15, y los rebotes son largos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu joues les rayées. Une pleine cache à moitié la ligne vers ta 15, et les bricoles sont longues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai le spezzate. Una piena copre metà della linea verso la tua 15, e i rimbalzi sono lunghi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "君はストライプ。ソリッドが15番へのラインを半分ふさぎ、キックは長い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너는 스트라이프예요. 솔리드 하나가 15번으로 가는 길을 반쯤 막고, 킥은 멀어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogas com as listradas. Uma lisa tapa metade da linha para a tua 15, e as tabelas são longas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você joga com as listradas. Uma lisa tapa metade da linha para a sua 15, e as tabelas são longas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты играешь полосатые. Сплошной наполовину закрывает линию на твою 15, а удары через борт длинные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打花色球。一颗全色球挡住了打 15 号球的半条线路，库边解球又都很远。"
          }
        }
      }
    },
    "You're on stripes. Your 10 is frozen to the rail and two solids hide it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على المخططة. كرتك 10 ملتصقة بالحافة وتخفيها كرتان مصمتتان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spielst die Halben. Deine 10 klebt an der Bande, und zwei Volle verdecken sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas con las rayadas. Tu 10 está pegada a la banda y dos lisas la tapan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu joues les rayées. Ta 10 est collée à la bande et deux pleines la cachent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai le spezzate. La tua 10 è attaccata alla sponda e due piene la coprono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "君はストライプ。10番がクッションに張り付き、ソリッド2つに隠れている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너는 스트라이프예요. 네 10번이 쿠션에 붙어 있고 솔리드 두 개가 가리고 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogas com as listradas. A tua 10 está colada à tabela e duas lisas tapam-na."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você joga com as listradas. Sua 10 está colada na tabela e duas lisas a escondem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты играешь полосатые. Твоя 10 прижата к борту, и два сплошных её закрывают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打花色球。你的 10 号球贴着库边，被两颗全色球挡住。"
          }
        }
      }
    },
    "You're on stripes. Your 13 sits a ball off the right rail, just past the side pocket.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على المخططة. كرتك 13 على بعد كرة من الحافة اليمنى، بعد الجيب الجانبي بقليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spielst die Halben. Deine 13 liegt eine Kugel breit vor der rechten Bande, knapp hinter der Mitteltasche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas con las rayadas. Tu 13 está a una bola de la banda derecha, justo pasada la lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu joues les rayées. Ta 13 est à une bille de la bande droite, juste après la poche du milieu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai le spezzate. La tua 13 è a una palla dalla sponda destra, appena oltre la buca centrale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "君はストライプ。13番は右クッションから球1つ分離れ、サイドポケットのすぐ先にある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너는 스트라이프예요. 네 13번은 오른쪽 쿠션에서 공 하나 떨어져 있고, 사이드 포켓 바로 너머에 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogas com as listradas. A tua 13 está a uma bola da tabela direita, logo depois da lateral."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você joga com as listradas. Sua 13 está a uma bola da tabela direita, logo depois da lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты играешь полосатые. Твоя 13 стоит в шаре от правого борта, сразу за средней лузой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打花色球。你的 13 号球离右库一颗球远，就在中袋过去一点。"
          }
        }
      }
    },
    "You're on stripes. Your 9 sits by the head-left corner, and a cluster of solids fills the middle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على المخططة. كرتك 9 عند زاوية الرأس اليسرى، ومجموعة من المصمتة تملأ الوسط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spielst die Halben. Deine 9 liegt bei der linken Kopfecke, und ein Haufen Volle füllt die Mitte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas con las rayadas. Tu 9 está junto a la esquina izquierda de cabecera, y un racimo de lisas llena el centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu joues les rayées. Ta 9 est près du coin gauche de tête, et un paquet de pleines occupe le milieu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai le spezzate. La tua 9 è vicino all'angolo sinistro di testa, e un gruppo di piene riempie il centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "君はストライプ。9番はヘッド左コーナーのそばにあり、ソリッドの固まりが真ん中をふさいでいる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너는 스트라이프예요. 네 9번은 헤드 왼쪽 코너 옆에 있고, 솔리드 뭉치가 가운데를 채우고 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogas com as listradas. A tua 9 está junto ao canto esquerdo da cabeceira, e um monte de lisas enche o meio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você joga com as listradas. Sua 9 está perto do canto esquerdo da cabeceira, e um bolo de lisas enche o meio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты играешь полосатые. Твоя 9 у левого верхнего угла, а середину занимает кучка сплошных."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打花色球。你的 9 号球在头端左角袋旁，一堆全色球塞满了中间。"
          }
        }
      }
    },
    "You're on the 8. It hangs in the jaws of the foot-right corner, and a stripe sits dead in the way.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على الكرة 8. تتدلى في فم زاوية القدم اليمنى، وكرة مخططة تقف في الطريق تماماً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist auf der 8. Sie hängt in der rechten Fußecke, und eine Halbe liegt genau im Weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas por la 8. Cuelga en la boca de la esquina derecha del pie, y una rayada está justo en medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es sur la 8. Elle pend au bord du coin droit du pied, et une rayée est pile sur le chemin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sulla 8. È sull'orlo dell'angolo destro di fondo, e una spezzata è proprio in mezzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残るは8番。フット右コーナーの入口にかかっていて、ストライプが真正面をふさいでいる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8번 차례예요. 풋 오른쪽 코너 입구에 걸려 있고, 스트라이프가 딱 길을 막고 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás na 8. Está à boca do canto direito do pé, e uma listrada está mesmo no caminho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está na 8. Ela está na boca do canto direito do pé, e uma listrada está bem no caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты на 8. Она висит в губках правого нижнего угла, а полосатый стоит прямо на пути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该打 8 号球了。它悬在脚端右角袋口，一颗花色球正好挡在路上。"
          }
        }
      }
    },
    "You're on the 8. Tap it, then the pocket you call. Or call Safety.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على الكرة 8. اضغطها، ثم الجيب الذي تعلنه. أو أعلن دفاعاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist auf der 8. Tippe sie an, dann die Tasche, die du ansagst. Oder sag Safety an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas por la 8. Tócala y luego la tronera que cantas. O canta seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es sur la 8. Touche-la, puis la poche que tu annonces. Ou annonce une sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sulla 8. Toccala, poi la buca che chiami. Oppure chiama difesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残るは8番。8番をタップしてから宣言するポケットを。またはセーフティを宣言。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8번 차례예요. 8번을 탭하고 선언할 포켓을 탭하세요. 아니면 세이프티를 선언하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás na 8. Toca nela e depois na caçapa que anuncias. Ou anuncia defesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está na 8. Toque nela e depois na caçapa que anuncia. Ou anuncie defesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты на 8. Нажми на неё, потом на лузу, которую заказываешь. Или закажи отыгрыш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该打 8 号球了。点它，再点你要叫的袋口。或者叫防守。"
          }
        }
      }
    },
    "You're on your last stripe. The 8 is almost touching the cue ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على آخر كرة مخططة. الكرة 8 تكاد تلامس الكرة البيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist bei deiner letzten Halben. Die 8 berührt fast die Weiße."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te queda tu última rayada. La 8 casi toca la blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il te reste ta dernière rayée. La 8 touche presque la blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti resta l'ultima spezzata. La 8 quasi tocca la bianca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残るストライプはあと1つ。8番が手球にほとんど触れている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 스트라이프 차례예요. 8번이 큐볼에 거의 붙어 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás na tua última listrada. A 8 quase toca na branca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está na sua última listrada. A 8 quase encosta na branca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У тебя последний полосатый. 8 почти касается битка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你只剩最后一颗花色球。8 号球几乎贴着母球。"
          }
        }
      }
    },
    "You've cleared your stripes. The 8 sits off the left rail near the corner, and a solid blocks it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخلت كل المخططة. الكرة 8 قرب الحافة اليسرى بجانب الزاوية، وكرة مصمتة تحجبها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Halben sind weg. Die 8 liegt nahe der linken Bande bei der Ecke, und eine Volle blockt sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya metiste tus rayadas. La 8 está junto a la banda izquierda cerca de la esquina, y una lisa la tapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as rentré tes rayées. La 8 est près de la bande gauche vers le coin, et une pleine la bloque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai finito le spezzate. La 8 è vicino alla sponda sinistra presso l'angolo, e una piena la blocca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストライプは全部落とした。8番は左クッション沿いのコーナー近くにあり、ソリッドが邪魔している。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트라이프를 다 넣었어요. 8번은 왼쪽 쿠션 가까이 코너 옆에 있고, 솔리드가 막고 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já limpaste as listradas. A 8 está junto à tabela esquerda perto do canto, e uma lisa tapa-a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já limpou as listradas. A 8 está perto da tabela esquerda junto ao canto, e uma lisa a bloqueia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты забил все полосатые. 8 стоит у левого борта возле угла, и её закрывает сплошной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的花色球已经清完。8 号球靠近左库角袋附近，被一颗全色球挡住。"
          }
        }
      }
    },
    "Your Shot": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربتك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Stoß"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tiro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton coup"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo tiro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのショット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 샷"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua tacada"
          }
        },
        "pt-BR": {
