    "Firm. Dead bar rails eat speed, so hit harder than it looks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوية. حواف الحانة الميتة تأكل السرعة، فاضرب أقوى مما يبدو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräftig. Tote Kneipenbanden fressen Tempo, also stoß härter, als es aussieht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firme. Las bandas muertas de bar se comen la velocidad, así que pega más fuerte de lo que parece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyé. Les bandes mortes de bar mangent la vitesse, alors tape plus fort qu'il n'y paraît."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Deciso. Le sponde morte da bar mangiano velocità, quindi colpisci più forte di quanto sembri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強め。バーの死んだクッションはスピードを食うので、見た目より強く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단단하게. 바의 죽은 쿠션이 속도를 먹으니, 보기보다 세게 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Firme. As tabelas mortas de bar comem velocidade, por isso bate mais forte do que parece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Firme. As tabelas mortas de boteco comem velocidade, então bata mais forte do que parece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уверенно. Мёртвые барные борта гасят скорость, так что бей сильнее, чем кажется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有力。酒吧的死库会吃速度，所以要比看起来打得重。"
          }
        }
      }
    },
