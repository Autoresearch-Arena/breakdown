    "Watching a way out. Your style here is now capped at 2.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشاهد طريقاً للخروج. أسلوبك هنا محدود الآن بـ 2."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du schaust einen Ausweg an. Dein Stil ist hier jetzt auf 2 begrenzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viendo una salida. Tu estilo aquí queda limitado a 2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu regardes une sortie. Ton style ici est maintenant plafonné à 2."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai guardando una via d'uscita. Il tuo stile qui ora vale al massimo 2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "抜け出し方を見ている。ここでのスタイル点は2点までになる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠져나가는 방법을 보는 중이에요. 이제 여기서 스타일은 최대 2점이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás a ver uma saída. O teu estilo aqui fica limitado a 2."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está vendo uma saída. Seu estilo aqui agora fica limitado a 2."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотришь, как выбраться. Стиль здесь теперь не выше 2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在观看一种解法。你在这里的风格分最多只能得 2 分。"
          }
        }
      }
    },
