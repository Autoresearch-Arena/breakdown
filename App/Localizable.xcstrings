    "Same shot, same result. The physics is exact, so nothing changes unless you do.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربة واحدة، ونتيجة واحدة. الفيزياء دقيقة، فلا يتغير شيء إلا إذا غيّرته أنت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicher Stoß, gleiches Ergebnis. Die Physik ist exakt, also ändert sich nichts, außer du änderst etwas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mismo tiro, mismo resultado. La física es exacta, así que nada cambia a menos que lo cambies tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même coup, même résultat. La physique est exacte, donc rien ne change à moins que tu ne changes quelque chose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stesso tiro, stesso risultato. La fisica è esatta, quindi non cambia nulla, a meno che tu non cambi qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じショットなら同じ結果になります。物理計算は正確なので、自分で変えない限り何も変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 샷이면 같은 결과가 나옵니다. 물리 계산이 정확해서, 직접 바꾸지 않는 한 아무것도 달라지지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesma tacada, mesmo resultado. A física é exata, por isso nada muda a não ser que você mude."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesma tacada, mesmo resultado. A física é exata, por isso nada muda a menos que você mude."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тот же удар, тот же результат. Физика точна, поэтому ничего не меняется, пока вы сами что-то не измените."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同样的击球，同样的结果。物理计算是精确的，所以除非你改变什么，结果不会变。"
          }
        }
      }
    },
