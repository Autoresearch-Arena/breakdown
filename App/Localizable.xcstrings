    "Point the cue down the table, left of the 12, and let the curve bring the cue ball right onto the 8.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه العصا إلى أسفل الطاولة، يسار الكرة 12، ودع الانحناء يعيد الكرة البيضاء يميناً إلى الكرة 8."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte das Queue den Tisch hinunter, links an der 12 vorbei, und lass die Kurve die Weiße nach rechts auf die 8 bringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta el taco hacia el fondo de la mesa, a la izquierda de la 12, y deja que la curva lleve la blanca a la derecha, a la 8."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointe la queue vers le bas de la table, à gauche de la 12, et laisse la courbe ramener la blanche à droite sur la 8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta la stecca verso il fondo del tavolo, a sinistra della 12, e lascia che la curva porti la bianca a destra sulla 8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを台の奥へ、12番の左に向け、カーブで手球を右へ曲げて8番に当てる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐를 테이블 아래쪽, 12번 왼쪽으로 겨누고, 커브가 큐볼을 오른쪽 8번으로 데려가게 하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponta o taco para o fundo da mesa, à esquerda da 12, e deixa a curva trazer a branca para a direita, até à 8."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte o taco para o fundo da mesa, à esquerda da 12, e deixe a curva levar a branca para a direita, até a 8."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направь кий вниз по столу, левее 12, и пусть изгиб приведёт биток вправо на 8."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "球杆指向台的远端、12 号球左侧，让弧线把母球往右带到 8 号球。"
          }
        }
      }
    },
