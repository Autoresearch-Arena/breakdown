            "value": "Guardare limita il tuo stile qui a 2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見るとここでのスタイル点は2点までになる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보면 여기서 스타일은 최대 2점이 돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
