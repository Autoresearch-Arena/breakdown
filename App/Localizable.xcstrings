    "Full power: the tip landed left of where you aimed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بكامل القوة: أصاب رأس العصا يسار المكان الذي صوّبت إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Volle Kraft: Die Pomeranze traf links von der Stelle, auf die du gezielt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A toda potencia: la suela dio a la izquierda de donde apuntaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À pleine puissance : le procédé a touché à gauche de l’endroit visé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A tutta potenza: il cuoio ha colpito a sinistra del punto mirato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全力:タップが狙った位置より左に当たった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 세기: 팁이 겨냥한 곳보다 왼쪽에 맞았어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Força máxima: a sola bateu à esquerda de onde apontaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Força máxima: o couro bateu à esquerda de onde você mirou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полная сила: наклейка попала левее точки прицела."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全力:杆头击在了瞄准点的左边。"
          }
        }
      }
    },
