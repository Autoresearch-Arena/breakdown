    },
    "Played without a finger stroke, so this one stays out of your record.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لُعبت دون ضربة بالإصبع، لذلك لا تُحسب هذه في سجلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Fingerstoß gespielt, darum zählt dieser nicht für deinen Rekord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiro sin golpe de dedo, así que este no cuenta para tu récord."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joué sans coup du doigt, donc celui-ci ne compte pas dans ton record."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giocato senza un colpo col dito, quindi questo resta fuori dal tuo record."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指のストロークなしで撞いたので、このショットは記録に入らない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락 스트로크 없이 쳐서 이번 샷은 기록에 들어가지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogada sem tacada de dedo, por isso esta fica fora do teu recorde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogada sem tacada com o dedo, então esta fica fora do seu recorde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сыграно без удара пальцем, поэтому этот удар не идёт в твой рекорд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一杆没有用手指出杆，所以不计入你的记录。"
          }
        }
      }
    },
