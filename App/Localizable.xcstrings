          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as déplacé la visée que très légèrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai spostato la mira solo di pochissimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "狙いはほんの少ししか変えていない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조준을 아주 조금만 바꿨다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexeste na pontaria só ligeiramente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você mexeu na mira só um pouquinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прицел сдвинулся лишь чуть-чуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你只稍微改了一点瞄准。"
          }
        }
      }
    },
    "You moved the tip only slightly to the side.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّكت رأس العصا إلى الجانب قليلًا جدًا فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Queuespitze nur ganz leicht zur Seite gesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moviste la punta solo un poco hacia el lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as déplacé le procédé que très légèrement sur le côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai spostato il cuoio solo di pochissimo di lato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップの左右はほんの少ししか変えていない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁을 옆으로 아주 조금만 옮겼다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexeste a ponta só ligeiramente para o lado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você mexeu a ponta só um pouquinho para o lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклейка сдвинулась в сторону лишь чуть-чуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你只把杆头向侧边移了一点点。"
          }
        }
      }
    },
    "You moved the tip only slightly up or down.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّكت رأس العصا للأعلى أو للأسفل قليلًا جدًا فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Queuespitze nur ganz leicht nach oben oder unten gesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moviste la punta solo un poco arriba o abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as déplacé le procédé que très légèrement vers le haut ou le bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai spostato il cuoio solo di pochissimo in alto o in basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップの上下はほんの少ししか変えていない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁을 위아래로 아주 조금만 옮겼다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexeste a ponta só ligeiramente para cima ou para baixo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você mexeu a ponta só um pouquinho para cima ou para baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклейка сдвинулась вверх или вниз лишь чуть-чуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你只把杆头上下移了一点点。"
          }
        }
      }
    },
    "You pocketed the 8 on a foul": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخلت الكرة 8 مع خطأ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die 8 mit einem Foul versenkt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metiste la 8 con falta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as rentré la 8 sur une faute"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai imbucato la 8 con un fallo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファウルで8番を落とした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파울하면서 8번을 넣었어요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteste a 8 com falta"
          }
        },
        "pt-BR": {
          "stringUnit": {
