    "Coming up short: the dead rails take more than you expect.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقصر: الحواف الميتة تأخذ أكثر مما تتوقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu kurz: Die toten Banden nehmen mehr, als du denkst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedarse corta: las bandas muertas se llevan más de lo que esperas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop court : les bandes mortes prennent plus que tu ne crois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivare corti: le sponde morte tolgono più di quanto pensi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "届かない：死んだクッションは思ったより多く奪う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧게 끝나요: 죽은 쿠션은 생각보다 더 많이 먹어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficar curto: as tabelas mortas levam mais do que esperas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficar curto: as tabelas mortas levam mais do que você espera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не доходит: мёртвые борта забирают больше, чем ждёшь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打不到：死库吃掉的比你想的多。"
          }
        }
      }
    },
    "Common miss": {
      "localizations": {
        "ar": {
          "stringUnit": {
