          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indietro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドロー"
          }
        },
        "ko": {
          "stringUnit": {
