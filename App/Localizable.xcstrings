          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライドカメラ: リプレイがテーブルの高さで球を追いかけます(Command-E)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이드 카메라: 리플레이가 테이블 높이에서 공을 따라갑니다(Command-E)"
          }
        },
        "pt": {
