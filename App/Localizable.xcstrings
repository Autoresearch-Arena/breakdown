    "Kicking just to hit a ball is far easier than kicking to pocket it. The 8 anywhere but the called pocket loses the game.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الارتداد لمجرد إصابة كرة أسهل بكثير من الارتداد لإدخالها. الكرة 8 في أي جيب غير المعلن تخسرك المباراة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Per Vorbänder nur eine Kugel zu treffen ist viel leichter, als sie zu versenken. Die 8 in einer anderen als der angesagten Tasche kostet das Spiel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebotar solo para tocar una bola es mucho más fácil que rebotar para meterla. La 8 en cualquier tronera que no sea la cantada pierde la partida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire une bricole juste pour toucher une bille est bien plus facile que pour la rentrer. La 8 ailleurs que dans la poche annoncée, et la partie est perdue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colpire di rimbalzo solo per toccare una palla è molto più facile che per imbucarla. La 8 in una buca diversa da quella chiamata fa perdere la partita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当てるだけのキックは、入れるキックよりずっと簡単。8番が宣言以外のポケットに入れば負け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공을 맞히기만 하는 킥은 넣는 킥보다 훨씬 쉬워요. 8번이 선언한 포켓이 아닌 곳에 들어가면 게임에서 져요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acertar de tabela só para tocar numa bola é muito mais fácil do que para a encaçapar. A 8 em qualquer caçapa que não a anunciada perde o jogo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acertar de tabela só para tocar uma bola é muito mais fácil do que para encaçapá-la. A 8 em qualquer caçapa fora a anunciada perde o jogo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через борт просто попасть в шар куда проще, чем забить его. 8 в любую лузу, кроме заказанной, — проигрыш партии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解球只求碰到比解球进袋容易得多。8 号球进了叫的袋以外的任何袋，就输掉整局。"
          }
        }
      }
    },
    "Last time %@ went in; this time %@ stayed up.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المرة الماضية دخلت %@؛ وهذه المرة بقيت %@ على الطاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim letzten Mal ist %@ eingelocht; diesmal blieb %@ draußen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vez anterior %@ entró; esta vez %@ se quedó fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière fois, %@ est tombée ; cette fois, %@ est restée en jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultima volta %@ è caduta in buca; questa volta %@ è rimasta in gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回は%@がポケットに入り、今回は%@は入りませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번엔 %@ 들어갔고, 이번엔 %@ 들어가지 않았습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Da última vez %@ entrou; desta vez %@ ficou na mesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da última vez %@ entrou; desta vez %@ ficou na mesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В прошлый раз %@ упал в лузу; в этот раз %@ остался на столе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次%@入袋了；这次%@没有入袋。"
          }
        }
      }
    },
    "Last time the cue ball stopped %@; this time it stopped %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المرة الماضية توقفت الكرة البيضاء %@؛ وهذه المرة توقفت %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim letzten Mal kam die weiße Kugel %@ zum Stehen; diesmal kam sie %@ zum Stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vez anterior la bola blanca se detuvo %@; esta vez se detuvo %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière fois, la bille blanche s'est arrêtée %@ ; cette fois elle s'est arrêtée %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultima volta la palla bianca si è fermata %@; stavolta si è fermata %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回は手球が%@で止まり、今回は%@で止まりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번엔 큐볼이 %@ 멈췄고, 이번엔 %@ 멈췄습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Da última vez a bola branca parou %@; desta vez parou %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da última vez a bola branca parou %@; desta vez parou %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В прошлый раз белый шар остановился %@; в этот раз здесь %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次白球停在%@；这次停在%@。"
          }
        }
      }
    },
    "Last try": {
      "localizations": {
