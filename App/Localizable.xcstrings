            "value": "Он пришёл с обратным вращением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它带着回旋撞过来。"
          }
        }
      }
    },
    "It came in with more topspin than rolling.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت بدوران أمامي أكثر من التدحرج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kam mit mehr Vorwärtseffet an als beim Rollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegó con más efecto alto que rodando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle arrivait avec plus d'effet coulé qu'en roulant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È arrivata con più effetto in avanti che rotolando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転がりより強いトップスピンで入ってきました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구를 때보다 강한 탑스핀을 품고 들어왔습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegou com mais efeito alto do que a rolar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegou com mais efeito alto do que rolando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он пришёл с более сильным верхним вращением, чем при качении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它带着比滚动时更强的上旋撞过来。"
          }
        }
      }
    },
    "It came in with some topspin, less than rolling.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت ببعض الدوران الأمامي، أقل من التدحرج."
