            "state": "translated",
            "value": "También lleva efecto lateral a la derecha, que se notará en la próxima banda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle emporte aussi de l'effet à droite, qui se verra à la prochaine bande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta anche effetto laterale a destra, che si vedrà alla prossima sponda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右の横回転もかかっていて、次のクッションで効いてきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
