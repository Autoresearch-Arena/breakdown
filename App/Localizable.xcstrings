    "Sound, vibration, the aim guide and the tips.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصوت والاهتزاز ودليل التصويب والتلميحات."
          }
        },
        "de": {
