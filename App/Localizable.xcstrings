          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリックショット「%@」はこの考え方でできています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트릭 샷 '%@'은 이 원리로 만들어졌어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A jogada de efeito %@ assenta nesta ideia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tacada de efeito %@ se baseia nesta ideia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
