          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有力的一杆。"
          }
        }
      }
    },
    "A gentle roll.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
