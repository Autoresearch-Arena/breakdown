          "stringUnit": {
            "state": "translated",
            "value": "Gutes Safety. Der Gegner hat keinen freien Stoß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buena seguridad. No tienen tiro claro."
          }
