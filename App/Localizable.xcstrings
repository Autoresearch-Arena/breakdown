    "Foot rail a third of a diamond right of the first diamond, the left rail near the corner, the right rail past the side pocket, then up the table to the 9.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافة القدم بثلث ماسة يمين الماسة الأولى، ثم الحافة اليسرى قرب الزاوية، ثم الحافة اليمنى بعد الجيب الجانبي، ثم صعوداً إلى الكرة 9."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fußbande ein Drittel Diamant rechts vom ersten Diamanten, die linke Bande nahe der Ecke, die rechte Bande hinter der Mitteltasche, dann den Tisch hinauf zur 9."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Banda del pie un tercio de diamante a la derecha del primer diamante, la banda izquierda cerca de la esquina, la banda derecha pasada la lateral, y luego mesa arriba hasta la 9."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bande du pied à un tiers de mouche à droite de la première, la bande gauche près du coin, la bande droite après la poche du milieu, puis on remonte la table jusqu'à la 9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sponda di fondo un terzo di diamante a destra del primo, la sponda sinistra vicino all'angolo, la destra oltre la centrale, poi su per il tavolo fino alla 9."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フットクッションの1つ目のポイントから右へ3分の1、左クッションのコーナー近く、右クッションのサイドポケットの先、そして台を上って9番へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풋 쿠션 첫 번째 포인트에서 3분의 1 오른쪽, 왼쪽 쿠션 코너 근처, 오른쪽 쿠션 사이드 포켓 지나서, 그리고 테이블을 올라가 9번으로."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela do pé um terço de diamante à direita do primeiro, a tabela esquerda perto do canto, a tabela direita depois da lateral, e depois mesa acima até à 9."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela do pé um terço de diamante à direita do primeiro, a tabela esquerda perto do canto, a tabela direita depois da lateral, e depois mesa acima até a 9."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижний борт на треть метки правее первой, левый борт у угла, правый борт за средней лузой, затем вверх по столу к 9."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚库第一个星点右侧三分之一个星点处，再到左库靠近角袋处，再到右库中袋之后，然后往上走到 9 号球。"
          }
        }
      }
    },
