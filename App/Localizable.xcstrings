    "Round the houses and in. Two mirrors, one pocket.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالطريق الملتوي إلى الجيب. مرآتان، وجيب واحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großer Umweg und rein. Zwei Spiegel, eine Tasche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dando la vuelta y dentro. Dos espejos, una tronera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le grand tour et au but. Deux miroirs, une poche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giro largo e in buca. Due specchi, una buca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠回りして、ポケットへ。鏡は二枚、ポケットは一つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌고 돌아 들어가요. 거울 두 개, 포켓 하나."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar a volta toda e entrar. Dois espelhos, uma caçapa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar a volta toda e entrar. Dois espelhos, uma caçapa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окольный путь прямо в лузу. Два зеркала, одна луза."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕远路再入袋。两面镜子，一个袋口。"
          }
        }
      }
    },
