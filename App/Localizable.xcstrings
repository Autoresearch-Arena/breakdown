    "Step through the explained moments of the shot, forwards or back.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنقلك بين لحظات الضربة المشروحة، للأمام أو للخلف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen die erklärten Momente des Stoßes durch, vorwärts oder zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorren los momentos explicados del tiro, hacia delante o hacia atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourent les moments expliqués du coup, en avant ou en arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorrono i momenti spiegati del colpo, avanti o indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショットの解説の場面を前後に順にたどります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샷의 설명 장면을 앞뒤로 넘겨요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorrem os momentos explicados da tacada, para a frente ou para trás."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorrem os momentos explicados da tacada, para a frente ou para trás."
          }
        },
        "ru": {
          "stringUnit": {
