            "value": "%1$@은(는) 어떤 공도 맞히지 않고 %2$@까지 가요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não toca em nenhuma bola e vai até à %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não toca em nenhuma bola e vai até a %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не задевает ни одного шара и идёт к борту (%2$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@不碰任何球，滚向%2$@。"
          }
        }
      }
    },
    "%@ hits no ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لا تصيب أي كرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trifft keine Kugel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no toca ninguna bola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne touche aucune bille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non tocca nessuna palla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はどの球にも当たりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 어떤 공도 맞히지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não toca em nenhuma bola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não toca em nenhuma bola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не задевает ни одного шара."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@不碰任何球。"
          }
        }
      }
    },
    "%@ hits the post at %@ m/s and keeps %@ percent of its speed straight into it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ يصطدم بالعمود بسرعة %2$@ m/s ويحتفظ بـ%3$@ في المئة من سرعته متجهاً مباشرةً نحوه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trifft den Pfosten mit %2$@ m/s und behält %3$@ Prozent seines Tempos in Richtung Pfosten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ toca el poste a %2$@ m/s y conserva el %3$@ por ciento de su velocidad en línea recta contra él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ touche le plot à %2$@ m/s et garde %3$@ pour cent de sa vitesse en ligne droite contre lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ colpisce il respingente a %2$@ m/s e mantiene il %3$@ per cento della sua velocità verso di esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@ m/sでポストに当たり、速さの%3$@%を保ったまま真っすぐ跳ね返ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) %2$@ m/s로 기둥에 맞고, 기둥 쪽 속도의 %3$@퍼센트를 유지해."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bate no pino a %2$@ m/s e mantém %3$@ por cento da sua velocidade em linha reta contra ele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bate no pino a %2$@ m/s e mantém %3$@ por cento da sua velocidade em linha reta contra ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ударяется о столбик на скорости %2$@ м/с и сохраняет %3$@ процентов скорости, направленной прямо в него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@以%2$@ m/s撞上挡柱，正对挡柱方向的速度保留%3$@%。"
          }
        }
      }
    },
    "%@ hits the rail at %@ m/s and keeps %@ percent of its speed straight into the rail. Sideways speed is trimmed by friction.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يصطدم بالحافة بسرعة %@ m/s ويحتفظ بـ%@ في المئة من سرعته متجهاً مباشرةً نحو الحافة. ويقلّص الاحتكاكُ السرعةَ الجانبية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trifft die Bande mit %@ m/s und behält %@ Prozent seines Tempos in Richtung Bande. Die seitliche Geschwindigkeit wird durch Reibung gebremst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ toca la banda a %@ m/s y conserva el %@ por ciento de su velocidad en línea recta contra la banda. La fricción reduce la velocidad lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ touche la bande à %@ m/s et garde %@ pour cent de sa vitesse en ligne droite contre la bande. La friction réduit la vitesse latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ colpisce la sponda a %@ m/s e mantiene il %@ per cento della sua velocità verso la sponda. La velocità laterale viene frenata dall'attrito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は%@ m/sでクッションに当たり、速さの%@%を保ったまま真っすぐ跳ね返ります。横方向の速さは摩擦で削られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)가 %@ m/s로 쿠션에 맞고, 속도의 %@%를 유지한 채 곧장 되튑니다. 옆 방향 속도는 마찰로 줄어듭니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bate na tabela a %@ m/s e mantém %@ por cento da velocidade em direção à tabela. A velocidade lateral é reduzida pelo atrito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bate na tabela a %@ m/s e mantém %@ por cento da velocidade em direção à tabela. A velocidade lateral é reduzida pelo atrito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ударяется о борт на скорости %@ m/s и сохраняет %@ процентов скорости в направлении борта. Боковую скорость гасит трение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以 %@ m/s 的速度撞上库边，沿库边方向保留了百分之%@的速度。侧向速度被摩擦力削减。"
          }
        }
      }
    },
    "%@ hits the rail at %@ m/s. The rail's nose is above the ball's centre, so it pushes down as well as back, and the cloth takes %@ millinewton-seconds of that push. It keeps %@ percent of its speed straight into the rail.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ يصطدم بالحافة بسرعة %2$@ m/s. طرف الحافة أعلى من مركز الكرة، فيدفعها إلى الأسفل وإلى الخلف معاً، ويتلقّى القماش %3$@ ملي نيوتن ثانية من هذه الدفعة. ويحتفظ بـ%4$@ في المئة من سرعته متجهاً مباشرةً نحو الحافة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trifft die Bande mit %2$@ m/s. Die Bandenkante liegt über dem Mittelpunkt der Kugel, also drückt sie nach unten und nach hinten, und das Tuch nimmt %3$@ Millinewtonsekunden dieses Stoßes auf. Sie behält %4$@ Prozent ihres Tempos in Richtung Bande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ toca la banda a %2$@ m/s. El borde de la banda está por encima del centro de la bola, así que empuja hacia abajo además de hacia atrás, y el paño recibe %3$@ milinewton-segundos de ese empuje. Conserva el %4$@ por ciento de su velocidad en línea recta contra la banda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ touche la bande à %2$@ m/s. Le nez de la bande est au-dessus du centre de la bille, donc il pousse vers le bas autant qu'en arrière, et le tapis reçoit %3$@ millinewtons-secondes de cette poussée. Elle garde %4$@ pour cent de sa vitesse en ligne droite contre la bande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ colpisce la sponda a %2$@ m/s. Il profilo della sponda è sopra il centro della palla, quindi spinge verso il basso oltre che indietro, e il panno riceve %3$@ millinewton-secondo di quella spinta. Mantiene il %4$@ per cento della sua velocità verso la sponda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@ m/sでクッションに当たります。クッションの先端はボールの中心より高いので、後ろだけでなく下にも押し、その押しのうち%3$@ミリニュートン秒をラシャが受け止めます。クッションに向かう速さの%4$@パーセントを保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(이)가 %2$@ m/s로 쿠션에 맞습니다. 쿠션의 끝은 공의 중심보다 높아서 뒤로뿐 아니라 아래로도 누르고, 그 힘 가운데 %3$@밀리뉴턴초를 천이 받아 냅니다. 쿠션을 향한 속도의 %4$@퍼센트를 유지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bate na tabela a %2$@ m/s. A aresta da tabela fica acima do centro da bola, por isso empurra para baixo e também para trás, e o pano recebe %3$@ milinewton-segundos desse impulso. Mantém %4$@ por cento da velocidade em direção à tabela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bate na tabela a %2$@ m/s. A borda da tabela fica acima do centro da bola, então empurra para baixo e também para trás, e o pano recebe %3$@ milinewton-segundos desse impulso. Ela mantém %4$@ por cento da velocidade em direção à tabela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ударяется о борт на скорости %2$@ m/s. Кромка борта выше центра шара, поэтому она давит не только назад, но и вниз, и сукно принимает %3$@ миллиньютон-секунд этого толчка. Он сохраняет %4$@ процентов скорости в направлении борта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 以 %2$@ m/s 的速度撞上库边。库边的边沿高于球心，所以它不仅向后推，还向下压，台呢承受了其中 %3$@ 毫牛·秒的冲量。沿库边方向保留了百分之%4$@的速度。"
          }
        }
      }
    },
    "%@ hits the rail at %@ m/s. The rail's nose is above the ball's centre, so it pushes down as well as back: the cloth takes %@ millinewton-seconds of that push, and its grip changes the spin the ball carries away. It keeps %@ percent of its speed straight into the rail.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يصطدم بالحافة بسرعة %@ m/s. طرف الحافة أعلى من مركز الكرة، فيدفعها إلى الأسفل وإلى الخلف معاً: يتلقّى القماش %@ ملي نيوتن ثانية من هذه الدفعة، ويغيّر احتكاكُه الدورانَ الذي تحمله الكرة معها. ويحتفظ بـ%@ في المئة من سرعته متجهاً مباشرةً نحو الحافة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trifft die Bande mit %@ m/s. Die Bandenkante liegt über dem Mittelpunkt der Kugel, also drückt sie nach unten und nach hinten: Das Tuch nimmt %@ Millinewtonsekunden dieses Stoßes auf, und seine Reibung ändert den Effet, mit dem die Kugel abläuft. Sie behält %@ Prozent ihres Tempos in Richtung Bande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ toca la banda a %@ m/s. El borde de la banda está por encima del centro de la bola, así que empuja hacia abajo además de hacia atrás: el paño recibe %@ milinewton-segundos de ese empuje, y su agarre cambia el efecto con que sale la bola. Conserva el %@ por ciento de su velocidad en línea recta contra la banda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ touche la bande à %@ m/s. Le nez de la bande est au-dessus du centre de la bille, donc il pousse vers le bas autant qu'en arrière : le tapis reçoit %@ millinewtons-secondes de cette poussée, et son adhérence change l'effet que la bille emporte. Elle garde %@ pour cent de sa vitesse en ligne droite contre la bande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ colpisce la sponda a %@ m/s. Il profilo della sponda è sopra il centro della bilia, quindi spinge verso il basso oltre che indietro: il panno riceve %@ millinewton-secondo di quella spinta, e la sua aderenza cambia l'effetto con cui la bilia riparte. Mantiene il %@ per cento della sua velocità verso la sponda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は%@ m/sでクッションに当たります。クッションの先端はボールの中心より高いので、後ろだけでなく下にも押します。その押しのうち%@ミリニュートン秒をラシャが受け止め、その摩擦がボールの持ち去る回転を変えます。クッションに向かう速さの%@パーセントを保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)가 %@ m/s로 쿠션에 맞습니다. 쿠션의 끝은 공의 중심보다 높아서 뒤로뿐 아니라 아래로도 누릅니다. 그 힘 가운데 %@밀리뉴턴초를 천이 받아 내고, 천의 마찰이 공이 가지고 나가는 회전을 바꿉니다. 쿠션을 향한 속도의 %@퍼센트를 유지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bate na tabela a %@ m/s. A aresta da tabela fica acima do centro da bola, por isso empurra para baixo e também para trás: o pano recebe %@ milinewton-segundos desse impulso, e a sua aderência muda o efeito com que a bola sai. Mantém %@ por cento da velocidade em direção à tabela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bate na tabela a %@ m/s. A borda da tabela fica acima do centro da bola, então empurra para baixo e também para trás: o pano recebe %@ milinewton-segundos desse impulso, e a aderência dele muda o efeito com que a bola sai. Ela mantém %@ por cento da velocidade em direção à tabela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ударяется о борт на скорости %@ m/s. Кромка борта выше центра шара, поэтому она давит не только назад, но и вниз: сукно принимает %@ миллиньютон-секунд этого толчка, и его сцепление меняет вращение, с которым уходит шар. Он сохраняет %@ процентов скорости в направлении борта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以 %@ m/s 的速度撞上库边。库边的边沿高于球心，所以它不仅向后推，还向下压：台呢承受了其中 %@ 毫牛·秒的冲量，它的摩擦改变了球带走的旋转。沿库边方向保留了百分之%@的速度。"
          }
        }
      }
    },
    "%@ hits the slate going down at %@ m/s and bounces up at %@ m/s, so it leaves the cloth.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ تصطدم باللوح الحجري نازلةً بسرعة %2$@ m/s وترتد إلى الأعلى بسرعة %3$@ m/s، فتغادر الجوخ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trifft die Schieferplatte mit %2$@ m/s nach unten und springt mit %3$@ m/s wieder hoch, also hebt sie vom Tuch ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ golpea la pizarra bajando a %2$@ m/s y rebota hacia arriba a %3$@ m/s, así que despega del paño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ frappe l'ardoise en descendant à %2$@ m/s et rebondit vers le haut à %3$@ m/s, donc elle quitte le tapis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ colpisce l'ardesia scendendo a %2$@ m/s e rimbalza verso l'alto a %3$@ m/s, così si stacca dal panno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@ m/sで下向きにスレートに当たり、%3$@ m/sで上に跳ね返るので、ラシャから離れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(이)가 %2$@ m/s로 내려가며 슬레이트에 부딪히고 %3$@ m/s로 튀어 올라, 천에서 떠오릅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bate na ardósia a descer a %2$@ m/s e ressalta para cima a %3$@ m/s, por isso sai do pano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bate na ardósia descendo a %2$@ m/s e quica para cima a %3$@ m/s, então sai do pano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ударяется о плиту, двигаясь вниз со скоростью %2$@ m/s, и отскакивает вверх со скоростью %3$@ m/s, поэтому отрывается от сукна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 以 %2$@ m/s 向下撞上石板，又以 %3$@ m/s 向上弹起，于是离开了台呢。"
          }
        }
      }
    },
    "%@ is about %@ ball-widths away.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ على بعد نحو %2$@ عرض كرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist etwa %2$@ Kugelbreiten entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está a unas %2$@ bolas de distancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est à environ %2$@ largeurs de bille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è a circa %2$@ palle di distanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
