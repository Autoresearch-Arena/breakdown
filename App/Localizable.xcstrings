    "Shots that make people stare, easiest first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربات تبهر الجميع، من الأسهل أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stöße, die alle staunen lassen, die leichtesten zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiros que dejan a la gente boquiabierta, de los más fáciles a los más difíciles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des coups qui laissent bouche bée, du plus facile au plus dur."
          }
        },
        "it": {
