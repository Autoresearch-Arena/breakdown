          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "球を元に戻し、狙いの操作を開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공을 제자리에 되돌리고 조준 컨트롤을 엽니다"
          }
        },
        "pt": {
          "stringUnit": {
