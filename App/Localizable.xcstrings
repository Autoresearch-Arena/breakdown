            "value": "Uma tacada média."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средний удар."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中等力度。"
          }
        }
      }
    },
    "A new distance": {
      "localizations": {
        "ar": {
          "stringUnit": {
