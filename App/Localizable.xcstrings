          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 가까운 공 조준"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirar na bola mais próxima"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirar na bola mais próxima"
          }
        },
        "ru": {
