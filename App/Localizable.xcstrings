    "Your bridge hand was closer to the cue ball this time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كانت يد الجسر هذه المرة أقرب إلى الكرة البيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Brückenhand war diesmal näher an der weißen Kugel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vez tu mano de puente estaba más cerca de la bola blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fois, ta main de pont était plus près de la bille blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa volta la mano del ponte era più vicina alla bilia battente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
