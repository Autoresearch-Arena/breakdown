    "No pot was wide enough for its aim, so it played safe.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكن أي ضربة واسعة بما يكفي لتصويبه، فلعب دفاعيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Ball war für sein Zielen breit genug, also spielte er sicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna tirada era lo bastante fácil para su puntería, así que jugó a la defensiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun coup n'était assez large pour sa visée, alors il a joué la sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tiro era abbastanza largo per la sua mira, così ha giocato in difesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "狙いの精度に見合う球がなかったので、セーフティを打ちました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조준 실력에 맞는 넉넉한 샷이 없어서 수비를 했습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma jogada tinha margem suficiente para a sua pontaria, por isso jogou à defesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma jogada tinha margem suficiente para a mira dele, então jogou na defesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один шар не давал его прицелу запаса, поэтому он сыграл отыгрыш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有容错足够大的进球线路，所以它打了防守。"
          }
        }
      }
    },
