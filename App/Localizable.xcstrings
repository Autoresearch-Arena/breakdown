    "Not enough %@ side. Strike further to the %@ of the cue ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللف الجانبي %@ غير كافٍ. اضرب أبعد نحو الجانب %@ من الكرة البيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Seitendrall nach %@. Triff die weiße Kugel weiter %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta efecto a la %@. Golpea más hacia la %@ de la bola blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez d'effet à %@. Frappe plus vers la %@ de la bille blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco effetto laterale a %@. Colpisci più lontano, a %@ della palla bianca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の横回転が足りません。手球の%@寄りを、もっと打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 옆회전이 부족해요. 큐볼의 %@ 쪽을 더 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta efeito lateral %@. Bata mais para o lado %@ da bola branca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta efeito lateral %@. Bata mais para o lado %@ da bola branca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно %@ бокового вращения. Бейте дальше к %@ стороне белого шара."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@侧旋不够。击打位置再偏向白球的%@侧一些。"
          }
        }
      }
    },
    "Not enough draw. Strike lower on the cue ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السحب غير كافٍ. اضرب أسفل الكرة البيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Rückzug. Triff die weiße Kugel weiter unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta retroceso. Golpea más abajo en la bola blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de rétro. Frappe plus bas sur la bille blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo poco indietro. Colpisci la palla bianca più in basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き玉が足りません。手球のもっと下を打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드로우가 부족해요. 큐볼의 아래쪽을 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta recuo. Bata mais abaixo na bola branca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta recuo. Bata mais abaixo na bola branca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно оттяжки. Бейте по белому шару ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低杆不够。击打白球再偏下一些。"
          }
        }
      }
    },
    "Not enough follow. Strike higher on the cue ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدفع غير كافٍ. اضرب أعلى الكرة البيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Nachlauf. Triff die weiße Kugel weiter oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta efecto de avance. Golpea más arriba en la bola blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez d'effet avant. Frappe plus haut sur la bille blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo poco avanti. Colpisci la palla bianca più in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送り玉が足りません。手球のもっと上を打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로우가 부족해요. 큐볼의 위쪽을 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta avanço. Bata mais acima na bola branca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta avanço. Bata mais acima na bola branca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно наката. Бейте по белому шару выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高杆不够。击打白球再偏上一些。"
          }
        }
      }
    },
    "Not enough pace. Pull back further to hit it harder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القوة غير كافية. اسحب للخلف أكثر لتضربها بقوة أكبر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Tempo. Zieh weiter zurück, um fester zu stoßen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta potencia. Tira más hacia atrás para golpear con más fuerza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de puissance. Tire davantage vers l'arrière pour frapper plus fort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poca forza. Tira più indietro per colpire più forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勢いが足りません。もっと引いて、強く打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "힘이 부족해요. 더 뒤로 당겨서 세게 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta força. Puxe mais para trás para bater mais forte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta força. Puxe mais para trás para bater mais forte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хватает силы. Оттяните дальше, чтобы ударить сильнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "力度不够。往后拉得更远，才能击得更用力。"
          }
        }
      }
    },
    "Not quite the line. Aim %@ %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس الخط الصحيح تماماً. صوّب %@ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht ganz die richtige Linie. Ziele %@ %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es la línea exacta. Apunta %@ hacia la %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas tout à fait la bonne ligne. Vise %@ à %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è proprio la linea giusta. Mira %@ a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "狙いの線がわずかにずれています。%@%@を狙いましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라인이 살짝 어긋났어요. %@ %@ 조준하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é bem a linha certa. Mire %@ %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é bem a linha certa. Mire %@ %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Линия немного не та. Целься %@ %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向差了一点。瞄准时%@%@一些。"
          }
        }
      }
    },
    "Now look at what the table is doing": {
      "localizations": {
