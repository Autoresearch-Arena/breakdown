            "value": "Um pino branco derrubado: %lld pontos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pino branco derrubado: %lld pontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбита одна белая кегля: %lld очка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倒白柱1根：%lld分。"
          }
        }
      }
    },
