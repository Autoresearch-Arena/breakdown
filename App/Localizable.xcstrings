          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir jede Lektion an, versuch sie dreimal mit jedes Mal weniger Hilfe und besteh sie dann allein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cada lección, pruébala tres veces con menos ayuda cada vez y luego apruébala tú solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde chaque leçon, essaie-la trois fois avec de moins en moins d'aide, puis réussis-la seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda ogni lezione, provala tre volte con sempre meno aiuto, poi superala da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各レッスンを見て、手助けを減らしながら3回試し、最後は自分だけで合格しよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레슨마다 보고, 도움을 줄여 가며 세 번 해 본 다음, 혼자 통과하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê cada lição, experimenta-a três vezes com cada vez menos ajuda e depois passa-a sozinho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja cada lição, tente três vezes com cada vez menos ajuda e depois passe nela sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотри каждый урок, попробуй его трижды, каждый раз с меньшей помощью, а потом сдай сам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先看每节课，在帮助逐次减少的情况下试三次，然后独立通过。"
          }
        }
      }
    },
    "Watch each shot, see the physics behind it in the Lens, then make it yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد كل ضربة، وتعرّف على الفيزياء وراءها في العدسة، ثم نفّذها بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir jeden Stoß an, entdecke die Physik dahinter in der Lens und mach ihn dann selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cada tiro, descubre su física en la Lente y luego hazlo tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde chaque coup, découvre sa physique dans la lentille, puis réussis-le toi-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda ogni colpo, scopri la fisica che lo regge nella lente, poi fallo tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショットを見て、レンズでその裏にある物理を確かめ、自分でも決めてみよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 샷을 보고, 렌즈로 그 뒤의 물리를 확인한 다음, 직접 성공시켜 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê cada jogada, descobre a física por trás dela na lente e depois faz tu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assista a cada tacada, veja a física por trás dela na lente e depois faça você mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотри каждый удар, увидь физику за ним в линзе, а затем повтори сам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观看每一杆，用镜片看清背后的物理原理，然后亲自打出来。"
          }
        }
      }
    },
