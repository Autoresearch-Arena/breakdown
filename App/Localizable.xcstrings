        }
      }
    },
    "It counts, but that kiss was luck.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحتسب، لكن ذلك التلامس كان حظاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt, aber der Kuss war Glück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta, pero ese beso fue suerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça compte, mais ce contact était un coup de chance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale, ma quel bacio è stato fortuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効だけど、あのキスはまぐれだね。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인정되지만, 그 키스는 운이었어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta, mas aquele toque foi sorte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale, mas aquele toque foi sorte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Засчитано, но то касание было везением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "算数，但那次碰撞是运气。"
          }
        }
      }
    },
