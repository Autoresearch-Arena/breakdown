        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보기 메뉴에서 확대하고 축소하며, 실제 크기로 테이블 전체를 다시 봅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O menu Visualização amplia e reduz, e Tamanho real volta a mostrar a mesa toda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O menu Visualizar amplia e reduz, e Tamanho real mostra a mesa inteira de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню «Вид» увеличивает и уменьшает, а «Реальный размер» снова показывает весь стол."
          }
        },
        "zh-Hans": {
