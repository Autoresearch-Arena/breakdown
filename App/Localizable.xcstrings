    "Eight-ball against the easy computer. Ask it why it played each shot.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البلياردو بالكرة 8 ضد الحاسوب السهل. اسأله لماذا لعب كل ضربة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "8-Ball gegen den leichten Computer. Frag ihn, warum er jeden Stoß gespielt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bola 8 contra el ordenador fácil. Pregúntale por qué jugó cada tiro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 8 contre l'ordinateur facile. Demande-lui pourquoi il a joué chaque coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Palla 8 contro il computer facile. Chiedigli perché ha giocato ogni tiro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やさしいコンピュータとのエイトボール。それぞれのショットを選んだ理由を聞けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉬움 컴퓨터와 에이트볼. 샷마다 왜 그렇게 쳤는지 물어보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bola 8 contra o computador fácil. Pergunta-lhe porque jogou cada tacada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bola 8 contra o computador fácil. Pergunte por que ele jogou cada tacada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восьмёрка против лёгкого компьютера. Спроси, почему он сыграл каждый удар."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和简单难度电脑打八球。可以问它每一杆为什么这么打。"
          }
        }
      }
    },
    "Eight-ball or nine-ball against a computer player of your level.": {
