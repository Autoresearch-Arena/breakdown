    "Lower the tip %@ millimetres to reach the marked band.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخفض الرأس %@ ملم لتصل إلى النطاق المحدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senk die Spitze um %@ Millimeter, um den markierten Bereich zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja la punta %@ milímetros para llegar a la franja marcada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Descends la pointe de %@ millimètres pour atteindre la bande marquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa la punta di %@ millimetri per arrivare alla fascia segnata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マークした帯まで、先端をあと%@ミリ下げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 구간까지 팁을 %@밀리미터 내려요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa a ponta %@ milímetros para chegar à faixa marcada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixe a ponta %@ milímetros para chegar à faixa marcada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опусти точку удара на %@ мм, чтобы попасть в отмеченную полосу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将杆头下移%@毫米即可进入标记区。"
          }
        }
      }
    },
    "Lowest ball first": {
