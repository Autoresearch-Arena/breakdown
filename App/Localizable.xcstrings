        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano: %1$@. Atrito de deslize %2$@, padrão %3$@. Resistência ao rolamento %4$@, padrão %5$@. Ressalto da tabela %6$@, padrão %7$@."
