    "No pockets: knock down the little pins in the middle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا جيوب: أسقِط الأوتاد الصغيرة في الوسط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Taschen: Wirf die kleinen Kegel in der Mitte um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin troneras: derriba los bolos pequeños del centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de poches : fais tomber les petites quilles au centre."
          }
        },
        "it": {
