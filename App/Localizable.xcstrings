            "state": "translated",
            "value": "Un golpe fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coup fort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un colpo forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強いショット。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강한 타구."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tacada forte."
          }
        },
        "pt-BR": {
