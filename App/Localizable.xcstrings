    "Bronze for a make, silver at 10, gold at 13.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برونزية عند الإدخال، وفضية عند 10، وذهبية عند 13."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronze fürs Versenken, Silber ab 10, Gold ab 13."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronce por meterla, plata con 10, oro con 13."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronze si tu la rentres, argent à 10, or à 13."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronzo se la imbuchi, argento a 10, oro a 13."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入ればブロンズ、10点でシルバー、13点でゴールド。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넣으면 브론즈, 10점이면 실버, 13점이면 골드."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronze se a meteres, prata aos 10, ouro aos 13."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronze se encaçapar, prata com 10, ouro com 13."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бронза — если забил, серебро — с 10, золото — с 13."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打进得铜牌，10 分银牌，13 分金牌。"
          }
        }
      }
    },
