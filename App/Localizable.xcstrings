    "Cue: %@. Pull back from the cue ball on the table, or drag here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العصا: %@. اسحب للخلف من الكرة البيضاء على الطاولة، أو اسحب هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue: %@. Zieh auf dem Tisch von der weißen Kugel zurück oder zieh hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Taco: %@. Tira hacia atrás desde la bola blanca en la mesa, o arrastra aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue : %@. Tire en arrière depuis la bille blanche sur la table, ou fais glisser ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stecca: %@. Tira indietro dalla bilia battente sul tavolo, oppure trascina qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キュー:%@。テーブルの手球から引くか、ここをドラッグ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
