    "It was a foul, so %@ gets the points, raised to the least a foul gives: %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان خطأً، لذا يحصل %1$@ على النقاط، مرفوعةً إلى أقل ما يمنحه الخطأ: %2$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es war ein Foul, also bekommt %1$@ die Punkte, auf das Minimum eines Fouls angehoben: %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fue falta, así que %1$@ se lleva los puntos, subidos al mínimo que da una falta: %2$lld."
