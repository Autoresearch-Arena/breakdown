    "Lens colours: amber lines show a ball sliding, cyan lines a ball rolling": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألوان العدسة: الخطوط العنبرية تُظهر كرة تنزلق، والخطوط السماوية تُظهر كرة تتدحرج"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lens-Farben: Bernsteinfarbene Linien zeigen eine rutschende Kugel, türkise Linien eine rollende Kugel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colores de la lente: las líneas ámbar muestran una bola deslizando, las cian una bola rodando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleurs de la lentille : les lignes ambre montrent une bille qui glisse, les lignes cyan une bille qui roule"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori della lente: le linee ambra mostrano una palla che scivola, quelle ciano una palla che rotola"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズの色: 琥珀色の線は滑っている球、シアンの線は転がっている球を表します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈 색상: 호박색 선은 미끄러지는 공, 청록색 선은 구르는 공을 나타냅니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cores da lente: as linhas âmbar mostram uma bola a deslizar, as ciano uma bola a rolar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cores da lente: as linhas âmbar mostram uma bola deslizando, as ciano uma bola rolando"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвета линзы: янтарные линии — шар скользит, голубые — шар катится"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜片颜色：琥珀色线条表示球在滑动，青色线条表示球在滚动"
          }
        }
      }
    },
    "Lens lines: dashed amber lines show a ball sliding, solid cyan lines a ball rolling": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوط العدسة: الخطوط الكهرمانية المتقطعة تُظهر كرة تنزلق، والخطوط السماوية المتصلة كرة تتدحرج"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linien der Linse: gestrichelte bernsteinfarbene Linien zeigen eine gleitende Kugel, durchgehende cyanfarbene eine rollende"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Líneas de la lente: las ámbar discontinuas muestran una bola deslizando, las cian continuas una bola rodando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lignes de la lentille : les ambrées en pointillés montrent une bille qui glisse, les cyan continues une bille qui roule"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Linee della lente: le ambra tratteggiate mostrano una palla che scivola, le ciano continue una palla che rotola"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズの線：琥珀色の破線は滑っている球、シアンの実線は転がっている球"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈 선: 호박색 점선은 미끄러지는 공, 청록색 실선은 구르는 공"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Linhas da lente: as âmbar tracejadas mostram uma bola a deslizar, as ciano contínuas uma bola a rolar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linhas da lente: as âmbar tracejadas mostram uma bola deslizando, as ciano contínuas uma bola rolando"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Линии линзы: янтарный пунктир — шар скользит, сплошной голубой — шар катится"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透镜线条：琥珀色虚线表示球在滑动，青色实线表示球在滚动"
          }
        }
      }
    },
