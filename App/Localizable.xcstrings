          }
        }
      }
    },
    "Aim at the 3 as if the 8 weren't there, cutting it into the foot-left corner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوّب على الكرة 3 كأن الكرة 8 غير موجودة، وقطّعها إلى زاوية القدم اليسرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel auf die 3, als wäre die 8 nicht da, und schneide sie in die linke Fußecke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta a la 3 como si la 8 no estuviera, cortándola a la esquina izquierda del pie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vise la 3 comme si la 8 n'était pas là, en la coupant dans le coin gauche du pied."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira la 3 come se la 8 non ci fosse, tagliandola nell'angolo sinistro di fondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8番がないつもりで3番を狙い、フット左コーナーへカット。"
