    "The angle in is about the angle out; the cushion's grip and any spin bend it a few degrees.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زاوية الدخول تقارب زاوية الخروج؛ وإمساك الوسادة وأي لف يحرفانها بضع درجات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einfallswinkel ist etwa der Ausfallswinkel; der Bandengriff und jeder Drall biegen ihn um ein paar Grad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ángulo de entrada es casi el de salida; el agarre de la banda y cualquier efecto lo desvían unos grados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'angle d'entrée est à peu près celui de sortie ; l'accroche de la bande et tout effet le dévient de quelques degrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'angolo d'entrata è più o meno quello d'uscita; la presa della sponda e qualsiasi effetto lo piegano di qualche grado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入射角はほぼ反射角と同じです。クッションの摩擦と回転で、角度は数度ずれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어오는 각은 나가는 각과 거의 같습니다. 쿠션의 마찰과 회전이 각도를 몇 도 정도 휘게 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ângulo de entrada é cerca de igual ao de saída; o atrito da tabela e qualquer efeito desviam alguns graus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ângulo de entrada é mais ou menos igual ao de saída; o atrito da tabela e qualquer efeito desviam alguns graus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Угол падения примерно равен углу отражения; сцепление борта и любое вращение отклоняют его на несколько градусов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入射角大致等于反射角；库边的摩擦和任何旋转都会使其偏转几度。"
          }
        }
      }
    },
