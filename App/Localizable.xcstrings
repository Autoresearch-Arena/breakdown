          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的击球"
          }
        }
      }
    },
    "Your ball took %lld rails.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمست كرتك %lld حواف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kugel lief über %lld Banden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu bola tocó %lld bandas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bille a touché %lld bandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua palla ha toccato %lld sponde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "君の球はクッション%lld つを経由。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네 공이 쿠션 %lld개를 거쳤어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua bola tocou %lld tabelas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua bola tocou %lld tabelas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой шар коснулся бортов: %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的球碰了 %lld 库。"
          }
        }
      }
    },
    "Your ball took 1 rail.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
