          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A abertura"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A abertura"
          }
        },
        "ru": {
