            "value": "Rebote heroico a la 1"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bricole héroïque sur la 1"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimbalzo eroico sulla 1"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1番へのヒーローキック"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1번을 노리는 영웅 킥"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela heroica na 1"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela heroica na 1"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Геройский удар через борт по 1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "英雄式解球打 1 号球"
          }
        }
      }
    },
    "Hide Lens": {
