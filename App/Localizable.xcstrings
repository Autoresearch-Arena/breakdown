          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핵심 아이디어"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ideia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ideia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идея"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原理"
          }
        }
      }
    },
    "The left stick turns the aim. The right trigger adds power and the left trigger takes it away. The right stick moves the tip on the white ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العصا اليسرى تدير التصويب. الزناد الأيمن يزيد القوة والأيسر ينقصها. العصا اليمنى تحرّك نقطة الضرب على الكرة البيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der linke Stick dreht die Zielrichtung. Der rechte Trigger gibt Kraft dazu, der linke nimmt sie weg. Der rechte Stick bewegt die Spitze auf der weißen Kugel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El stick izquierdo gira la puntería. El gatillo derecho añade potencia y el izquierdo la quita. El stick derecho mueve la punta sobre la bola blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stick gauche tourne la visée. La gâchette droite ajoute de la puissance et la gauche en retire. Le stick droit déplace le procédé sur la bille blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stick sinistro ruota la mira. Il grilletto destro aggiunge potenza e il sinistro la toglie. Lo stick destro sposta la punta sulla palla bianca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左スティックで狙いを回します。右トリガーで強さを上げ、左トリガーで下げます。右スティックで手球を突く位置を動かします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 스틱으로 조준을 돌립니다. 오른쪽 트리거는 세기를 올리고 왼쪽 트리거는 내립니다. 오른쪽 스틱으로 큐볼의 타점을 옮깁니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O manípulo esquerdo roda a mira. O gatilho direito acrescenta força e o esquerdo tira. O manípulo direito move a ponta na bola branca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O analógico esquerdo gira a mira. O gatilho direito aumenta a força e o esquerdo diminui. O analógico direito move a ponta na bola branca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Левый стик поворачивает прицел. Правый курок добавляет силу, левый убавляет. Правый стик двигает точку удара на белом шаре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左摇杆转动瞄准。右扳机增加力度，左扳机减小力度。右摇杆移动白球上的击球点。"
          }
        }
      }
    },
    "The marked angles are %lld to %lld degrees up.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزوايا المحددة من %lld إلى %lld درجة للأعلى."
