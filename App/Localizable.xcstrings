    "Take your own shot (Command-Y)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العب ضربتك (⌘Y)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigenen Stoß ausführen (Befehl-Y)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz tu propio tiro (Comando-Y)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue ton propre coup (Commande-Y)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira il tuo colpo (Comando-Y)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分でショットを打つ（⌘Y）"
          }
        },
        "ko": {
