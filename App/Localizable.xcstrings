    "Played straight, it would have hit a different ball first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لو ضربت باستقامة، لأصابت كرة أخرى أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit geradem Stoß hätte die Weiße zuerst eine andere Kugel getroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un golpe recto, habría tocado primero otra bola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joué droit, il aurait touché une autre bille en premier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un colpo dritto, avrebbe toccato prima un'altra bilia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まっすぐ撞いていたら、最初に別の球に当たっていた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧게 쳤다면 다른 공을 먼저 맞혔을 거예요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada direita, teria tocado primeiro noutra bola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada reta, teria batido primeiro em outra bola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При прямом ударе биток сначала попал бы в другой шар."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果出杆够直，会先碰到另一颗球。"
          }
        }
      }
    },
    "Played straight, that ball would have stayed up.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لو ضربت باستقامة، لما دخلت تلك الكرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit geradem Stoß wäre diese Kugel nicht gefallen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un golpe recto, esa bola no habría entrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joué droit, cette bille ne serait pas rentrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un colpo dritto, quella bilia non sarebbe andata in buca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まっすぐ撞いていたら、その球は入らなかった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧게 쳤다면 그 공은 들어가지 않았을 거예요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada direita, essa bola não teria entrado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada reta, essa bola não teria entrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При прямом ударе этот шар не упал бы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果出杆够直，那颗球本来不会进。"
          }
        }
      }
    },
    "Played straight, the cue ball would have gone in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لو ضربت باستقامة، لسقطت الكرة البيضاء في الجيب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit geradem Stoß wäre die weiße Kugel in eine Tasche gefallen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un golpe recto, la bola blanca habría entrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joué droit, la bille blanche serait tombée dans une poche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un colpo dritto, la bilia battente sarebbe finita in buca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まっすぐ撞いていたら、手球はポケットに落ちていた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧게 쳤다면 수구가 포켓에 빠졌을 거예요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada direita, a bola branca teria caído num buraco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada reta, a bola branca teria caído na caçapa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При прямом ударе биток упал бы в лузу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果出杆够直，母球本来会落袋。"
          }
        }
      }
    },
    "Played straight, the cue ball would have stayed on the table.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لو ضربت باستقامة، لبقيت الكرة البيضاء على الطاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit geradem Stoß wäre die weiße Kugel auf dem Tisch geblieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un golpe recto, la bola blanca se habría quedado en la mesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joué droit, la bille blanche serait restée sur la table."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un colpo dritto, la bilia battente sarebbe rimasta sul tavolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まっすぐ撞いていたら、手球は台に残っていた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧게 쳤다면 수구가 테이블에 남았을 거예요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada direita, a bola branca teria ficado na mesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada reta, a bola branca teria ficado na mesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При прямом ударе биток остался бы на столе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果出杆够直，母球本来会留在台上。"
          }
        }
      }
    },
    "Played straight, the pot would have dropped.": {
      "localizations": {
        "ar": {
