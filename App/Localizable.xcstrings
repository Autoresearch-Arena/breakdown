    "Strike above centre and the cue ball rolls on after the ball it pots.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضرب فوق المركز فتواصل الكرة البيضاء التدحرج بعد الكرة التي تدخلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Triff über der Mitte, und die weiße Kugel rollt der versenkten Kugel hinterher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpea por encima del centro y la blanca sigue rodando tras la bola que mete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frappe au-dessus du centre et la blanche continue de rouler après la bille qu'elle empoche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colpisci sopra il centro e la bianca continua a rotolare dopo la palla che imbuca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中心より上を撞くと、手球は的球を沈めたあとも転がり続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중심보다 위를 치면 큐볼이 넣은 공을 따라 계속 굴러가요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bate acima do centro e a branca continua a rolar atrás da bola que mete."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bata acima do centro e a branca segue rolando atrás da bola que encaçapa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бей выше центра, и белый шар покатится дальше вслед за забитым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击打中心上方，白球会在打进目标球后继续向前滚。"
          }
        }
      }
    },
    "Strike above centre for follow.": {
      "localizations": {
