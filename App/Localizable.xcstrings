        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 쉬워 보이는 공을 골랐고, 수구가 어디 멈출지는 생각하지 않았어."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolheu a bola que parecia mais fácil, sem pensar onde a branca ia parar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolheu a bola que parecia mais fácil, sem planejar onde a branca ia parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
