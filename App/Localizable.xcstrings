    "The cue ball came back. Strike a little higher, nearer the middle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رجعت الكرة البيضاء. اضرب أعلى قليلاً، أقرب إلى المركز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die weiße Kugel ist zurückgekommen. Triff etwas höher, näher zur Mitte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bola blanca volvió. Golpea un poco más arriba, más cerca del centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bille blanche est revenue. Frappe un peu plus haut, plus près du centre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La palla bianca è tornata indietro. Colpisci un po' più in alto, più vicino al centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手球が戻ってきました。もう少し上、中心寄りを打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐볼이 되돌아왔어요. 조금 더 위, 가운데에 가깝게 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola branca voltou. Bata um pouco mais acima, mais perto do centro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola branca voltou. Bata um pouco mais acima, mais perto do centro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Белый шар пошёл назад. Бейте чуть выше, ближе к центру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白球倒回来了。击打位置再偏上一点，靠近中心。"
          }
        }
      }
    },
    "The cue ball finished about %lld centimetres from where it stopped last time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت الكرة البيضاء على بعد نحو %lld سنتيمتراً من المكان الذي توقفت فيه في المرة الماضية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die weiße Kugel blieb etwa %lld Zentimeter von der Stelle entfernt liegen, an der sie beim letzten Mal zum Stehen kam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bola blanca terminó a unos %lld centímetros de donde se detuvo la vez anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bille blanche s'est arrêtée à environ %lld centimètres de l'endroit où elle s'était arrêtée la dernière fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La palla bianca si è fermata a circa %lld centimetri da dove si era fermata l'ultima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手球は前回止まった位置から約%lldセンチの所で止まりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐볼은 지난번 멈춘 곳에서 약 %lld센티미터 떨어진 곳에 멈췄습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola branca parou a cerca de %lld centímetros de onde parou da última vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola branca parou a cerca de %lld centímetros de onde parou da última vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Белый шар остановился примерно в %lld сантиметрах от прошлого места остановки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白球这次停的位置，离上次停的地方大约%lld厘米。"
          }
        }
      }
    },
    "The cue ball has to reach the %lld first. Aim %@ %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تصل الكرة البيضاء إلى الكرة رقم %lld أولاً. صوّب %@ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die weiße Kugel muss zuerst die %lld-Kugel erreichen. Ziele %@ %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bola blanca tiene que tocar primero la %lld. Apunta %@ hacia la %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bille blanche doit toucher d'abord la %lld. Vise %@ à %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La palla bianca deve prima raggiungere la palla %lld. Mira %@ a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手球は先に%lld番へ届く必要があります。%@%@を狙いましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐볼이 먼저 %lld번에 닿아야 해요. %@ %@ 조준하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola branca tem de atingir a %lld primeiro. Mire %@ %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola branca tem que atingir a %lld primeiro. Mire %@ %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Белый шар должен сначала коснуться %lld-го шара. Целься %@ %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白球必须先碰到%lld号球。瞄准时%@%@一些。"
          }
        }
      }
    },
    "The cue ball rolled on after the hit. Strike a little lower.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدحرجت الكرة البيضاء بعد الضربة. اضرب أسفل قليلاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die weiße Kugel ist nach dem Stoß weitergerollt. Triff etwas tiefer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bola blanca siguió rodando tras el golpe. Golpea un poco más abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bille blanche a continué à rouler après le coup. Frappe un peu plus bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La palla bianca è andata avanti dopo il colpo. Colpisci un po' più in basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手球が打った後も転がり続けました。もう少し下を打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐볼이 친 뒤에도 계속 굴러갔어요. 조금 더 아래를 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola branca continuou a rolar depois da tacada. Bata um pouco mais abaixo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola branca continuou rolando depois da tacada. Bata um pouco mais abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После удара белый шар покатился дальше. Бейте чуть ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击球后白球继续滚动了。击打位置再偏下一点。"
          }
        }
      }
    },
    "The cue ball went in too. %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دخلت الكرة البيضاء الجيب أيضاً. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch die weiße Kugel ist eingefallen. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bola blanca también entró. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bille blanche est tombée aussi. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche la palla bianca è finita in buca. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手球もポケットに入りました。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐볼도 포켓에 들어갔어요. %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola branca também entrou na caçapa. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola branca também entrou na caçapa. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Белый шар тоже упал в лузу. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白球也进袋了。%@"
          }
        }
      }
    },
    "The cue hands over its speed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العصا تنقل سرعتها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Queue übergibt ihre Geschwindigkeit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El taco cede su velocidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La queue transmet sa vitesse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stecca trasferisce la sua velocità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューが球に速さを渡す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐가 공에 속도를 넘겨줌"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tacada transfere a sua velocidade"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tacada passa a sua velocidade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кий передаёт свою скорость"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "球杆把速度传给球"
          }
        }
      }
    },
    "The cue sends the ball off at %@ metres per second. Hitting below centre adds backspin, which the ball carries with it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العصا تدفع الكرة بسرعة %@ متر في الثانية. الضرب أسفل المركز يضيف لفاً خلفياً تحمله الكرة معها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Queue schickt die Kugel mit %@ Meter pro Sekunde los. Ein Treffer unter der Mitte erzeugt Rückwärtsdrall, den die Kugel mitnimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El taco envía la bola a %@ metros por segundo. Golpear por debajo del centro añade retroceso, que la bola lleva consigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La queue envoie la bille à %@ mètres par seconde. Frapper sous le centre ajoute un effet rétro, que la bille emporte avec elle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stecca manda la palla a %@ metri al secondo. Colpire sotto il centro dà effetto all'indietro, che la palla porta con sé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューは球を%@ m/sで送り出します。中心より下を打つと下回転が加わり、球はそれを持ったまま進みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐는 공을 %@ m/s로 내보냅니다. 중심보다 아래를 치면 백회전이 생기고, 공은 그 회전을 가지고 나아갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O taco envia a bola a %@ metros por segundo. Bater abaixo do centro acrescenta efeito de recuo, que a bola leva consigo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O taco envia a bola a %@ metros por segundo. Bater abaixo do centro acrescenta efeito de recuo, que a bola leva consigo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кий посылает шар со скоростью %@ метров в секунду. Удар ниже центра добавляет оттяжку, которая сохраняется у шара."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "球杆以每秒%@米的速度把球打出。击打中心偏下会加上低杆旋转，球会带着它前进。"
          }
        }
      }
    },
    "The cue sends the ball off at %@ metres per second. Its momentum is mass times speed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العصا تدفع الكرة بسرعة %@ متر في الثانية. زخمها هو الكتلة مضروبة في السرعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Queue schickt die Kugel mit %@ Meter pro Sekunde los. Ihr Impuls ist Masse mal Geschwindigkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El taco envía la bola a %@ metros por segundo. Su momento es la masa por la velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La queue envoie la bille à %@ mètres par seconde. Sa quantité de mouvement est égale à la masse multipliée par la vitesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stecca manda la palla a %@ metri al secondo. La sua quantità di moto è massa per velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューは球を%@ m/sで送り出します。運動量は質量×速さです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐는 공을 %@ m/s로 내보냅니다. 운동량은 질량 × 속도입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O taco envia a bola a %@ metros por segundo. O momento é massa vezes velocidade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O taco envia a bola a %@ metros por segundo. O momento é massa vezes velocidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кий посылает шар со скоростью %@ метров в секунду. Импульс равен массе, умноженной на скорость."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "球杆以每秒%@米的速度把球打出。它的动量等于质量乘以速度。"
          }
        }
      }
    },
    "The cushion pushes back": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوسادة تدفع للخلف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bande drückt zurück"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La banda empuja de vuelta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bande repousse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sponda respinge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クッションが押し返す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쿠션이 되밀어냄"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tabela empurra de volta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tabela empurra de volta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Борт отталкивает шар"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "库边把球弹回来"
          }
        }
      }
    },
    "The guide shows the first ball you will hit and where both balls head next. Turn it off to judge the angle yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الدليل أول كرة ستضربها وإلى أين تتجه الكرتان بعد ذلك. أوقفه لتحكم على الزاوية بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zielhilfe zeigt die erste Kugel, die du treffen wirst, und wohin beide Kugeln danach laufen. Schalte sie aus, um den Winkel selbst einzuschätzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La guía muestra la primera bola que tocarás y hacia dónde van ambas después. Desactívala para juzgar el ángulo tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le guide montre la première bille que tu toucheras et où vont ensuite les deux billes. Désactive-le pour juger l'angle toi-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La guida mostra la prima palla che colpirai e dove vanno entrambe dopo. Spegnila per valutare l'angolo da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイドは、最初に当たる球と、その後両方の球がどこへ向かうかを示します。オフにすると、角度は自分で判断できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드는 처음 맞힐 공과 그 뒤 두 공이 어디로 가는지 보여 줍니다. 끄면 각도는 직접 판단할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A guia mostra a primeira bola que você vai atingir e para onde as duas bolas seguem depois. Desligue-a para avaliar o ângulo por si."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A guia mostra a primeira bola que você vai atingir e para onde as duas bolas seguem depois. Desligue para avaliar o ângulo por conta própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направляющая показывает первый шар, в который вы попадёте, и куда дальше пойдут оба шара. Выключите её, чтобы самостоятельно оценить угол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助线显示你将击中的第一个球，以及两球接下来的走向。关闭它，你就可以自己判断角度。"
          }
        }
      }
    },
    "The side spin bent it off line. Strike through the middle of the cue ball.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللف الجانبي حرفها عن خطها. اضرب عبر مركز الكرة البيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Seitendrall hat sie von der Linie abgelenkt. Triff genau die Mitte der weißen Kugel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El efecto lateral la desvió de la línea. Golpea por el centro de la bola blanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'effet latéral l'a fait dévier de sa ligne. Frappe au milieu de la bille blanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'effetto laterale l'ha deviata dalla linea. Colpisci al centro della palla bianca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横回転で進路がずれました。手球の中心を打ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆회전 때문에 방향이 빗나갔어요. 큐볼의 정중앙을 치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O efeito lateral desviou-a da linha. Bata pelo centro da bola branca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O efeito lateral desviou a bola da linha. Bata pelo centro da bola branca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Боковое вращение увело шар с линии. Бейте точно по центру белого шара."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧旋使它偏离了路线。击打白球正中心。"
          }
        }
      }
    },
    "The speed the cue ball comes back with is two sevenths of its radius times its spin rate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سرعة رجوع الكرة البيضاء تساوي اثنين من سبعة من نصف قطرها مضروبةً في معدل لفها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dieser Geschwindigkeit kommt die weiße Kugel zurück: zwei Siebtel ihres Radius mal ihre Drehgeschwindigkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La velocidad con la que vuelve la bola blanca es dos séptimos de su radio por su velocidad de giro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse de retour de la bille blanche vaut deux septièmes de son rayon multiplié par sa vitesse de rotation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La velocità con cui torna la palla bianca è due settimi del suo raggio per la sua velocità di rotazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手球が戻ってくる速さは、半径に回転の速さを掛けた値の七分の二です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큐볼이 되돌아오는 속도는 반지름에 회전 속도를 곱한 값의 7분의 2입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A velocidade com que a bola branca volta é dois sétimos do raio vezes a sua taxa de rotação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A velocidade com que a bola branca volta é dois sétimos do raio vezes a taxa de rotação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорость, с которой белый шар возвращается, равна двум седьмым его радиуса, умноженным на скорость вращения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白球返回的速度，是它的半径乘以旋转速率的七分之二。"
          }
        }
      }
    },
    "The whole length of the table, on backspin alone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طول الطاولة كاملاً، بالاعتماد على اللف الخلفي وحده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ganze Tischlänge, nur mit Rückdrall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la mesa, solo con retroceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute la longueur de la table, sur le rétro seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta la lunghezza del tavolo, solo con l'effetto indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "逆回転だけで、台の端から端まで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백스핀만으로 테이블 전체 길이를."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o comprimento da mesa, só com o efeito de recuo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comprimento todo da mesa, só com o efeito de recuo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через весь стол, только за счёт обратного вращения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整张球桌的距离，全靠低杆旋转。"
          }
        }
      }
    },
    "This time %@ went in instead of %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المرة دخلت %@ بدلاً من %@."
