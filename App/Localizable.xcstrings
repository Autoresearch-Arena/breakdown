    "Medium to firm: enough for three rails and the length of the table.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوسطة إلى قوية: تكفي لثلاث حواف وطول الطاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittel bis kräftig: genug für drei Banden und die Tischlänge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De media a firme: lo justo para tres bandas y el largo de la mesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyen à appuyé : de quoi faire trois bandes et la longueur de la table."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da media a decisa: quanto basta per tre sponde e la lunghezza del tavolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中〜強め：3クッションと台の長さに足りるだけ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중간~단단하게: 쿠션 세 개와 테이블 길이를 갈 만큼."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De média a firme: o bastante para três tabelas e o comprimento da mesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De média a firme: o bastante para três tabelas e o comprimento da mesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От средней до уверенной: хватит на три борта и длину стола."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中等到有力：够走三库加一整个台长。"
          }
        }
      }
    },
    "Medium to firm: the curve has the whole table to build.": {
