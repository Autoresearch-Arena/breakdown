    "Back on its own spot: %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود إلى نقطتها: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück auf den eigenen Punkt: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a su propio punto: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour sur son propre point : %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna sul suo punto: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のスポットに戻す：%@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제자리 점으로 돌아갑니다: %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta ao seu próprio ponto: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta para o seu próprio ponto: %@."
          }
