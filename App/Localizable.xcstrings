          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧게 쳤다면 공이 들어갔을 거예요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tacada direita, a bola teria entrado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
