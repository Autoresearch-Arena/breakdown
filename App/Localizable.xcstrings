            "value": "Реальный размер"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际大小"
          }
        }
      }
    },
    "Add %@ percent to reach the marked band.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زد %@ بالمئة لتصل إلى النطاق المحدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib %@ Prozent dazu, um den markierten Bereich zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube %@ por ciento para llegar a la franja marcada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute %@ pour cent pour atteindre la bande marquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il %@ per cento per arrivare alla fascia segnata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マークした帯まで、あと%@パーセント上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 구간까지 %@퍼센트 올려요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta %@ por cento para chegar à faixa marcada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumente %@ por cento para chegar à faixa marcada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь %@ %%, чтобы попасть в отмеченную полосу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再加百分之%@即可进入标记区。"
          }
        }
      }
    },
    "After the break nobody owns a group. The first ball you call and sink on a fair shot makes its group yours.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الكسرة لا يملك أحد مجموعة. أول كرة تسمّيها وتُدخلها بضربة صحيحة تجعل مجموعتها لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Anstoß gehört niemandem eine Gruppe. Die erste Kugel, die du ansagst und mit einem fairen Stoß versenkst, macht ihre Gruppe zu deiner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras el saque nadie tiene grupo. La primera bola que cantes y metas en un tiro válido hace tuyo su grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la casse, personne n'a de groupe. La première bille que tu annonces et empoches sur un coup valable te donne son groupe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo la spaccata nessuno ha un gruppo. La prima bilia che chiami e imbuchi con un colpo valido ti assegna il suo gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレイクの後は、どちらのグループも決まっていません。正しいショットで最初にコールして沈めた球のグループが自分のものになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브레이크 후에는 아무도 그룹이 없습니다. 정당한 샷으로 처음 콜하고 넣은 공의 그룹이 내 것이 됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois da abertura ninguém tem grupo. A primeira bola que anunciar e meter numa tacada válida dá-lhe o grupo dela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois da abertura ninguém tem grupo. A primeira bola que você cantar e encaçapar numa tacada válida torna o grupo dela seu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После разбоя ни у кого нет группы. Первый шар, заказанный и забитый тобой честным ударом, делает его группу твоей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开球后谁都没有球组。你在合法击球中第一个报出并打进的球，它所在的球组就归你。"
          }
        }
      }
    },
