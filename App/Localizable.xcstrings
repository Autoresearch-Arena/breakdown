          }
        }
      }
    },
    "A firm hit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضربة قوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kräftiger Stoß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un golpe firme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coup appuyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un colpo deciso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しっかりしたショット。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단단한 타구."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
