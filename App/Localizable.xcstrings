    "Stopped dead from further back. You changed the tip height instead of copying the lesson.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت تمامًا من مسافة أبعد. غيّرت ارتفاع الضربة بدل نسخ الدرس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppt aus größerer Entfernung. Du hast die Treffhöhe geändert, statt die Lektion zu kopieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parada en seco desde más atrás. Cambiaste la altura del golpe en vez de copiar la lección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêt net de plus loin. Tu as changé la hauteur de frappe au lieu de copier la leçon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermata di colpo da più lontano. Hai cambiato l'altezza del colpo invece di copiare la lezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もっと後ろからでもピタッと止めた。レッスンをまねるのではなく、撞く高さを変えたね。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 뒤에서도 딱 멈췄어요. 레슨을 따라 하지 않고 치는 높이를 바꿨어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parou de vez mais de trás. Mudaste a altura da tacada em vez de copiar a lição."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parou na hora mais de trás. Você mudou a altura da tacada em vez de copiar a lição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановил и с большего расстояния. Ты изменил высоту удара, а не скопировал урок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从更远处也停住了。你改变了击球高度，而不是照搬课程。"
          }
        }
      }
    },
    "Stopped dead. All of its speed went into the 3.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت تماماً. ذهبت كل سرعتها إلى الكرة 3."
          }
