          }
        }
      }
    },
    "It keeps %@ percent of its side spin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ بـ%@ في المئة من دورانها الجانبي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie behält %@ Prozent ihres Seiteneffets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva el %@ por ciento de su efecto lateral."
          }
        },
        "fr": {
