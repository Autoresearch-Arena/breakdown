    "Jump cue picked: short and light, for a steep stab": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخترنا عصا القفز: قصيرة وخفيفة، لطعنة حادة من الأعلى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
