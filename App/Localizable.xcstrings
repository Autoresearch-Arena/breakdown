          "stringUnit": {
            "state": "translated",
            "value": "11番がないつもりで、5番をサイドへカットする狙いを。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "11번이 없다고 생각하고 5번을 사이드로 깎는 겨냥을 하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponta o corte da 5 para a lateral como se a 11 não estivesse lá."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire o corte da 5 na lateral como se a 11 não estivesse lá."
          }
