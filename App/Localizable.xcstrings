        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha scelto la bilia che sembrava più facile, senza pensare a dove si sarebbe fermata la bianca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一番簡単そうな球を選び、手球の止まる位置は考えなかった。"
