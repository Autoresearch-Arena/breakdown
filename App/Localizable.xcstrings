        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ficou presa contra a borracha, quicando no lugar em quiques pequenos demais para ver. Ela é colocada em repouso, e os %2$@ que esses quiques teriam virado calor são retirados de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ зажат у резины и подпрыгивает на месте так мелко, что этого не видно. Его останавливают, а энергию, которую эти отскоки превратили бы в тепло (%2$@), убирают сразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 卡在橡胶边上，原地做着小到看不见的反弹。它被直接停下，那些反弹本会变成热量的 %2$@ 能量被一次性扣除。"
          }
        }
      }
    },
